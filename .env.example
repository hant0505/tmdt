# TeknTek Currency Widget - Environment Configuration
# This file contains all necessary configuration for the Currency Exchange widget

# ============================================================================
# VIETCOMBANK CURRENCY API
# ============================================================================
# Source: https://portal.vietcombank.com.vn/Usercontrols/TVPortal.TyGia/pXML.aspx?b=68
# No API key required - Vietcombank provides public XML feed
# The module automatically fetches exchange rates hourly (cached for 1 hour)
VIETCOMBANK_CURRENCY_API_URL="https://portal.vietcombank.com.vn/Usercontrols/TVPortal.TyGia/pXML.aspx?b=68"
VIETCOMBANK_CURRENCY_CACHE_LIFETIME=3600

# ============================================================================
# OPENWEATHER API
# ============================================================================
# Source: https://openweathermap.org/api
# Requires an API key from OpenWeather.
# Put this value in app/etc/env.php for Magento runtime usage:
# 'weather' => [
#     'api_key' => 'your_openweather_api_key',
#     'default_city' => 'Hanoi,VN'
# ]
OPENWEATHER_API_KEY=""
OPENWEATHER_DEFAULT_CITY="Hanoi,VN"

# ============================================================================
# FLAGCDN COUNTRY FLAGS
# ============================================================================
# Source: https://flagcdn.com
# No API key required. The UI generates SVG URLs from ISO country codes:
# https://flagcdn.com/{country_code}.svg
FLAGCDN_BASE_URL="https://flagcdn.com"

# ============================================================================
# MAGENTO CACHE CONFIGURATION
# ============================================================================
# Cache settings for Currency module
CURRENCY_CACHE_TYPE_ENABLED=1
CURRENCY_FULL_PAGE_CACHE_ENABLED=1

# ============================================================================
# PERFORMANCE SETTINGS
# ============================================================================
# Currency update frequency (in seconds)
# Default: 3600 (1 hour)
# Recommended range: 1800-86400 (30 minutes to 24 hours)
CURRENCY_UPDATE_FREQUENCY=3600

# HTTP request timeout for API calls (in seconds)
API_REQUEST_TIMEOUT=10

# Enable/disable currency widget logging
CURRENCY_WIDGET_LOGGING=0

# ============================================================================
# WIDGET DISPLAY SETTINGS
# ============================================================================
# Show currency widget on homepage
CURRENCY_WIDGET_DISPLAY_HOMEPAGE=1

# Show currency widget on category pages
CURRENCY_WIDGET_DISPLAY_CATEGORY=1

# Show currency widget on product pages
CURRENCY_WIDGET_DISPLAY_PRODUCT=0

# Maximum number of currencies to display (0 = all)
CURRENCY_WIDGET_MAX_CURRENCIES=0

# ============================================================================
# NOTIFICATION SETTINGS
# ============================================================================
# Send email notification if API becomes unavailable
CURRENCY_NOTIFICATION_EMAIL="admin@example.com"
CURRENCY_NOTIFY_API_FAILURE=1

# Log API errors
CURRENCY_LOG_API_ERRORS=1

# ============================================================================
# SUPPORTED CURRENCIES WITH COUNTRY CODES
# ============================================================================
# The following currencies are currently supported with country flags:
#
# AUD - Australian Dollar (Australia)
# CAD - Canadian Dollar (Canada)
# CHF - Swiss Franc (Switzerland)
# CNY - Yuan Renminbi (China)
# DKK - Danish Krone (Denmark)
# EUR - Euro (Eurozone)
# GBP - Pound Sterling (United Kingdom)
# HKD - Hong Kong Dollar (Hong Kong)
# INR - Indian Rupee (India)
# JPY - Yen (Japan)
# KRW - Korean Won (South Korea)
# KWD - Kuwaiti Dinar (Kuwait)
# MYR - Malaysian Ringgit (Malaysia)
# NOK - Norwegian Krone (Norway)
# RUB - Russian Ruble (Russia)
# SAR - Saudi Rial (Saudi Arabia)
# SEK - Swedish Krona (Sweden)
# SGD - Singapore Dollar (Singapore)
# THB - Thai Baht (Thailand)
# TWD - Taiwan Dollar (Taiwan)
# USD - US Dollar (United States)
# AED - UAE Dirham (UAE)
# BRL - Brazilian Real (Brazil)
# IDR - Indonesian Rupiah (Indonesia)
# PHP - Philippine Peso (Philippines)
#
# Note: Additional currencies can be added by mapping in Helper/Data.php

# ============================================================================
# SETUP INSTRUCTIONS
# ============================================================================
#
# 1. NO INSTALLATION REQUIRED FOR VIETCOMBANK API
#    - The Vietcombank XML API is completely free and requires no registration
#    - No authentication tokens or API keys needed
#    - The URL is directly accessible via HTTP
#    
# 2. FLAGCDN FLAGS
#    - Free CDN: https://flagcdn.com
#    - No registration or API key required
#    - Flags are loaded by the browser as SVG images
#
# 3. INSTALLATION STEPS:
#    a) Copy this file to: /home/lyan/Project/tmdt/.env (remove .example)
#    b) Flush Magento cache: bin/magento cache:clean
#    c) Check currency page: http://localhost/currency
#
# 4. TROUBLESHOOTING:
#    - If flags are not displaying: Check FlagCDN image URL availability
#    - If rates not updating: Check Vietcombank URL is accessible
#    - Check file permissions for cache directories: var/cache/, var/page_cache/
#    - Clear browser cache if display issues occur
#
# ============================================================================

# ============================================================================
# MAGENTO SYSTEM CONFIGURATION
# ============================================================================
# System > Configuration > General > General > Currency Setup
CURRENCY_ALLOWED_CURRENCIES="USD,EUR,VND"
CURRENCY_BASE="VND"

# ============================================================================
# DEBUG MODE (Development only)
# ============================================================================
# Enable detailed logging for Currency module
DEBUG_CURRENCY_WIDGET=0
DEBUG_API_CALLS=0

# ============================================================================
# ADDITIONAL NOTES
# ============================================================================
#
# File Structure:
# app/code/Vendor/Currency/              - Backend module
# ├── Block/Rates.php                     - Block class
# ├── Helper/Data.php                    - Data fetching & country mapping
# ├── Controller/Index/Index.php         - Controller for /currency page
# ├── etc/
# │   ├── module.xml                     - Module definition
# │   └── frontend/routes.xml            - URL routing
# └── view/frontend/
#     ├── layout/
#     │   └── currency_index_index.xml  - Page layout
#     └── templates/
#         └── rates.phtml                - Default template
#
# app/design/frontend/TeknTek/OrangeTheme/Vendor_Currency/
# ├── layout/
# │   └── vendor_currency_index_index.xml - Theme-specific layout
# ├── templates/
# │   └── currency-widget.phtml           - OrangeTheme template
# └── web/css/
#     └── currency-widget.css             - Theme styling
#
# API Response Format:
# The backend returns data in the following format:
# {
#   "datetime": "17/12/2024 10:38:01 PM",
#   "source": "Vietcombank",
#   "rates": [
#     {
#       "code": "USD",
#       "name": "US Dollar",
#       "country_name": "United States",
#       "country_code": "US",
#       "flag": "🇺🇸",
#       "buy": "24520",
#       "transfer": "24490",
#       "sell": "24570"
#     },
#     ...
#   ]
# }
#
# ============================================================================

<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <payment>
            <zalopay>
                <active>0</active>
                <model>Payment\ZaloPay\Model\Payment</model>
                <order_status>pending_payment</order_status>
                <title>ZaloPay Sandbox</title>
                <create_order_endpoint>https://sb-openapi.zalopay.vn/v2/create</create_order_endpoint>
                <debug>0</debug>
                <allowspecific>0</allowspecific>
                <group>online</group>
                <sort_order>90</sort_order>
            </zalopay>
        </payment>
    </default>
</config>

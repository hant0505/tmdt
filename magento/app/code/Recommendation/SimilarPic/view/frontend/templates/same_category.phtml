<script>
(function () {
    var widget = document.querySelector('.similar-pick-widget');
    if (!widget) {
        return;
    }

    var track = widget.querySelector('.similar-pick-track');
    var prevBtn = widget.querySelector('.similar-pick-arrow-prev');
    var nextBtn = widget.querySelector('.similar-pick-arrow-next');

    if (!track || !prevBtn || !nextBtn) {
        return;
    }

    function updateArrows() {
        var canScrollLeft = track.scrollLeft > 0;
        var canScrollRight = (track.scrollLeft + track.clientWidth) < track.scrollWidth - 8;

        prevBtn.disabled = !canScrollLeft;
        nextBtn.disabled = !canScrollRight;
    }

    function scrollCarousel(direction) {
        var scrollAmount = Math.max(track.clientWidth - 24, 220);
        track.scrollBy({
            left: direction === 'next' ? scrollAmount : -scrollAmount,
            behavior: 'smooth'
        });
        window.setTimeout(updateArrows, 320);
    }

    prevBtn.addEventListener('click', function () {
        scrollCarousel('prev');
    });

    nextBtn.addEventListener('click', function () {
        scrollCarousel('next');
    });

    track.addEventListener('scroll', updateArrows);
    window.addEventListener('resize', updateArrows);
    window.setTimeout(updateArrows, 100);
})();
</script>

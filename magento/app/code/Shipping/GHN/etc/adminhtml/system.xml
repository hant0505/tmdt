<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="carriers" translate="label" type="text" sortOrder="320" showInDefault="1" showInWebsite="1" showInStore="1">
            <group id="ghn" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Giao Hàng Nhanh (GHN)</label>
                <field id="active" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="title" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Title</label>
                </field>
                <field id="api_token" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>API Token</label>
                    <comment>Nhập Token thật từ GHN (Đã bỏ mã hóa để test)</comment>
                </field>
                <field id="shop_id" translate="label" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Shop ID</label>
                </field>
                <field id="from_district_id" translate="label" type="text" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>From District ID (Quận/Huyện gửi hàng)</label>
                    <comment>Lấy từ GHN để xác định khu vực gửi hàng. Mặc định: 3440 (Cầu Giấy, Hà Nội)</comment>
                </field>
                <field id="to_district_id" translate="label" type="text" sortOrder="51" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>To District ID (Quận/Huyện nhận hàng - mặc định)</label>
                    <comment>Mặc định cho khách: 3440 (Cầu Giấy, Hà Nội)</comment>
                </field>
            </group>
        </section>
    </system>
</config>
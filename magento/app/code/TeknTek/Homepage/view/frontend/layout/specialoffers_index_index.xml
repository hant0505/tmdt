<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd"
      layout="2columns-left">
    <body>
        <attribute name="class" value="catalog-category-view catalogsearch-result-index"/>
        <referenceBlock name="wishlist_sidebar" remove="true"/>
        <referenceContainer name="sidebar.main">
            <block class="TeknTek\Homepage\Block\SpecialOffers"
                   name="tekntek.specialoffers.sidebar"
                   template="TeknTek_Homepage::specialoffers/sidebar.phtml"
                   cacheable="false"/>
        </referenceContainer>
        <referenceContainer name="content">
            <block class="TeknTek\Homepage\Block\SpecialOffers"
                   name="tekntek.specialoffers"
                   template="TeknTek_Homepage::specialoffers/index.phtml"
                   cacheable="true"/>
        </referenceContainer>
    </body>
</page>

<?php /** @var \TeknTek\Homepage\Block\SpecialOffers $block */
$categories = $block->getOfferCategories();
$selectedKeys = $block->getSelectedCategoryKeys();
$sort = $block->getCurrentSort();
$limit = $block->getCurrentLimit();
$baseUrl = $block->getUrl('special-offers');

$buildUrl = static function (array $keys) use ($baseUrl, $sort, $limit): string {
    $params = [
        'sort' => $sort,
        'limit' => $limit,
        'p' => 1,
    ];
    if ($keys !== []) {
        $params['cat'] = implode(',', array_values($keys));
    }

    return $baseUrl . '?' . http_build_query($params);
};
?>
<style>
.special-offers-sidebar.block.filter {
    background:#fff;border:1px solid #e5e7eb;border-radius:16px;box-shadow:0 8px 24px rgba(15,23,42,.06);padding:14px;
}
.special-offers-sidebar .filter-title {margin:0 0 12px;font-size:20px;line-height:1.2;}
.special-offers-sidebar .filter-options-title {
    margin:0 0 8px;font-size:12px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:#334155;
}
.special-offers-sidebar .filter-options-content {display:grid;gap:4px;}
.special-offers-sidebar .item {
    display:flex;align-items:center;gap:10px;padding:8px 10px;border-radius:10px;text-decoration:none;color:#0f172a;
    transition:background-color .14s ease,color .14s ease;
    cursor: pointer;
}
.special-offers-sidebar .item:hover {background:#eff6ff;color:#1d4ed8;}
.special-offers-sidebar .item.is-active {background:#dbeafe;color:#1e40af;font-weight:700;}
.special-offers-sidebar input[type="checkbox"] {width:16px;height:16px;accent-color:#2563eb;}
.special-offers-sidebar .actions {margin-top:12px;display:flex;gap:8px;flex-wrap:wrap;}
.special-offers-sidebar .action.primary {
    display:inline-flex;align-items:center;justify-content:center;min-height:38px;padding:0 12px;border-radius:10px;text-decoration:none;font-weight:700;
}
@media (max-width: 767px) {
    .special-offers-sidebar .filter-content {display:none;}
    .special-offers-sidebar.is-open .filter-content {display:block;}
    .special-offers-sidebar .filter-title {display:flex;align-items:center;justify-content:space-between;cursor:pointer;}
}
</style>

<div class="block filter special-offers-sidebar" id="special-offers-sidebar">
    <div class="block-title filter-title" id="special-offers-sidebar-toggle">
        <strong><?= $block->escapeHtml(__('Categories')) ?></strong>
        <span aria-hidden="true">▾</span>
    </div>
    <div class="block-content filter-content">
        <form id="special-offers-filter-form" action="<?= $block->escapeUrl($baseUrl) ?>" method="get">
            <input type="hidden" name="sort" value="<?= $block->escapeHtmlAttr($sort) ?>">
            <input type="hidden" name="limit" value="<?= (int) $limit ?>">
            <input type="hidden" name="p" value="1">
            <div class="filter-options">
                <div class="filter-options-item active">
                    <div class="filter-options-title"><?= $block->escapeHtml(__('Filter by category')) ?></div>
                    <div class="filter-options-content">
                        <?php foreach ($categories as $category): ?>
                            <?php
                            $key = strtolower((string) $category['url_key']);
                            $active = in_array($key, $selectedKeys, true);
                            ?>
                            <label class="item<?= $active ? ' is-active' : '' ?>">
                                <input type="checkbox" name="cat[]" value="<?= $block->escapeHtmlAttr($key) ?>"<?= $active ? ' checked' : '' ?>>
                                <span><?= $block->escapeHtml($category['label']) ?></span>
                            </label>
                        <?php endforeach; ?>
                    </div>
                </div>
            </div>
            <div class="actions">
                <a class="action primary" href="<?= $block->escapeUrl($buildUrl([])) ?>"><span><?= $block->escapeHtml(__('Clear Filters')) ?></span></a>
            </div>
        </form>
    </div>
</div>

<script>
(function(){
    var sidebar = document.getElementById('special-offers-sidebar');
    var toggle = document.getElementById('special-offers-sidebar-toggle');
    var filterForm = document.getElementById('special-offers-filter-form');
    if (!sidebar || !toggle) return;
    toggle.addEventListener('click', function(){
        if (window.innerWidth <= 767) {
            sidebar.classList.toggle('is-open');
        }
    });
    if (filterForm) {
        filterForm.addEventListener('change', function(){
            filterForm.submit();
        });
    }
})();
</script>

<?php
/**
 * Default Business News Template (Module)
 * This is a simple template with basic styling.
 * 
 * For custom styling and layout, override in your theme:
 * app/design/frontend/YourVendor/YourTheme/Vendor_BusinessNews/
 * 
 * @var $block Magento\Framework\View\Element\Template
 */
?>
<div class="business-news-wrapper">
    <h2><?= $block->escapeHtml(__('Bản tin Kinh doanh')) ?></h2>
    
    <div class="business-news-items">
        <?php $newsList = $block->getNewsList(); ?>
        <?php if (!empty($newsList)): ?>
            <?php foreach ($newsList as $news): ?>
                <div class="business-news-item">
                    <div class="business-news-image">
                        <img src="<?= $block->escapeUrl($news['image']) ?>" alt="<?= $block->escapeHtml($news['title']) ?>" />
                    </div>
                    <div class="business-news-content">
                        <p class="business-news-date"><?= $block->escapeHtml($news['date']) ?></p>
                        <h3 class="business-news-title">
                            <a href="<?= $block->escapeUrl($news['link']) ?>" target="_blank">
                                <?= $block->escapeHtml($news['title']) ?>
                            </a>
                        </h3>
                        <p class="business-news-desc"><?= $block->escapeHtml($news['description']) ?></p>
                    </div>
                </div>
            <?php endforeach; ?>
        <?php else: ?>
            <p><?= $block->escapeHtml(__('Chưa có bài báo nào')) ?></p>
        <?php endif; ?>
    </div>
</div>

<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    
    <!-- Repository -->
    <preference for="Vendor\Rma\Api\RmaRepositoryInterface" type="Vendor\Rma\Model\RmaRepository"/>
    <preference for="Vendor\Rma\Api\Data\RmaInterface" type="Vendor\Rma\Model\Rma"/>
    
    <!-- Status Source Model -->
    <type name="Vendor\Rma\Model\Source\Status">
        <arguments>
            <argument name="options" xsi:type="array">
                <item name="pending" xsi:type="array">
                    <item name="value" xsi:type="string">pending</item>
                    <item name="label" xsi:type="string">Pending</item>
                </item>
                <!-- Có thể mở rộng sau -->
            </argument>
        </arguments>
    </type>
</config>
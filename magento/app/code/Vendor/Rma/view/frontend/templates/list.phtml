<?php
/** @var \Vendor\Rma\Block\RmaList $block */
$rmaCollection = $block->getRmaCollection();
?>
<div class="rma-list-container">
    <?php if ($rmaCollection && $rmaCollection->getSize()): ?>
        <div class="ttk-account-list ttk-rma-list">
            <?php foreach ($rmaCollection as $rma): ?>
                <?php
                $statusLabel = ucfirst((string) $rma->getStatus());
                $statusKey = strtolower(preg_replace('/[^a-z0-9]+/', '-', $statusLabel) ?: 'status');
                ?>
                <article class="ttk-account-row-card ttk-rma-card">
                    <div class="ttk-account-row-card__main">
                        <div>
                            <span class="ttk-account-row-card__eyebrow"><?= $escaper->escapeHtml(__('RMA #')) ?></span>
                            <strong class="ttk-account-row-card__title"><?= $escaper->escapeHtml($rma->getIncrementId()) ?></strong>
                        </div>
                        <span class="ttk-status-badge ttk-status-badge--<?= $escaper->escapeHtmlAttr($statusKey) ?>">
                            <?= $escaper->escapeHtml($statusLabel) ?>
                        </span>
                    </div>
                    <div class="ttk-account-row-card__meta">
                        <div>
                            <span><?= $escaper->escapeHtml(__('Order ID')) ?></span>
                            <strong><?= $escaper->escapeHtml($rma->getOrderId()) ?></strong>
                        </div>
                        <div>
                            <span><?= $escaper->escapeHtml(__('Date')) ?></span>
                            <strong><?= $escaper->escapeHtml(date('Y-m-d', strtotime($rma->getCreatedAt()))) ?></strong>
                        </div>
                    </div>
                </article>
            <?php endforeach; ?>
        </div>
    <?php else: ?>
        <div class="ttk-account-empty">
            <div class="ttk-account-empty__illustration" aria-hidden="true">↩</div>
            <h2><?= $escaper->escapeHtml(__('No return requests yet.')) ?></h2>
            <p><?= $escaper->escapeHtml(__('You have submitted no return requests.')) ?></p>
            <a class="ttk-account-empty__cta" href="<?= $block->escapeUrl($block->getUrl('')) ?>">
                <?= $escaper->escapeHtml(__('Back to Shopping')) ?>
            </a>
        </div>
    <?php endif; ?>
</div>

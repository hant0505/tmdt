<?php
/** @var \Magento\Framework\View\Element\Template $block */

$om = \Magento\Framework\App\ObjectManager::getInstance();
$registry = $om->get(\Magento\Framework\Registry::class);
$currentCategory = $registry->registry('current_category');
$queryText = trim((string) $block->getRequest()->getParam('q'));
$collection = null;

if ($currentCategory) {
    try {
        $collectionFactory = $om->get(\Magento\Catalog\Model\ResourceModel\Product\CollectionFactory::class);
        $storeManager = $om->get(\Magento\Store\Model\StoreManagerInterface::class);
        $productVisibility = $om->get(\Magento\Catalog\Model\Product\Visibility::class);

        $collection = $collectionFactory->create();
        $collection->setStoreId((int) $storeManager->getStore()->getId());
        $collection->addStoreFilter();
        $collection->addAttributeToSelect(['name', 'manufacturer', 'brand']);
        $collection->addCategoriesFilter(['in' => [(int) $currentCategory->getId()]]);
        $collection->setVisibility($productVisibility->getVisibleInCatalogIds());
    } catch (\Throwable $e) {
        $collection = null;
    }
}

if (!$collection) {
    $listBlock = $block->getLayout()->getBlock('category.products.list');
    if (!$listBlock) {
        $listBlock = $block->getLayout()->getBlock('search_result_list');
    }

    if ($listBlock) {
        $collection = $listBlock->getLoadedProductCollection();
    }
}

if (!$collection) {
    return;
}

$productCount = (int) $collection->getSize();
$brandCounts = [];
$knownBrands = [
    'Apple',
    'Samsung',
    'Xiaomi',
    'OPPO',
    'vivo',
    'Huawei',
    'Honor',
    'Realme',
    'OnePlus',
    'Google',
    'Nokia',
    'Sony',
    'Asus',
    'Acer',
    'Dell',
    'HP',
    'Lenovo',
    'MSI',
    'LG',
    'Philips',
    'Logitech',
    'JBL',
    'Amazfit',
    'Canon',
    'Nikon',
    'GoPro',
    'ViewSonic',
    'AOC'
];

$detectBrandFromName = static function (string $name) use ($knownBrands): string {
    foreach ($knownBrands as $knownBrand) {
        if (preg_match('/\b' . preg_quote($knownBrand, '/') . '\b/i', $name)) {
            return $knownBrand;
        }
    }

    return '';
};

foreach ($collection as $item) {
    $brand = '';

    $manufacturer = $item->getAttributeText('manufacturer');
    if (is_array($manufacturer)) {
        $manufacturer = implode(', ', $manufacturer);
    }
    $manufacturer = trim((string) $manufacturer);
    if ($manufacturer !== '') {
        $brand = $manufacturer;
    }

    if ($brand === '') {
        $brand = trim((string) $item->getData('brand'));
    }

    if ($brand === '') {
        $brand = $detectBrandFromName((string) $item->getName());
    }

    $brand = trim((string) preg_replace('/[^A-Za-z0-9\-\+\. ]+/', '', $brand));
    if ($brand === '') {
        continue;
    }

    if (!isset($brandCounts[$brand])) {
        $brandCounts[$brand] = 0;
    }
    $brandCounts[$brand] += 1;
}

arsort($brandCounts, SORT_NATURAL | SORT_FLAG_CASE);
$brands = array_slice($brandCounts, 0, 8, true);
$categoryTitle = $currentCategory ? (string) $currentCategory->getName() : '';
$queryTitle = $queryText !== '' ? ucwords(trim($queryText)) : 'Products';
$sectionTitle = $categoryTitle !== '' ? $categoryTitle : $queryTitle;

$brandPalette = [
    ['bg' => '#e0f2fe', 'fg' => '#075985', 'bd' => '#bae6fd'],
    ['bg' => '#ecfccb', 'fg' => '#3f6212', 'bd' => '#d9f99d'],
    ['bg' => '#fee2e2', 'fg' => '#991b1b', 'bd' => '#fecaca'],
    ['bg' => '#ede9fe', 'fg' => '#5b21b6', 'bd' => '#ddd6fe'],
    ['bg' => '#fef3c7', 'fg' => '#92400e', 'bd' => '#fde68a'],
    ['bg' => '#dcfce7', 'fg' => '#166534', 'bd' => '#bbf7d0'],
    ['bg' => '#fce7f3', 'fg' => '#9d174d', 'bd' => '#fbcfe8'],
    ['bg' => '#e0e7ff', 'fg' => '#1e3a8a', 'bd' => '#c7d2fe']
];

$brandColor = static function (string $brand) use ($brandPalette): array {
    $hash = abs((int) crc32(strtolower($brand)));
    $index = $hash % count($brandPalette);
    return $brandPalette[$index];
};

$storeCount = 1;
try {
    $storeManager = $om->get(\Magento\Store\Model\StoreManagerInterface::class);
    $storeCount = count($storeManager->getStores());
} catch (\Throwable $e) {
    $storeCount = 1;
}

$priceHelper = $om->get(\Magento\Framework\Pricing\Helper\Data::class);
$sampleProductUrl = $block->getUrl('catalog/product/view', ['id' => 1]);
$sampleProductImage = $block->getBaseUrl() . 'media/laptop.png';
$samplePrice = 1099;
$subjectText = strtolower(trim($categoryTitle !== '' ? $categoryTitle : $queryTitle));
$showSampleCard = in_array($subjectText, ['laptop', 'laptops'], true);

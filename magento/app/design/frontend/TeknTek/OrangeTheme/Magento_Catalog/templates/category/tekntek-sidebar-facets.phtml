        <?php foreach ($facetGroups as $groupKey => $groupConfig): ?>
            <?php
            $groupCoverageCount = (int) ($facetCompleteness[$groupKey] ?? 0);
            $groupCoverageRatio = $totalFacetProducts > 0 ? ($groupCoverageCount / $totalFacetProducts) : 0;

            if ($totalFacetProducts <= 0 || $groupCoverageCount < 2 || $groupCoverageRatio < 0.1) {
                continue;
            }

            $counts = $facetCounts[$groupKey];
            if (empty($counts)) {
                continue;
            }

            $orderedValues = [];
            if (!empty($groupConfig['order'])) {
                foreach ($groupConfig['order'] as $valueName) {
                    if (isset($counts[$valueName])) {
                        $orderedValues[] = $valueName;
                    }
                }
                if ($groupKey !== 'brand') {
                    foreach (array_keys($counts) as $valueName) {
                        if (!in_array($valueName, $orderedValues, true)) {
                            $orderedValues[] = $valueName;
                        }
                    }
                }
            } else {
                $orderedValues = array_keys($counts);
            }

            $renderableValues = array_values(array_filter($orderedValues, static function ($valueName) use ($counts) {
                return isset($counts[$valueName]) && (int) $counts[$valueName] > 0;
            }));
            if (count($renderableValues) <= 1) {
                continue;
            }
            if (count($renderableValues) === 1 && (int) $counts[$renderableValues[0]] >= $totalFacetProducts) {
                continue;
            }
            ?>

}

.ttk-option-count {
    color: #9ca3af;
    font-size: 11px;
}
</style>

<div class="ttk-facet-box" id="ttk-facet-box">
    <h3 class="ttk-facet-title">Price</h3>
    <div class="ttk-facet-price-row">
        <input id="ttk-price-min-input" type="number" min="<?= (int) floor($minPrice) ?>" max="<?= (int) ceil($maxPrice) ?>" value="<?= (int) floor($currentMin) ?>" />
        <input id="ttk-price-max-input" type="number" min="<?= (int) floor($minPrice) ?>" max="<?= (int) ceil($maxPrice) ?>" value="<?= (int) ceil($currentMax) ?>" />
    </div>

    <input id="ttk-price-min-range" class="ttk-facet-range" type="range" min="<?= (int) floor($minPrice) ?>" max="<?= (int) ceil($maxPrice) ?>" value="<?= (int) floor($currentMin) ?>" />
    <input id="ttk-price-max-range" class="ttk-facet-range" type="range" min="<?= (int) floor($minPrice) ?>" max="<?= (int) ceil($maxPrice) ?>" value="<?= (int) ceil($currentMax) ?>" />

    <label class="ttk-facet-toggle" for="ttk-stock-toggle">
        <span>Only available items</span>
        <span class="ttk-switch">
            <input id="ttk-stock-toggle" type="checkbox" <?= $stockOnly ? 'checked' : '' ?> />
            <span class="ttk-switch-slider"></span>
        </span>
    </label>

    <div class="ttk-facet-actions">
        <button type="button" class="ttk-facet-btn ttk-facet-btn--primary" id="ttk-facet-apply">Apply</button>
        <button type="button" class="ttk-facet-btn" id="ttk-facet-clear">Clear</button>
    </div>

    <div class="ttk-accordion" id="ttk-facet-accordion">
        <?php foreach ($facetGroups as $groupKey => $groupConfig): ?>
            <?php
            $counts = $facetCounts[$groupKey];
            if (empty($counts)) {
                continue;
            }

            $orderedValues = [];
            if (!empty($groupConfig['order'])) {
                foreach ($groupConfig['order'] as $valueName) {
                    if (isset($counts[$valueName])) {
                        $orderedValues[] = $valueName;
                    }
                }
                if ($groupKey !== 'brand') {
                    foreach (array_keys($counts) as $valueName) {
                        if (!in_array($valueName, $orderedValues, true)) {
                            $orderedValues[] = $valueName;
                        }
                    }
                }
            } else {
                $orderedValues = array_keys($counts);
            }
            ?>
            <details class="ttk-accordion-item" open>
                <summary class="ttk-accordion-summary">
                    <span><?= $block->escapeHtml($groupConfig['label']) ?></span>
                    <span class="ttk-accordion-arrow" aria-hidden="true"></span>
                </summary>
                <div class="ttk-option-list">
                    <?php foreach ($orderedValues as $valueName): ?>
                        <div class="ttk-option-row">
                            <label>
                                <input type="checkbox" class="ttk-facet-check" data-group="<?= $block->escapeHtmlAttr($groupKey) ?>" data-value="<?= $block->escapeHtmlAttr($valueName) ?>" />
                                <span><?= $block->escapeHtml($valueName) ?></span>
                            </label>
                            <span class="ttk-option-count">(<?= (int) $counts[$valueName] ?>)</span>
                        </div>
                    <?php endforeach; ?>
                </div>
            </details>
        <?php endforeach; ?>
    </div>
</div>

<script type="application/json" id="ttk-facet-meta-json"><?= /* @noEscape */ json_encode($productsMeta, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) ?></script>

<script>
(function () {
    var root = document.getElementById('ttk-facet-box');
    if (!root) {
        return;
    }

    var minInput = document.getElementById('ttk-price-min-input');
    var maxInput = document.getElementById('ttk-price-max-input');
    var minRange = document.getElementById('ttk-price-min-range');
    var maxRange = document.getElementById('ttk-price-max-range');
    var stockToggle = document.getElementById('ttk-stock-toggle');
    var applyBtn = document.getElementById('ttk-facet-apply');
    var clearBtn = document.getElementById('ttk-facet-clear');
    var metaNode = document.getElementById('ttk-facet-meta-json');
    var checks = Array.prototype.slice.call(document.querySelectorAll('.ttk-facet-check'));
    var cards = Array.prototype.slice.call(document.querySelectorAll('.products-grid .product-item'));

    var productMeta = [];
    try {
        productMeta = JSON.parse(metaNode ? metaNode.textContent : '[]');
        if (!Array.isArray(productMeta)) {
            productMeta = [];
        }
    } catch (e) {
        productMeta = [];
    }

    if (!minInput || !maxInput || !minRange || !maxRange || !stockToggle || !applyBtn || !clearBtn) {
        return;
    }

    function syncMinFromInput() {
        minRange.value = minInput.value;
    }

    function syncMaxFromInput() {
        maxRange.value = maxInput.value;
    }

    function syncMinFromRange() {
        minInput.value = minRange.value;
    }

    function syncMaxFromRange() {
        maxInput.value = maxRange.value;
    }

    minInput.addEventListener('input', syncMinFromInput);
    maxInput.addEventListener('input', syncMaxFromInput);
    minRange.addEventListener('input', syncMinFromRange);
    maxRange.addEventListener('input', syncMaxFromRange);

    applyBtn.addEventListener('click', function () {
        var min = Number(minInput.value || 0);
        var max = Number(maxInput.value || 0);
        if (max > 0 && min > max) {
            var temp = min;
            min = max;
            max = temp;
        }

        var url = new URL(window.location.href);
        if (max > 0) {
            url.searchParams.set('price', String(Math.floor(min)) + '-' + String(Math.ceil(max)));
        } else {
            url.searchParams.delete('price');
        }

        if (stockToggle.checked) {
            url.searchParams.set('stock', '1');
        } else {
            url.searchParams.delete('stock');
        }

        window.location.href = url.toString();
    });

    clearBtn.addEventListener('click', function () {
        var url = new URL(window.location.href);
        url.searchParams.delete('price');
        url.searchParams.delete('stock');
        window.location.href = url.toString();
    });

    function collectSelectedFacets() {
        var selected = {};
        checks.forEach(function (input) {
            if (!input.checked) {
                return;
            }
            var group = input.getAttribute('data-group') || '';
            var value = input.getAttribute('data-value') || '';
            if (!group || !value) {
                return;
            }
            if (!selected[group]) {
                selected[group] = [];
            }
            selected[group].push(value);
        });
        return selected;
    }

    function matchesGroup(metaValue, selectedValues) {
        if (!selectedValues || !selectedValues.length) {
            return true;
        }
        if (Array.isArray(metaValue)) {
            return metaValue.some(function (v) {
                return selectedValues.indexOf(v) !== -1;
            });
        }
        return selectedValues.indexOf(metaValue) !== -1;
    }

    function applyFacetVisibility() {
        var selected = collectSelectedFacets();
        cards.forEach(function (card, idx) {
            var meta = productMeta[idx] || {};
            var visible = true;

            Object.keys(selected).forEach(function (groupKey) {
                if (!visible) {
                    return;
                }
                var selectedValues = selected[groupKey] || [];
                if (!matchesGroup(meta[groupKey], selectedValues)) {
                    visible = false;
                }
            });

            if (stockToggle.checked && card.querySelector('.stock.unavailable')) {
                visible = false;
            }

            card.style.display = visible ? '' : 'none';
        });
    }

    checks.forEach(function (input) {
        input.addEventListener('change', applyFacetVisibility);
    });

    // Remove duplicated native "Price" block from layered navigation.
    (function hideNativePriceFilter() {
        var titles = document.querySelectorAll('.filter-options-title');
        titles.forEach(function (title) {
            var text = (title.textContent || '').trim().toLowerCase();
            if (text !== 'price') {
                return;
            }
            var item = title.closest('.filter-options-item');
            if (item) {
                item.style.display = 'none';
            }
        });
    })();

    if (new URL(window.location.href).searchParams.get('stock') === '1') {
        stockToggle.checked = true;
    }

    stockToggle.addEventListener('change', applyFacetVisibility);
    applyFacetVisibility();
})();
</script>

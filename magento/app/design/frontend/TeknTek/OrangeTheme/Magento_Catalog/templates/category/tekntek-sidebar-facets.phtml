$extractKnownBrand = static function (string $text) use ($knownBrandPatterns): string {
    foreach ($knownBrandPatterns as $brandName => $pattern) {
        if (preg_match($pattern, $text)) {
            return $brandName;
        }
    }
    return '';
};

$isUsefulBrandFallback = static function (string $brand): bool {
    $clean = strtolower(trim((string) preg_replace('/[^A-Za-z0-9\-\+\. ]+/', '', $brand)));
    if ($clean === '' || strlen($clean) < 2 || preg_match('/^\d/', $clean)) {
        return false;
    }

    $blocked = [
        'wireless', 'wired', 'bluetooth', 'smart', 'watch', 'watches', 'headphones',
        'earbuds', 'earphones', 'kids', 'android', 'iphone', 'usb', 'type', 'new',
        'renewed', 'gaming', 'laptop', 'tablet', 'tablets', 'monitor', 'camera', 'portable',
        'digital', 'hybrid', 'external', 'inch', 'inches', '2026', '2025', '2024', '4k',
        '5k', '8k', '10', '500gb', '750gb', '1tb', '2tb', '4tb', '5tb',
        'military', 'tablet14', 'garbage'
    ];

    return !in_array($clean, $blocked, true);
};

$hasFacetValue = static function ($value): bool {
    if (is_array($value)) {
        return count(array_filter($value, static function ($item): bool {
            return trim((string) $item) !== '';
        })) > 0;
    }

    return trim((string) $value) !== '';
};

$cacheKey = 'TTK_SMART_FACETS_' . sha1(json_encode([
    'store' => $storeId,
    'category' => $currentCategory ? (int) $currentCategory->getId() : 0,
    'query' => $queryText,
    'profile' => $profile,
    'groups' => array_keys($facetGroups),
    'size' => (int) $collection->getSize()
]));
$cachePayload = null;

try {
    $cache = $om->get(\Magento\Framework\App\CacheInterface::class);
    $cached = $cache->load($cacheKey);
    if (is_string($cached) && $cached !== '') {
        $decoded = json_decode($cached, true);
        if (is_array($decoded)) {
            $cachePayload = $decoded;
        }
    }
} catch (\Throwable $e) {
    $cachePayload = null;
}

if ($cachePayload !== null) {
    $productsMeta = $cachePayload['productsMeta'] ?? [];
    $facetCounts = $cachePayload['facetCounts'] ?? $facetCounts;
    $facetCompleteness = $cachePayload['facetCompleteness'] ?? $facetCompleteness;
    $minPrice = (float) ($cachePayload['minPrice'] ?? 0);
    $maxPrice = (float) ($cachePayload['maxPrice'] ?? 0);
} else {
    $minPrice = 0;
    $maxPrice = 0;
}

if ($cachePayload === null) {
foreach ($collection as $item) {
    $name = trim((string) $item->getName());
    $shortDesc = trim((string) $item->getShortDescription());
    $description = trim((string) $item->getDescription());
    $text = strtolower($name . ' ' . $shortDesc . ' ' . $description);
    $brandSourceText = $name . ' ' . $shortDesc . ' ' . $description;

    $manufacturer = $item->getAttributeText('manufacturer');
    if (is_array($manufacturer)) {
        $manufacturer = implode(', ', $manufacturer);
    }
    $brand = $extractKnownBrand($brandSourceText);
    if ($brand === '' && $isUsefulBrandFallback((string) $manufacturer)) {
        $brand = trim((string) $manufacturer);
    }
    if ($brand === '' && $isUsefulBrandFallback((string) $item->getData('brand'))) {
        $brand = trim((string) $item->getData('brand'));
    }
    if ($brand === '') {
        $firstWord = preg_split('/\s+/', $name);
        $fallbackBrand = isset($firstWord[0]) ? (string) $firstWord[0] : '';
        $brand = $isUsefulBrandFallback($fallbackBrand) ? $fallbackBrand : '';
    }
    $brand = trim((string) preg_replace('/[^A-Za-z0-9\-\+\. ]+/', '', $brand));
    $brand = $normalizeBrand($brand);

    $classification = [];
    if (preg_match('/gaming|game|rtx|gtx|fps/', $text)) {
        $classification[] = 'Gaming';
    }
    if (preg_match('/office|business|work|productivity/', $text)) {
        $classification[] = 'Office';
    }
    if (preg_match('/creator|editing|design|render/', $text)) {
        $classification[] = 'Creator';
    }
    if (preg_match('/student|school|study/', $text)) {
        $classification[] = 'Student';
    }

    $screenSource = strtolower(
        trim(
            (string) $item->getData('screen_size') . ' ' .
            (string) $item->getData('screen_diagonal') . ' ' .
            (string) $item->getData('display_size') . ' ' .
            $name . ' ' . $shortDesc
        )
    );
    $screenSize = $extractScreenSize($screenSource);

    $touchRaw = strtolower(
        trim(
            (string) $item->getData('touchscreen') . ' ' .
            (string) $item->getData('touch_screen') . ' ' .
            (string) $item->getData('display_features') . ' ' .
            $text
        )
    );
    $touchscreen = preg_match('/touch|touchscreen|multi-touch|multi touch/', $touchRaw) ? 'Yes' : 'No';

    $ramSource = strtolower(
        trim(
            (string) $item->getData('ram') . ' ' .
            (string) $item->getData('memory') . ' ' .
            (string) $item->getData('internal_memory') . ' ' .
            (string) $item->getData('ram_type') . ' ' .
            $name . ' ' . $shortDesc
        )
    );
    $ramBucket = $extractRamBucket($ramSource);
    $ramType = $extractRamType($ramSource);
    $storageBucket = $extractStorageBucket($text . ' ' . (string) $item->getData('storage') . ' ' . (string) $item->getData('hard_drive_size'));
    $connectivity = $extractConnectivity($text . ' ' . (string) $item->getData('wireless_connectivity') . ' ' . (string) $item->getData('bluetooth'));
    $batteryBucket = $extractBatteryBucket($text . ' ' . (string) $item->getData('battery_life') . ' ' . (string) $item->getData('maximum_battery_battery_life'));
    $interface = $extractInterface($text . ' ' . (string) $item->getData('ports') . ' ' . (string) $item->getData('usb_connection_type'));
    $noiseCancel = preg_match('/noise[ -]?cancel|anc/', $text) ? 'Yes' : 'No';
    $microphone = preg_match('/microphone|\bmic\b/', $text) ? 'Yes' : 'No';
    $megapixelBucket = $extractMegapixelBucket($text . ' ' . (string) $item->getData('resolution'));
    $lensType = $extractLensType($text);
    $stabilization = preg_match('/\bois\b/', $text) ? 'OIS' : (preg_match('/\beis\b|stabiliz/', $text) ? 'EIS' : 'None');
    $panelType = $extractPanelType($screenSource . ' ' . $text);
    $refreshRate = $extractRefreshRate($screenSource . ' ' . $text);

    $meta = [
        'id' => (int) $item->getId(),
        'url' => (string) $item->getProductUrl(),
        'price' => (float) $item->getFinalPrice(),
        'in_stock' => (bool) $item->isAvailable(),
        'classification' => $classification,
        'screen_size' => $screenSize,
        'touchscreen' => $touchscreen,
        'ram_bucket' => $ramBucket,
        'ram_type' => $ramType,
        'storage_bucket' => $storageBucket,
        'connectivity' => $connectivity,
        'battery_bucket' => $batteryBucket,
        'interface' => $interface,
        'noise_cancel' => $noiseCancel,
        'microphone' => $microphone,
        'megapixel_bucket' => $megapixelBucket,
        'lens_type' => $lensType,
        'stabilization' => $stabilization,
        'panel_type' => $panelType,
        'refresh_rate' => $refreshRate,
        'brand' => $brand
    ];

    $price = (float) $item->getFinalPrice();
    if ($price > 0) {
        if ($minPrice === 0 || $price < $minPrice) {
            $minPrice = $price;
        }
        if ($price > $maxPrice) {
            $maxPrice = $price;
        }
    }

    foreach ($activeGroupKeys as $groupKey) {
        if (!isset($meta[$groupKey]) || !isset($facetCounts[$groupKey])) {
            continue;
        }
        if ($hasFacetValue($meta[$groupKey])) {
            $facetCompleteness[$groupKey] = ($facetCompleteness[$groupKey] ?? 0) + 1;
        }
        if (is_array($meta[$groupKey])) {
            foreach ($meta[$groupKey] as $v) {
                $collectCount($facetCounts[$groupKey], (string) $v);
            }
            continue;
        }
        $collectCount($facetCounts[$groupKey], (string) $meta[$groupKey]);
    }

    $productsMeta[] = $meta;
}

$totalFacetProducts = count($productsMeta);
usort($productsMeta, static function (array $a, array $b): int {
    return ((int) ($b['id'] ?? 0)) <=> ((int) ($a['id'] ?? 0));
});

try {
    if (isset($cache)) {
        $cache->save(json_encode([
            'productsMeta' => $productsMeta,
            'facetCounts' => $facetCounts,
            'facetCompleteness' => $facetCompleteness,
            'minPrice' => $minPrice,
            'maxPrice' => $maxPrice
        ]), $cacheKey, ['TTK_SMART_FACETS'], 900);
    }
} catch (\Throwable $e) {
    // Cache is an optimization only.
}
} else {
    $totalFacetProducts = count($productsMeta);
}

if (isset($facetCounts['brand'])) {
    arsort($facetCounts['brand'], SORT_NATURAL | SORT_FLAG_CASE);
    $facetCounts['brand'] = array_slice($facetCounts['brand'], 0, 12, true);
}

if ($maxPrice <= 0) {
    $minPrice = 0;
    $maxPrice = 2000;
}

$currentMin = $minPrice;
$currentMax = $maxPrice;
$priceParam = (string) $block->getRequest()->getParam('price');
if ($priceParam !== '' && strpos($priceParam, '-') !== false) {
    $parts = explode('-', $priceParam, 2);
    $pMin = isset($parts[0]) ? (float) $parts[0] : $minPrice;
    $pMax = isset($parts[1]) ? (float) $parts[1] : $maxPrice;
    if ($pMin >= 0) {
        $currentMin = $pMin;
    }
    if ($pMax > 0) {
        $currentMax = $pMax;
    }
}

$stockOnly = (string) $block->getRequest()->getParam('stock') === '1';
?>


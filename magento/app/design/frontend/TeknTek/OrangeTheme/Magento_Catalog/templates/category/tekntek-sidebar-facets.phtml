<script>
(function () {
    var root = document.getElementById('ttk-facet-box');
    if (!root) {
        return;
    }

    var minInput = document.getElementById('ttk-price-min-input');
    var maxInput = document.getElementById('ttk-price-max-input');
    var minRange = document.getElementById('ttk-price-min-range');
    var maxRange = document.getElementById('ttk-price-max-range');
    var stockToggle = document.getElementById('ttk-stock-toggle');
    var applyBtn = document.getElementById('ttk-facet-apply');
    var clearBtn = document.getElementById('ttk-facet-clear');
    var metaNode = document.getElementById('ttk-facet-meta-json');
    var checks = Array.prototype.slice.call(document.querySelectorAll('.ttk-facet-check'));
    var cards = Array.prototype.slice.call(document.querySelectorAll('.products-grid .product-item'));
    var pendingFilterTimer = 0;
    var ajaxController = null;

    var productMeta = null;
    var productMetaById = {};
    var selectedFacetState = {};

    function ensureProductMeta() {
        if (productMeta !== null) {
            return productMeta;
        }

        try {
            productMeta = JSON.parse(metaNode ? metaNode.textContent : '[]');
            if (!Array.isArray(productMeta)) {
                productMeta = [];
            }
        } catch (e) {
            productMeta = [];
        }

        productMetaById = {};
        productMeta.forEach(function (meta) {
            if (meta && meta.id) {
                productMetaById[String(meta.id)] = meta;
            }
        });

        return productMeta;
    }

    if (!minInput || !maxInput || !minRange || !maxRange || !stockToggle || !applyBtn || !clearBtn) {
        return;
    }

    function syncMinFromInput() {
        minRange.value = minInput.value;
    }

    function syncMaxFromInput() {
        maxRange.value = maxInput.value;
    }

    function syncMinFromRange() {
        minInput.value = minRange.value;
    }

    function syncMaxFromRange() {
        maxInput.value = maxRange.value;
    }

    minInput.addEventListener('input', syncMinFromInput);
    maxInput.addEventListener('input', syncMaxFromInput);
    minRange.addEventListener('input', syncMinFromRange);
    maxRange.addEventListener('input', syncMaxFromRange);

    applyBtn.addEventListener('click', function () {
        var min = Number(minInput.value || 0);
        var max = Number(maxInput.value || 0);
        if (max > 0 && min > max) {
            var temp = min;
            min = max;
            max = temp;
        }

        var url = new URL(window.location.href);
        if (max > 0) {
            url.searchParams.set('price', String(Math.floor(min)) + '-' + String(Math.ceil(max)));
        } else {
            url.searchParams.delete('price');
        }

        if (stockToggle.checked) {
            url.searchParams.set('stock', '1');
        } else {
            url.searchParams.delete('stock');
        }

        window.location.href = url.toString();
    });

    clearBtn.addEventListener('click', function () {
        var url = new URL(window.location.href);
        url.searchParams.delete('price');
        url.searchParams.delete('stock');
        url.searchParams.delete('p');
        Array.prototype.slice.call(url.searchParams.keys()).forEach(function (key) {
            if (key.indexOf('ttkf_') === 0) {
                url.searchParams.delete(key);
            }
        });
        window.location.href = url.toString();
    });

    function cloneSelectedFacetState() {
        var selected = {};
        Object.keys(selectedFacetState).forEach(function (groupKey) {
            if (selectedFacetState[groupKey] && selectedFacetState[groupKey].length) {
                selected[groupKey] = selectedFacetState[groupKey].slice();
            }
        });
        return selected;
    }

    function collectSelectedFacets() {
        return cloneSelectedFacetState();
    }

    function getFacetParamName(groupKey) {
        return 'ttkf_' + groupKey;
    }

    function getCurrentPerPage() {
        var limiter = document.querySelector('[data-role="limiter"], #limiter');
        var value = limiter ? Number(limiter.value || 0) : 0;
        if (value > 0) {
            return value;
        }
        return cards.length > 0 ? cards.length : 10;
    }

    function syncSelectedFacetsToUrl(url, selected) {
        Array.prototype.slice.call(url.searchParams.keys()).forEach(function (key) {
            if (key.indexOf('ttkf_') === 0) {
                url.searchParams.delete(key);
            }
        });

        Object.keys(selected).forEach(function (groupKey) {
            var values = selected[groupKey] || [];
            if (values.length) {
                url.searchParams.set(getFacetParamName(groupKey), values.join('|'));
            }
        });
    }

    function setFacetValue(groupKey, value, shouldSelect) {
        if (!groupKey || !value) {
            return;
        }

        var values = selectedFacetState[groupKey] || [];
        var index = values.indexOf(value);

        if (shouldSelect && index === -1) {
            values.push(value);
        } else if (!shouldSelect && index !== -1) {
            values.splice(index, 1);
        }

        if (values.length) {
            selectedFacetState[groupKey] = values;
        } else {
            delete selectedFacetState[groupKey];
        }
    }

    function isFacetValueSelected(groupKey, value) {
        return !!(selectedFacetState[groupKey] && selectedFacetState[groupKey].indexOf(value) !== -1);
    }

    function syncCheckboxesFromState() {
        checks.forEach(function (input) {
            var group = input.getAttribute('data-group') || '';
            var value = input.getAttribute('data-value') || '';
            input.checked = isFacetValueSelected(group, value);
        });
    }

    function restoreSelectedFacetsFromUrl() {
        var url = new URL(window.location.href);
        selectedFacetState = {};

        Array.prototype.slice.call(url.searchParams.keys()).forEach(function (key) {
            if (key.indexOf('ttkf_') !== 0) {
                return;
            }
            var group = key.replace('ttkf_', '');
            var raw = url.searchParams.get(key) || '';
            raw.split('|').forEach(function (value) {
                if (value) {
                    setFacetValue(group, value, true);
                }
            });
        });

        syncCheckboxesFromState();
    }

    function hasActiveFacetParams() {
        var url = new URL(window.location.href);
        var hasFacet = Array.prototype.slice.call(url.searchParams.keys()).some(function (key) {
            return key.indexOf('ttkf_') === 0;
        });

        return hasFacet || url.searchParams.get('stock') === '1';
    }

    function matchesGroup(metaValue, selectedValues) {
        if (!selectedValues || !selectedValues.length) {
            return true;
        }
        if (Array.isArray(metaValue)) {
            return metaValue.some(function (v) {
                return selectedValues.indexOf(v) !== -1;
            });
        }
        return selectedValues.indexOf(metaValue) !== -1;
    }

    function getCardProductId(card) {
        var info = card.querySelector('[id^="product-item-info_"]');
        if (info && info.id) {
            return info.id.replace('product-item-info_', '');
        }
        var price = card.querySelector('[data-product-id]');
        return price ? price.getAttribute('data-product-id') : '';
    }

    function getCardMeta(card, fallbackIndex) {
        ensureProductMeta();
        var productId = getCardProductId(card);
        if (productId && productMetaById[productId]) {
            return productMetaById[productId];
        }
        return productMeta[fallbackIndex] || {};
    }

    function metaIsOutOfStock(meta) {
        return !!(meta && meta.in_stock === false);
    }

    function matchesSelectedFilters(meta, selected, excludedGroup) {
        var visible = true;
        Object.keys(selected).forEach(function (groupKey) {
            if (!visible || groupKey === excludedGroup) {
                return;
            }
            var selectedValues = selected[groupKey] || [];
            if (!matchesGroup(meta[groupKey], selectedValues)) {
                visible = false;
            }
        });

        if (visible && stockToggle.checked && metaIsOutOfStock(meta)) {
            visible = false;
        }

        return visible;
    }

    function metaContainsValue(metaValue, value) {
        if (Array.isArray(metaValue)) {
            return metaValue.indexOf(value) !== -1;
        }
        return metaValue === value;
    }

    function refreshFacetCounts(selected) {
        ensureProductMeta();
        var groups = Array.prototype.slice.call(root.querySelectorAll('.ttk-accordion-item[data-facet-group]'));
        groups.forEach(function (groupNode) {
            var groupKey = groupNode.getAttribute('data-facet-group') || '';
            var rows = Array.prototype.slice.call(groupNode.querySelectorAll('.ttk-option-row[data-facet-option]'));
            var baseTotal = 0;
            var counts = {};
            var visibleRows = 0;
            var onlyVisibleCount = 0;
            var hasSelectedValue = !!(selected[groupKey] && selected[groupKey].length);

            productMeta.forEach(function (meta) {
                meta = meta || {};
                if (!matchesSelectedFilters(meta, selected, groupKey)) {
                    return;
                }

                baseTotal += 1;
                var metaValue = meta[groupKey];
                if (Array.isArray(metaValue)) {
                    metaValue.forEach(function (value) {
                        if (value) {
                            counts[value] = (counts[value] || 0) + 1;
                        }
                    });
                    return;
                }

                if (metaValue) {
                    counts[metaValue] = (counts[metaValue] || 0) + 1;
                }
            });

            rows.forEach(function (row) {
                var value = row.getAttribute('data-facet-option') || '';
                var count = counts[value] || 0;
                var input = row.querySelector('.ttk-facet-check');
                var countNode = row.querySelector('[data-count]');
                var isSelected = isFacetValueSelected(groupKey, value);

                if (countNode) {
                    countNode.textContent = '(' + count + ')';
                }
                row.style.display = (count > 0 || isSelected) ? '' : 'none';
                if (input) {
                    input.checked = isSelected;
                    input.disabled = count <= 0 && !isSelected;
                }

                if (count > 0) {
                    visibleRows += 1;
                    onlyVisibleCount = count;
                }
            });

            groupNode.style.display = (!hasSelectedValue && (visibleRows <= 1 || onlyVisibleCount >= baseTotal)) ? 'none' : '';
            groupNode.open = true;
        });
    }

    function applyFacetVisibility(selected) {
        selected = selected || collectSelectedFacets();
        cards.forEach(function (card, idx) {
            var meta = getCardMeta(card, idx);
            card.style.display = matchesSelectedFilters(meta, selected, '') ? '' : 'none';
        });
        refreshFacetCounts(selected);
    }

    function pageHasMatchingCard(selected) {
        return cards.some(function (card, idx) {
            return matchesSelectedFilters(getCardMeta(card, idx), selected, '');
        });
    }

    function getMatchingMeta(selected) {
        ensureProductMeta();
        return productMeta.filter(function (meta) {
            return matchesSelectedFilters(meta || {}, selected, '');
        });
    }

    function updateBrowserFilterUrl(selected, targetPage, replaceOnly) {
        var url = new URL(window.location.href);
        syncSelectedFacetsToUrl(url, selected);
        if (stockToggle.checked) {
            url.searchParams.set('stock', '1');
        } else {
            url.searchParams.delete('stock');
        }

        if (targetPage > 1) {
            url.searchParams.set('p', String(targetPage));
        } else if (targetPage === 1) {
            url.searchParams.delete('p');
        }

        if (replaceOnly) {
            window.history.replaceState(null, '', url.toString());
            return url;
        }

        return url;
    }

    function getProductListNode(doc) {
        return doc.querySelector('.products-grid .product-items, .products.wrapper .product-items, ol.product-items');
    }

    function getToolbarAmountNodes() {
        return Array.prototype.slice.call(document.querySelectorAll('.toolbar-amount'));
    }

    function buildPageUrl(pageNumber) {
        var url = new URL(window.location.href);
        Array.prototype.slice.call(url.searchParams.keys()).forEach(function (key) {
            if (key.indexOf('ttkf_') === 0) {
                url.searchParams.delete(key);
            }
        });
        if (pageNumber > 1) {
            url.searchParams.set('p', String(pageNumber));
        } else {
            url.searchParams.delete('p');
        }
        return url.toString();
    }

    function updateToolbarForAjaxResult(count) {
        getToolbarAmountNodes().forEach(function (node) {
            if (count <= 0) {
                node.textContent = '0 products';
            } else {
                node.textContent = 'Items 1-' + count + ' of ' + count;
            }
        });
        document.querySelectorAll('.pages').forEach(function (node) {
            node.style.display = count > getCurrentPerPage() ? '' : 'none';
        });
    }

    function renderNoAjaxResults(listNode) {
        listNode.innerHTML = '<li class="item product product-item ttk-no-filter-results">No products match these filters.</li>';
        cards = [];
        updateToolbarForAjaxResult(0);
    }

    function ajaxRenderMatches(matchingMeta) {
        ensureProductMeta();
        var listNode = getProductListNode(document);
        if (!listNode) {
            applyFacetVisibility();
            return;
        }

        if (ajaxController) {
            ajaxController.abort();
        }
        ajaxController = new AbortController();

        if (!matchingMeta.length) {
            renderNoAjaxResults(listNode);
            return;
        }

        var perPage = getCurrentPerPage();
        var targetIds = {};
        var pages = {};
        matchingMeta.forEach(function (meta) {
            targetIds[String(meta.id)] = true;
            var index = productMeta.findIndex(function (item) {
                return String(item.id) === String(meta.id);
            });
            var page = Math.floor(Math.max(index, 0) / perPage) + 1;
            pages[page] = true;
        });

        var pageNumbers = Object.keys(pages).map(Number).sort(function (a, b) {
            return a - b;
        });
        var parser = new DOMParser();
        listNode.setAttribute('aria-busy', 'true');

        Promise.all(pageNumbers.map(function (pageNumber) {
            if (pageNumber === Number(new URL(window.location.href).searchParams.get('p') || 1)) {
                return Promise.resolve(document);
            }
            return fetch(buildPageUrl(pageNumber), {
                credentials: 'same-origin',
                signal: ajaxController.signal
            }).then(function (response) {
                return response.text();
            }).then(function (html) {
                return parser.parseFromString(html, 'text/html');
            });
        })).then(function (docs) {
            var nodesById = {};
            docs.forEach(function (doc) {
                Array.prototype.slice.call(doc.querySelectorAll('.products-grid .product-item, .products.wrapper .product-item')).forEach(function (item) {
                    var info = item.querySelector('[id^="product-item-info_"]');
                    if (!info || !info.id) {
                        return;
                    }
                    var id = info.id.replace('product-item-info_', '');
                    if (targetIds[id]) {
                        nodesById[id] = item.outerHTML;
                    }
                });
            });

            listNode.innerHTML = matchingMeta.map(function (meta) {
                return nodesById[String(meta.id)] || '';
            }).filter(Boolean).join('');
            cards = Array.prototype.slice.call(document.querySelectorAll('.products-grid .product-item'));
            listNode.removeAttribute('aria-busy');
            updateToolbarForAjaxResult(cards.length);
            syncCheckboxesFromState();
            refreshFacetCounts(collectSelectedFacets());
        }).catch(function (error) {
            if (error && error.name === 'AbortError') {
                return;
            }
            listNode.removeAttribute('aria-busy');
            applyFacetVisibility();
        });
    }

    function applyFacetState() {
        syncCheckboxesFromState();
        var selected = collectSelectedFacets();
        var matchingMeta = getMatchingMeta(selected);
        updateBrowserFilterUrl(selected, 1, true);
        refreshFacetCounts(selected);

        if (matchingMeta.length === 1 && matchingMeta[0].url) {
            window.location.href = matchingMeta[0].url;
            return;
        }

        ajaxRenderMatches(matchingMeta);
    }

    function scheduleFacetStateUpdate() {
        if (pendingFilterTimer) {
            window.clearTimeout(pendingFilterTimer);
        }
        pendingFilterTimer = window.setTimeout(function () {
            pendingFilterTimer = 0;
            applyFacetState();
        }, 350);
    }

    checks.forEach(function (input) {
        input.addEventListener('click', function (event) {
            event.stopPropagation();

            if (input.disabled) {
                return;
            }

            var group = input.getAttribute('data-group') || '';
            var value = input.getAttribute('data-value') || '';
            setFacetValue(group, value, !isFacetValueSelected(group, value));
            syncCheckboxesFromState();
            scheduleFacetStateUpdate();
        });
    });

    root.querySelectorAll('.ttk-accordion-summary').forEach(function (summary) {
        summary.addEventListener('click', function (event) {
            event.preventDefault();
            var details = summary.closest('.ttk-accordion-item');
            if (details) {
                details.open = true;
            }
        });
    });

    // Remove duplicated native "Price" block from layered navigation.
    (function hideNativePriceFilter() {
        var titles = document.querySelectorAll('.filter-options-title');
        titles.forEach(function (title) {
            var text = (title.textContent || '').trim().toLowerCase();
            if (text !== 'price') {
                return;
            }
            var item = title.closest('.filter-options-item');
            if (item) {
                item.style.display = 'none';
            }
        });
    })();

    if (new URL(window.location.href).searchParams.get('stock') === '1') {
        stockToggle.checked = true;
    }

    restoreSelectedFacetsFromUrl();
    stockToggle.addEventListener('change', scheduleFacetStateUpdate);
    if (hasActiveFacetParams()) {
        applyFacetVisibility();
    }
})();
</script>

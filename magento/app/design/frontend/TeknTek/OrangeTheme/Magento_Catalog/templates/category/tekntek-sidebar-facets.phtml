<?php
$om = \Magento\Framework\App\ObjectManager::getInstance();
/** @var \Magento\Framework\View\Element\Template $block */

$registry = $om->get(\Magento\Framework\Registry::class);
$currentCategory = $registry->registry('current_category');
$collection = null;
$storeId = 0;

try {
    $storeId = (int) $om->get(\Magento\Store\Model\StoreManagerInterface::class)->getStore()->getId();
} catch (\Throwable $e) {
    $storeId = 0;
}

if ($currentCategory) {
    try {
        $collectionFactory = $om->get(\Magento\Catalog\Model\ResourceModel\Product\CollectionFactory::class);
        $storeManager = $om->get(\Magento\Store\Model\StoreManagerInterface::class);
        $productVisibility = $om->get(\Magento\Catalog\Model\Product\Visibility::class);

        $collection = $collectionFactory->create();
        $collection->setStoreId((int) $storeManager->getStore()->getId());
        $collection->addStoreFilter();
        $collection->addAttributeToSelect('*');
        $collection->addCategoriesFilter(['in' => [(int) $currentCategory->getId()]]);
        $collection->setVisibility($productVisibility->getVisibleInCatalogIds());
    } catch (\Throwable $e) {
        $collection = null;
    }
}

if (!$collection) {
    try {
        $layerResolver = $om->get(\Magento\Catalog\Model\Layer\Resolver::class);
        $collection = $layerResolver->get()->getProductCollection();
        $collection->setPageSize(false);
        $collection->setCurPage(1);
    } catch (\Throwable $e) {
        $collection = null;
    }
}

if (!$collection) {
    return;
}

try {
    $collection->addAttributeToSelect('*');
    $collection->addAttributeToFilter(
        'status',
        ['eq' => \Magento\Catalog\Model\Product\Attribute\Source\Status::STATUS_ENABLED]
    );
} catch (\Throwable $e) {
    // The loaded product list collection may already be filtered.
}

try {
    $stockHelper = $om->get(\Magento\CatalogInventory\Helper\Stock::class);
    $stockHelper->addInStockFilterToCollection($collection);
} catch (\Throwable $e) {
    // Keep the sidebar usable if the stock helper is unavailable.
}

$queryText = strtolower(trim((string) $block->getRequest()->getParam('q')));
$categoryText = strtolower(trim((string) ($currentCategory ? $currentCategory->getName() : '')));
$contextText = trim($categoryText . ' ' . $queryText);

$allFacetGroups = [
    'classification' => ['label' => 'Classification', 'order' => ['Gaming', 'Office', 'Creator', 'Student']],
    'screen_size' => ['label' => 'Screen size', 'order' => ['11 inch', '13 inch', '14 inch', '15 inch', '16 inch+']],
    'touchscreen' => ['label' => 'Touchscreen', 'order' => ['Yes', 'No']],
    'ram_bucket' => ['label' => 'RAM', 'order' => ['4GB', '8GB', '16GB', '32GB+']],
    'ram_type' => ['label' => 'Type of RAM memory', 'order' => ['DDR3', 'DDR4', 'DDR5', 'LPDDR4', 'LPDDR5']],
    'storage_bucket' => ['label' => 'Storage', 'order' => ['64GB', '128GB', '256GB', '512GB', '1TB+']],
    'connectivity' => ['label' => 'Connectivity', 'order' => ['5G', '4G', 'Wi-Fi', 'Bluetooth', 'Wired']],
    'battery_bucket' => ['label' => 'Battery life', 'order' => ['Up to 6h', '6-10h', '10h+']],
    'interface' => ['label' => 'Interface', 'order' => ['USB-C', 'USB-A', 'Wireless', 'Bluetooth', 'HDMI', 'DisplayPort']],
    'noise_cancel' => ['label' => 'Noise cancellation', 'order' => ['Yes', 'No']],
    'microphone' => ['label' => 'Microphone', 'order' => ['Yes', 'No']],
    'megapixel_bucket' => ['label' => 'Resolution', 'order' => ['12MP', '24MP', '48MP', '64MP+']],
    'lens_type' => ['label' => 'Lens type', 'order' => ['Wide', 'Telephoto', 'Macro', 'Zoom']],
    'stabilization' => ['label' => 'Stabilization', 'order' => ['OIS', 'EIS', 'None']],
    'panel_type' => ['label' => 'Panel type', 'order' => ['IPS', 'OLED', 'VA', 'TN']],
    'refresh_rate' => ['label' => 'Refresh rate', 'order' => ['60Hz', '90Hz', '120Hz', '144Hz+']],
    'brand' => ['label' => 'Brand', 'order' => []]
];

$resolveProfile = static function (string $text): string {
    if (preg_match('/headphone|earphone|speaker|audio/', $text)) {
        return 'audio';
    }
    if (preg_match('/smartphone|phone|mobile|tablet|watch/', $text)) {
        return 'mobile';
    }
    if (preg_match('/camera/', $text)) {
        return 'camera';
    }
    if (preg_match('/monitor|display/', $text)) {
        return 'monitor';
    }
    if (preg_match('/mouse|mice|keyboard|hard drive|ssd|hdd|accessor/', $text)) {
        return 'peripheral';
    }
    if (preg_match('/laptop|notebook|computer/', $text)) {
        return 'laptop';
    }
    return 'generic';
};

$profile = $resolveProfile($contextText);
$profileGroupMap = [
    'laptop' => ['classification', 'screen_size', 'touchscreen', 'ram_bucket', 'ram_type', 'storage_bucket', 'battery_bucket', 'brand'],
    'mobile' => ['screen_size', 'ram_bucket', 'storage_bucket', 'connectivity', 'battery_bucket', 'touchscreen', 'brand'],
    'audio' => ['connectivity', 'noise_cancel', 'microphone', 'battery_bucket', 'brand'],
    'camera' => ['megapixel_bucket', 'lens_type', 'stabilization', 'connectivity', 'brand'],
    'monitor' => ['screen_size', 'panel_type', 'refresh_rate', 'interface', 'brand'],
    'peripheral' => ['interface', 'connectivity', 'brand'],
    'generic' => ['classification', 'screen_size', 'storage_bucket', 'connectivity', 'brand']
];

$activeGroupKeys = $profileGroupMap[$profile] ?? $profileGroupMap['generic'];
$facetGroups = [];
foreach ($activeGroupKeys as $groupKey) {
    if (isset($allFacetGroups[$groupKey])) {
        $facetGroups[$groupKey] = $allFacetGroups[$groupKey];
    }
}

$facetCounts = [];
foreach (array_keys($facetGroups) as $groupKey) {
    $facetCounts[$groupKey] = [];
}

$productsMeta = [];
$facetCompleteness = [];
foreach (array_keys($facetGroups) as $groupKey) {
    $facetCompleteness[$groupKey] = 0;
}

$extractScreenSize = static function (string $text): string {
    if (preg_match('/\b11(\.\d+)?\s?(inch|\"|in)\b/i', $text)) {
        return '11 inch';
    }
    if (preg_match('/\b13(\.\d+)?\s?(inch|\"|in)\b/i', $text)) {
        return '13 inch';
    }
    if (preg_match('/\b14(\.\d+)?\s?(inch|\"|in)\b/i', $text)) {
        return '14 inch';
    }
    if (preg_match('/\b15(\.\d+)?\s?(inch|\"|in)\b/i', $text)) {
        return '15 inch';
    }
    if (preg_match('/\b(16|17|18)(\.\d+)?\s?(inch|\"|in)\b/i', $text)) {
        return '16 inch+';
    }
    return '';
};

$extractRamBucket = static function (string $text): string {
    if (preg_match('/\b(3[2-9]|[4-9][0-9])\s?gb\b/i', $text)) {
        return '32GB+';
    }
    if (preg_match('/\b16\s?gb\b/i', $text)) {
        return '16GB';
    }
    if (preg_match('/\b8\s?gb\b/i', $text)) {
        return '8GB';
    }
    if (preg_match('/\b4\s?gb\b/i', $text)) {
        return '4GB';
    }
    return '';
};

$extractRamType = static function (string $text): string {
    if (stripos($text, 'lpddr5') !== false) {
        return 'LPDDR5';
    }
    if (stripos($text, 'lpddr4') !== false) {
        return 'LPDDR4';
    }
    if (stripos($text, 'ddr5') !== false) {
        return 'DDR5';
    }
    if (stripos($text, 'ddr4') !== false) {
        return 'DDR4';
    }
    if (stripos($text, 'ddr3') !== false) {
        return 'DDR3';
    }
    return '';
};

$extractStorageBucket = static function (string $text): string {
    if (preg_match('/\b(1|2)\s?tb\b/i', $text)) {
        return '1TB+';
    }
    if (preg_match('/\b512\s?gb\b/i', $text)) {
        return '512GB';
    }
    if (preg_match('/\b256\s?gb\b/i', $text)) {
        return '256GB';
    }
    if (preg_match('/\b128\s?gb\b/i', $text)) {
        return '128GB';
    }
    if (preg_match('/\b64\s?gb\b/i', $text)) {
        return '64GB';
    }
    return '';
};

$extractBatteryBucket = static function (string $text): string {
    if (preg_match('/\b(1[0-9]|2[0-9])\s?(h|hr|hrs|hour|hours)\b/i', $text)) {
        return '10h+';
    }
    if (preg_match('/\b([6-9])\s?(h|hr|hrs|hour|hours)\b/i', $text)) {
        return '6-10h';
    }
    if (preg_match('/\b([1-5])\s?(h|hr|hrs|hour|hours)\b/i', $text)) {
        return 'Up to 6h';
    }
    return '';
};

$extractConnectivity = static function (string $text): array {
    $values = [];
    if (preg_match('/\b5g\b/i', $text)) {
        $values[] = '5G';
    }
    if (preg_match('/\b4g\b|\blte\b/i', $text)) {
        $values[] = '4G';
    }
    if (preg_match('/\bwi[ -]?fi\b|\bwlan\b/i', $text)) {
        $values[] = 'Wi-Fi';
    }
    if (preg_match('/\bbluetooth\b|\bbt\b/i', $text)) {
        $values[] = 'Bluetooth';
    }
    if (preg_match('/\bwired\b|\b3\.5mm\b|\baux\b|\busb\b|\beth\b|ethernet/i', $text)) {
        $values[] = 'Wired';
    }
    return array_values(array_unique($values));
};

$extractInterface = static function (string $text): array {
    $values = [];
    if (preg_match('/usb[ -]?c|type[ -]?c/i', $text)) {
        $values[] = 'USB-C';
    }
    if (preg_match('/usb[ -]?a|usb\s+2\.0|usb\s+3\.0/i', $text)) {
        $values[] = 'USB-A';
    }
    if (preg_match('/displayport/i', $text)) {
        $values[] = 'DisplayPort';
    }
    if (preg_match('/hdmi/i', $text)) {
        $values[] = 'HDMI';
    }
    if (preg_match('/wireless/i', $text)) {
        $values[] = 'Wireless';
    }
    if (preg_match('/bluetooth/i', $text)) {
        $values[] = 'Bluetooth';
    }
    return array_values(array_unique($values));
};

$extractMegapixelBucket = static function (string $text): string {
    if (preg_match('/\b(64|108|200)\s?mp\b/i', $text)) {
        return '64MP+';
    }
    if (preg_match('/\b48\s?mp\b/i', $text)) {
        return '48MP';
    }
    if (preg_match('/\b24\s?mp\b/i', $text)) {
        return '24MP';
    }
    if (preg_match('/\b12\s?mp\b/i', $text)) {
        return '12MP';
    }
    return '';
};

$extractLensType = static function (string $text): string {
    if (preg_match('/telephoto|zoom/i', $text)) {
        return 'Telephoto';
    }
    if (preg_match('/macro/i', $text)) {
        return 'Macro';
    }
    if (preg_match('/wide|ultra[ -]?wide/i', $text)) {
        return 'Wide';
    }
    if (preg_match('/zoom/i', $text)) {
        return 'Zoom';
    }
    return '';
};

$extractPanelType = static function (string $text): string {
    if (preg_match('/oled|amoled/i', $text)) {
        return 'OLED';
    }
    if (preg_match('/ips/i', $text)) {
        return 'IPS';
    }
    if (preg_match('/\bva\b/i', $text)) {
        return 'VA';
    }
    if (preg_match('/\btn\b/i', $text)) {
        return 'TN';
    }
    return '';
};

$extractRefreshRate = static function (string $text): string {
    if (preg_match('/\b(144|165|240)\s?hz\b/i', $text)) {
        return '144Hz+';
    }
    if (preg_match('/\b120\s?hz\b/i', $text)) {
        return '120Hz';
    }
    if (preg_match('/\b90\s?hz\b/i', $text)) {
        return '90Hz';
    }
    if (preg_match('/\b60\s?hz\b/i', $text)) {
        return '60Hz';
    }
    return '';
};

$collectCount = static function (array &$groupCounts, string $value): void {
    if ($value === '') {
        return;
    }
    if (!isset($groupCounts[$value])) {
        $groupCounts[$value] = 0;
    }
    $groupCounts[$value] += 1;
};


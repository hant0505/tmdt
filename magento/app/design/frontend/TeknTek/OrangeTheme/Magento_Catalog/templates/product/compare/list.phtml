<?php else: ?>
    <div class="message info empty ttk-compare-empty"><div id="ttk-compare-empty-msg"><?= $block->escapeHtml(__('You have no items to compare.')) ?></div></div>
    <script>
    require(['Magento_Customer/js/customer-data'], function (customerData) {
        'use strict';

        var storageKey = 'tekntek_compare_v2';
        var currentUrl = new URL(window.location.href);
        var maxAttempts = 12;
        var attempts = 0;

        function normalizeId(value) {
            var id = Number(value);
            return id > 0 ? id : null;
        }

        function uniqueIds(items) {
            return items.map(function (item) {
                return normalizeId(item && item.id);
            }).filter(function (id, index, list) {
                return id && list.indexOf(id) === index;
            }).slice(0, 4);
        }

        function redirect(ids) {
            if (!ids.length) {
                return false;
            }

            currentUrl.searchParams.set('ids', ids.join(','));
            window.location.replace(currentUrl.toString());
            return true;
        }

        function readCustomerDataIds() {
            var section = customerData.get('compare-products')() || {};
            var rawItems = Array.isArray(section.items) ? section.items : [];

            if (!rawItems.length && section.items && typeof section.items === 'object') {
                rawItems = Object.keys(section.items).map(function (key) {
                    return section.items[key];
                });
            }

            return uniqueIds(rawItems);
        }

        function readLocalStorageIds() {
            try {
                var items = JSON.parse(window.localStorage.getItem(storageKey) || '[]');
                if (!Array.isArray(items)) {
                    return [];
                }

                return uniqueIds(items);
            } catch (error) {
                return [];
            }
        }

        function tryRedirect() {
            return redirect(readCustomerDataIds()) || redirect(readLocalStorageIds());
        }

        if (currentUrl.searchParams.get('ids')) {
            return;
        }

        customerData.reload(['compare-products'], true).always(function () {
            if (tryRedirect()) {
                return;
            }

            var timer = window.setInterval(function () {
                attempts += 1;
                if (tryRedirect() || attempts >= maxAttempts) {
                    window.clearInterval(timer);
                }
            }, 300);
        });
    });
    </script>

<?php endif; ?>

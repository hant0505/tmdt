    <script>
    (function () {
        var key = 'tekntek_compare_v1';
        var addBaseUrl = '<?= $block->escapeJs($block->getUrl('catalog/product_compare/add')) ?>';
        var clearUrl = '<?= $block->escapeJs($block->getUrl('catalog/product_compare/clear')) ?>';
        var msg = document.getElementById('ttk-compare-empty-msg');

        function formKey() {
            var node = document.querySelector('input[name="form_key"]');
            if (node && node.value) {
                return node.value;
            }
            if (window.FORM_KEY) {
                return window.FORM_KEY;
            }
            return '';
        }

        function post(url, payload) {
            return fetch(url, {
                method: 'POST',
                credentials: 'same-origin',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
                body: new URLSearchParams(payload).toString()
            }).catch(function () { return null; });
        }

        function addUrl(productId) {
            var base = addBaseUrl;
            if (base.slice(-1) !== '/') {
                base += '/';
            }
            return base + 'product/' + Number(productId) + '/';
        }

        var state = [];
        var idsFromUrl = [];
        try {
            var params = new URLSearchParams(window.location.search);
            var idsRaw = params.get('ids') || '';
            if (idsRaw) {
                idsFromUrl = idsRaw.split(',').map(function (part) {
                    return Number(String(part).trim());
                }).filter(function (id) {
                    return id > 0;
                }).slice(0, 3);
            }
        } catch (e) {
            idsFromUrl = [];
        }

        if (idsFromUrl.length) {
            state = idsFromUrl.map(function (id) {
                return { id: id };
            });
        }

        try {
            var raw = window.localStorage.getItem(key);
            var parsed = JSON.parse(raw || '[]');
            if (!state.length && Array.isArray(parsed)) {
                state = parsed.filter(function (item) {
                    return item && Number(item.id) > 0;
                }).slice(0, 3);
            }
        } catch (e) {
            state = [];
        }

        if (!state.length) {
            return;
        }

        var fk = formKey();
        var uenc = window.btoa(window.location.href);
        if (msg) {
            msg.textContent = 'Syncing compare items...';
        }

        Promise.all(state.map(function (item) {
            return post(addUrl(item.id), {
                form_key: fk,
                product: Number(item.id),
                uenc: uenc
            });
        })).then(function () {
            window.location.reload();
        });
    })();
    </script>
<?php endif; ?>

<?php
/**
 * Custom product compare layout for OrangeTheme.
 *
 * @var $block \Magento\Catalog\Block\Product\Compare\ListCompare
 */

$compareHelper = $this->helper(Magento\Catalog\Helper\Product\Compare::class);
$outputHelper = $this->helper(Magento\Catalog\Helper\Output::class);
$om = \Magento\Framework\App\ObjectManager::getInstance();
$mediaConfig = $om->get(\Magento\Catalog\Model\Product\Media\Config::class);

$itemsList = [];
$total = 0;

try {
    $items = $block->getItems();
    foreach ($items as $item) {
        $itemId = (int) $item->getId();
        if ($itemId > 0) {
            $itemsList[$itemId] = $item;
        }
    }
    $itemsList = array_values($itemsList);
    $total = count($itemsList);
} catch (\Throwable $exception) {
    $itemsList = [];
    $total = 0;
}

$tableRows = [];
$compareIds = array_map(static function ($product) {
    return (int) $product->getId();
}, $itemsList);

if (empty($compareIds)) {
    $idsParam = (string) $block->getRequest()->getParam('ids', '');
    if ($idsParam !== '') {
        $compareIds = array_values(array_unique(array_filter(array_map(static function ($part): int {
            return (int) trim((string) $part);
        }, explode(',', $idsParam)), static function (int $id): bool {
            return $id > 0;
        })));
        $compareIds = array_slice($compareIds, 0, 4);
    }
}

$compareAttributeProvider = $om->get(\TeknTek\CatalogTweaks\Model\Compare\AttributeProvider::class);
if (!empty($compareIds)) {
    $providerProducts = $compareAttributeProvider->loadProductsWithComparableAttributes($compareIds);
    if (!empty($providerProducts)) {
        $itemsList = $providerProducts;
        $total = count($itemsList);
    }
}

$total = count($itemsList);

$compareAttributes = $compareAttributeProvider->getComparableAttributesForProducts($itemsList);
$tableRows = $compareAttributeProvider->buildRows($itemsList, $compareAttributes);
if (empty($tableRows)) {
    $compareAttributes = $compareAttributeProvider->getDataBackedAttributesForProducts($itemsList);
    $tableRows = $compareAttributeProvider->buildRows($itemsList, $compareAttributes);
}
$descriptionRows = $compareAttributeProvider->buildDescriptionSpecRows($itemsList);
if (!empty($descriptionRows)) {
    $existingRowCodes = [];
    foreach ($tableRows as $row) {
        $existingRowCodes[(string) ($row['code'] ?? '')] = true;
    }
    foreach ($descriptionRows as $row) {
        $rowCode = (string) ($row['code'] ?? '');
        if ($rowCode !== '' && !isset($existingRowCodes[$rowCode])) {
            $tableRows[] = $row;
            $existingRowCodes[$rowCode] = true;
        }
    }
}

$compareLabelWidth = 220;
$compareProductWidth = 240;
$compareTableWidth = $compareLabelWidth + ($compareProductWidth * max(1, $total));

$getCompareProductImageUrl = static function ($product) use ($mediaConfig): string {
    $image = (string) $product->getImage();
    if ($image !== '' && $image !== 'no_selection') {
        return (string) $mediaConfig->getMediaUrl($image);
    }

    $smallImage = (string) $product->getSmallImage();
    if ($smallImage !== '' && $smallImage !== 'no_selection') {
        return (string) $mediaConfig->getMediaUrl($smallImage);
    }

    $thumbnail = (string) $product->getThumbnail();
    if ($thumbnail !== '' && $thumbnail !== 'no_selection') {
        return (string) $mediaConfig->getMediaUrl($thumbnail);
    }

    return '';
};
?>


<?php
/**
 * Custom product compare layout for OrangeTheme.
 *
 * @var $block \Magento\Catalog\Block\Product\Compare\ListCompare
 */

$items = $block->getItems();
$total = $items->getSize();
$compareHelper = $this->helper(Magento\Catalog\Helper\Product\Compare::class);
$outputHelper = $this->helper(Magento\Catalog\Helper\Output::class);
$imageHelper = $this->helper(Magento\Catalog\Helper\Image::class);
$allAttributes = [];
foreach ($block->getAttributes() as $attribute) {
    $allAttributes[] = $attribute;
}

$groupOrder = [
    'Performance' => 1,
    'Storage' => 2,
    'Display' => 3,
    'Connectivity' => 4,
    'Battery' => 5,
    'Dimensions' => 6,
    'System' => 7,
    'Other' => 8
];

$groupResolver = static function (string $code, string $label): string {
    $text = strtolower($code . ' ' . $label);
    if (preg_match('/processor|cpu|core|chipset|graphics|gpu|ram|memory/', $text)) {
        return 'Performance';
    }
    if (preg_match('/storage|ssd|hdd|hard[_ ]?drive|capacity|disk/', $text)) {
        return 'Storage';
    }
    if (preg_match('/display|screen|panel|resolution|brightness|webcam|refresh/', $text)) {
        return 'Display';
    }
    if (preg_match('/wireless|wifi|bluetooth|usb|port|hdmi|thunderbolt|network/', $text)) {
        return 'Connectivity';
    }
    if (preg_match('/battery|power/', $text)) {
        return 'Battery';
    }
    if (preg_match('/weight|dimension|size|height|width|depth/', $text)) {
        return 'Dimensions';
    }
    if (preg_match('/operating[_ ]?system|os|keyboard|audio|speaker/', $text)) {
        return 'System';
    }
    return 'Other';
};

$orderedCodes = [
    'processor',
    'cpu',
    'ram',
    'memory',
    'internal_memory',
    'hard_drive_size',
    'hard_drive_capacity',
    'storage',
    'graphics_card',
    'video_card',
    'operating_system',
    'display_type',
    'screen_size',
    'screen_diagonal',
    'battery_life',
    'maximum_battery_battery_life',
    'weight_item',
    'weight',
    'webcam_resolution',
    'wireless_connectivity',
    'bluetooth',
    'keyboard_layout'
];

$skipCodes = [
    'small_image',
    'thumbnail',
    'image',
    'media_gallery',
    'sku',
    'name',
    'price',
    'special_price',
    'description',
    'short_description',
    'meta_title',
    'meta_keyword',
    'meta_description',
    'url_key',
    'url_path',
    'has_options',
    'required_options',
    'created_at',
    'updated_at'
];

$attributesByCode = [];
foreach ($allAttributes as $attribute) {
    $attributesByCode[(string) $attribute->getAttributeCode()] = $attribute;
}

$priorityIndex = [];
foreach ($orderedCodes as $idx => $code) {
    $priorityIndex[$code] = $idx;
}

$selectedAttributes = [];
foreach ($allAttributes as $attribute) {
    $code = (string) $attribute->getAttributeCode();
    if (in_array($code, $skipCodes, true)) {
        continue;
    }
    if (!$block->hasAttributeValueForProducts($attribute)) {
        continue;
    }
    $label = (string) ($attribute->getStoreLabel() ?: $attribute->getFrontendLabel());
    if ($label === '') {
        continue;
    }
    $selectedAttributes[] = [
        'attribute' => $attribute,
        'code' => $code,
        'label' => $label,
        'group' => $groupResolver($code, $label),
        'priority' => $priorityIndex[$code] ?? 999
    ];
}

usort($selectedAttributes, static function (array $a, array $b) use ($groupOrder): int {
    $ga = $groupOrder[$a['group']] ?? 999;
    $gb = $groupOrder[$b['group']] ?? 999;
    if ($ga !== $gb) {
        return $ga <=> $gb;
    }
    if ($a['priority'] !== $b['priority']) {
        return $a['priority'] <=> $b['priority'];
    }
    return strcasecmp($a['label'], $b['label']);
});

if (count($selectedAttributes) > 120) {
    $selectedAttributes = array_slice($selectedAttributes, 0, 120);
}

if (empty($selectedAttributes)) {
    foreach ($allAttributes as $attribute) {
        $code = (string) $attribute->getAttributeCode();
        if (in_array($code, $skipCodes, true)) {
            continue;
        }
        if (!$block->hasAttributeValueForProducts($attribute)) {
            continue;
        }
        $fallbackLabel = trim((string) ($attribute->getStoreLabel() ?: $attribute->getFrontendLabel()));
        if ($fallbackLabel === '') {
            $fallbackLabel = ucwords(str_replace('_', ' ', $code));
        }
        $selectedAttributes[] = [
            'attribute' => $attribute,
            'code' => $code,
            'label' => $fallbackLabel,
            'group' => 'Other',
            'priority' => 999
        ];
        if (count($selectedAttributes) >= 120) {
            break;
        }
    }
}

$formatValue = static function ($value): string {
    $text = html_entity_decode((string) $value, ENT_QUOTES | ENT_HTML5, 'UTF-8');
    $text = trim(preg_replace('/\s+/', ' ', strip_tags($text)));
    if ($text === '') {
        return '-';
    }
    if (function_exists('mb_strlen') && mb_strlen($text) > 800) {
        return mb_substr($text, 0, 797) . '...';
    }
    if (strlen($text) > 800) {
        return substr($text, 0, 797) . '...';
    }
    return $text;
};

$itemsList = [];
foreach ($items as $item) {
    $itemsList[] = $item;
}

$tableRows = [];
$om = \Magento\Framework\App\ObjectManager::getInstance();
$productCollectionFactory = $om->get(\Magento\Catalog\Model\ResourceModel\Product\CollectionFactory::class);
$compareIds = array_map(static function ($product) {
    return (int) $product->getId();
}, $itemsList);

$fullProducts = [];
if (!empty($compareIds)) {
    $fullCollection = $productCollectionFactory->create();
    $fullCollection->addAttributeToSelect('*');
    $fullCollection->addFieldToFilter('entity_id', ['in' => $compareIds]);
    $fullCollection->load();
    foreach ($fullCollection as $fullProduct) {
        $fullProducts[(int) $fullProduct->getId()] = $fullProduct;
    }
}

// Same source model as PDP specification table.
$sharedSpecMap = [
    'Display' => ['display', 'display_size', 'screen_size', 'screen_diagonal', 'resolution', 'display_resolution'],
    'Processor' => ['processor', 'cpu', 'processor_type', 'chipset'],
    'Internal memory (RAM)' => ['ram', 'memory', 'internal_memory', 'ram_type'],
    'Hard drive capacity' => ['hard_drive_size', 'hard_drive_capacity', 'storage_capacity', 'storage', 'ssd_capacity'],
    'Video card' => ['graphics_card', 'video_card', 'graphics_processor', 'graphics_coprocessor'],
    'Operating system' => ['operating_system', 'os'],
    'Weight' => ['weight_item', 'weight'],
    'Battery life' => ['battery_life', 'maximum_battery_battery_life']
];

$firstNonEmpty = static function (array $source, array $codes): string {
    foreach ($codes as $code) {
        if (!array_key_exists($code, $source)) {
            continue;
        }
        $value = $source[$code];
        if (is_array($value)) {
            $value = implode(', ', array_map('strval', $value));
        } elseif (is_bool($value)) {
            $value = $value ? 'Yes' : 'No';
        } elseif (!is_scalar($value) && $value !== null) {
            $value = '';
        }
        $value = trim((string) $value);
        if ($value !== '') {
            return $value;
        }
    }
    return '';
};

$extractFromText = static function (string $label, string $text): string {
    $patternsByLabel = [
        'Display' => ['/\b\d{2}(\.\d)?\s?(inch|\"|in)\b/i', '/(1920\s?x\s?1080|1366\s?x\s?768|2k|4k)/i'],
        'Processor' => ['/(intel|amd)\s+[a-z0-9\- ]{2,30}/i', '/\bn\d{3,4}\b/i'],
        'Internal memory (RAM)' => ['/\b\d+\s?gb\s?(ram|memory)\b/i'],
        'Hard drive capacity' => ['/\b\d+\s?(gb|tb)\s?(ssd|hdd|storage)\b/i'],
        'Video card' => ['/(intel|amd|nvidia)\s+[a-z0-9\- ]{2,30}/i', '/\b(iris xe|radeon|geforce|rtx|gtx)\b/i'],
        'Operating system' => ['/windows\s?\d{1,2}(\s?(pro|home))?/i', '/\bchrome\s?os\b/i', '/\bmac\s?os\b/i'],
        'Weight' => ['/\b\d+(\.\d+)?\s?(kg|g)\b/i'],
        'Battery life' => ['/\b\d+\s?(hours|hour|hrs|hr)\b/i']
    ];

    $patterns = $patternsByLabel[$label] ?? [];
    foreach ($patterns as $pattern) {
        if (preg_match($pattern, $text, $m)) {
            return trim((string) $m[0]);
        }
    }
    return '';
};

foreach ($sharedSpecMap as $label => $codes) {
    $values = [];

    foreach ($itemsList as $item) {
        $pid = (int) $item->getId();
        $source = isset($fullProducts[$pid]) ? $fullProducts[$pid] : $item;
        $productData = (array) $source->getData();

        $raw = $firstNonEmpty($productData, $codes);
        if ($raw === '') {
            $textPool = strtolower(trim((string) $source->getName() . ' ' . (string) $source->getData('short_description') . ' ' . (string) $source->getData('description')));
            $raw = $extractFromText($label, $textPool);
        }

        $values[] = $formatValue($raw);
    }

    // Always keep PDP spec rows so compare table is never empty.
    $tableRows[] = [
        'label' => $label,
        'values' => $values
    ];
}
?>


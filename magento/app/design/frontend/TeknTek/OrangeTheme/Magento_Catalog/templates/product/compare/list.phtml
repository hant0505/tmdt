<div class="ttk-compare-wrap">
    <div class="ttk-compare-head" style="--ttk-count:<?= (int) $total ?>;">
        <div class="ttk-compare-head-spacer" aria-hidden="true"></div>
        <div class="ttk-compare-cards">
            <?php foreach ($itemsList as $item): ?>
                <?php
                $regular = (float) $item->getPrice();
                $final = (float) $item->getFinalPrice();
                $percent = 0;
                if ($regular > 0 && $final > 0 && $final < $regular) {
                    $percent = (int) round((($regular - $final) / $regular) * 100);
                }
                ?>
                <article class="ttk-compare-card"
                         data-product-id="<?= (int) $item->getId() ?>"
                         data-remove-url="<?= $block->escapeHtmlAttr($compareHelper->getPostDataRemove($item)) ?>">
                    <?php if ($percent > 0): ?>
                        <span class="ttk-compare-badge">-<?= (int) $percent ?>%</span>
                    <?php endif; ?>

                    <a class="ttk-compare-photo"
                       href="<?= $block->escapeUrl($block->getProductUrl($item)) ?>"
                       title="<?= $block->escapeHtmlAttr($block->stripTags((string) $item->getName(), null, true)) ?>">
                        <?php $compareImageUrl = $getCompareProductImageUrl($item); ?>
                        <?php if ($compareImageUrl !== ''): ?>
                            <img src="<?= $block->escapeUrl($compareImageUrl) ?>"
                                 alt="<?= $block->escapeHtmlAttr((string) $item->getName()) ?>" />
                        <?php endif; ?>
                    </a>

                    <p class="ttk-compare-name">
                        <a href="<?= $block->escapeUrl($block->getProductUrl($item)) ?>"
                           title="<?= $block->escapeHtmlAttr($block->stripTags((string) $item->getName(), null, true)) ?>">
                            <?= /* @noEscape */ $outputHelper->productAttribute($item, $item->getName(), 'name') ?>
                        </a>
                    </p>

                    <?= $block->getReviewsSummaryHtml($item, 'short') ?>

                    <div class="ttk-compare-price">
                        <?= /* @noEscape */ $block->getProductPrice($item, '-compare-card') ?>
                    </div>
                </article>
            <?php endforeach; ?>
        </div>
    </div>

    <div class="table-wrapper comparison">
        <table class="ttk-compare-table" id="product-comparison"
               data-mage-init='{"compareList":{"windowPrintSelector":".action.print"}}'>
            <tbody>
                <?php foreach ($tableRows as $row): ?>
                    <?php
                    $rowValues = $row['values'];
                    $normalized = array_map(static function (string $v): string {
                        return strtolower(trim($v));
                    }, $rowValues);
                    $isSame = count(array_unique($normalized)) <= 1;
                    ?>
                    <tr class="<?= $isSame ? 'ttk-row-same' : '' ?>">
                        <th scope="row"><?= $block->escapeHtml($row['label']) ?></th>
                        <?php foreach ($rowValues as $displayValue): ?>
                            <td>
                                <div class="ttk-compare-value"><?= $block->escapeHtml($displayValue) ?></div>
                            </td>
                        <?php endforeach; ?>
                    </tr>
                <?php endforeach; ?>

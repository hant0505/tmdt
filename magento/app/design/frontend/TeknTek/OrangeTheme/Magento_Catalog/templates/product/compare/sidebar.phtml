<?php
/**
 * Compare products sidebar.
 *
 * @var $block \Magento\Framework\View\Element\Template
 */
$objectManager = \Magento\Framework\App\ObjectManager::getInstance();
$compareHelper = $this->helper(\Magento\Catalog\Helper\Product\Compare::class);
$imageHelper = $objectManager->get(\Magento\Catalog\Helper\Image::class);
$priceCurrency = $objectManager->get(\Magento\Framework\Pricing\PriceCurrencyInterface::class);
$compareSeedItems = [];

try {
    foreach ($compareHelper->getItemCollection() as $product) {
        $productId = (int) $product->getId();
        if ($productId <= 0) {
            continue;
        }

        $imageUrl = (string) $imageHelper->init($product, 'wishlist_sidebar_block')->getUrl();

        $compareSeedItems[] = [
            'id' => $productId,
            'name' => (string) $product->getName(),
            'url' => (string) $product->getProductUrl(),
            'image' => $imageUrl,
            'price' => (string) $priceCurrency->format((float) $product->getFinalPrice(), false),
            'remove_url' => (string) $compareHelper->getPostDataRemove($product),
        ];
    }
} catch (\Throwable $exception) {
    $compareSeedItems = [];
}
?>
<?php
$compareCount = count($compareSeedItems);
$clearPostData = (string) $compareHelper->getPostDataClearList();

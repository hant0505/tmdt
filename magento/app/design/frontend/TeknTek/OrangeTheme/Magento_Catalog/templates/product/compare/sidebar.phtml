<script>
require(['jquery', 'Magento_Customer/js/customer-data'], function ($, customerData) {
    'use strict';

    var sidebar = $('[data-role="compare-products-sidebar"]');
    var itemsNode = sidebar.find('[data-role="compare-items"]');
    var countNode = sidebar.find('[data-role="compare-count"]');
    var viewAll = sidebar.find('[data-role="compare-view-all"]');
    var seedItems = <?= /* @noEscape */ json_encode($compareSeedItems, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) ?>;
    var compareUrl = '<?= $block->escapeJs($block->getUrl('catalog/product_compare/index')) ?>';

    function escapeHtml(value) {
        return String(value || '').replace(/[&<>"']/g, function (match) {
            return {
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#039;'
            }[match];
        });
    }

    function imageUrl(item) {
        if (!item) {
            return '';
        }
        if (typeof item.image === 'string') {
            return item.image;
        }
        if (item.image && typeof item.image === 'object') {
            return item.image.src || item.image.url || item.image.image || '';
        }
        return item.product_image || item.thumbnail || item.small_image || item.src || '';
    }

    function normalize(item) {
        var id = Number(item.id || item.product_id || item.item_id);
        return {
            id: id,
            name: item.name || item.product_name || item.product_sku || (item.image && item.image.alt) || 'Product',
            url: item.product_url || item.url || item.productUrl || '#',
            image: imageUrl(item),
            price: item.price || item.product_price || item.final_price || '',
            remove_url: item.remove_url || item.delete_item_params || ''
        };
    }

    function mergeSeed(items) {
        var seedById = {};
        seedItems.forEach(function (item) {
            seedById[Number(item.id)] = item;
        });

        return items.map(function (item) {
            var seed = seedById[Number(item.id)];
            if (!seed) {
                return item;
            }
            item.image = item.image || seed.image || '';
            item.price = item.price || seed.price || '';
            item.url = item.url && item.url !== '#' ? item.url : seed.url;
            item.remove_url = item.remove_url || seed.remove_url || '';
            return item;
        });
    }

    function readItems() {
        var section = customerData.get('compare-products')() || {};
        var rawItems = Array.isArray(section.items) ? section.items : [];

        if (!rawItems.length && section.items && typeof section.items === 'object') {
            rawItems = Object.keys(section.items).map(function (key) {
                return section.items[key];
            });
        }

        rawItems = rawItems.map(normalize).filter(function (item) {
            return item.id > 0;
        });

        return mergeSeed(rawItems.length ? rawItems : seedItems.map(normalize)).slice(0, 4);
    }

    function countCaption(count) {
        return count === 1 ? '1 item' : count + ' items';
    }

    function listUrl(items) {
        var ids = items.map(function (item) {
            return Number(item.id);
        }).filter(function (id) {
            return id > 0;
        });

        if (!ids.length) {
            return compareUrl;
        }

        return compareUrl + (compareUrl.indexOf('?') === -1 ? '?' : '&') + 'ids=' + encodeURIComponent(ids.join(','));
    }

    function render(items) {
        var count = items.length;
        sidebar.toggleClass('ttk-has-items', count > 0).toggleClass('ttk-is-empty', count === 0);
        countNode.toggleClass('no-display', count === 0).text(count ? countCaption(count) : '');
        viewAll.attr('href', listUrl(items));

        itemsNode.html(items.map(function (item) {
            var image = item.image ?
                '<img src="' + escapeHtml(item.image) + '" alt="' + escapeHtml(item.name) + '" loading="lazy"/>' :
                '';

            return '<li class="product-item ttk-compare-row flex items-center gap-3 py-2 border-b border-gray-50 last:border-0" data-id="' + Number(item.id) + '">' +
                '<input type="hidden" class="compare-item-id" value="' + Number(item.id) + '"/>' +
                '<a class="ttk-sidebar-thumb" href="' + escapeHtml(item.url) + '" title="' + escapeHtml(item.name) + '">' + image + '</a>' +
                '<div class="ttk-sidebar-product-copy flex-1 min-w-0">' +
                    '<strong class="product-item-name truncate">' +
                        '<a class="product-item-link" href="' + escapeHtml(item.url) + '">' + escapeHtml(item.name) + '</a>' +
                    '</strong>' +
                    '<span class="ttk-sidebar-price">' + escapeHtml(item.price) + '</span>' +
                '</div>' +
                '<a href="#" class="action delete ttk-sidebar-remove flex-shrink-0" data-role="compare-remove" data-post="' + escapeHtml(item.remove_url) + '">' +
                    '<span><?= $block->escapeJs(__('Remove This Item')) ?></span>' +
                '</a>' +
            '</li>';
        }).join(''));
    }

    function postData(raw) {
        if (!raw) {
            return $.Deferred().resolve().promise();
        }

        try {
            raw = JSON.parse(raw);
        } catch (error) {
            return $.Deferred().resolve().promise();
        }

        return $.ajax({
            url: raw.action,
            type: 'POST',
            data: raw.data || {}
        });
    }

    function reload() {
        customerData.invalidate(['compare-products']);
        return customerData.reload(['compare-products'], true).always(function () {
            render(readItems());
        });
    }

    sidebar.on('click', '[data-role="compare-remove"]', function (event) {
        event.preventDefault();
        postData($(this).attr('data-post')).always(reload);
    });

    sidebar.on('click', '[data-role="compare-clear"]', function (event) {
        event.preventDefault();
        postData($(this).attr('data-post')).always(function () {
            render([]);
            reload();
        });
    });

    reload();
    render(readItems());
    customerData.get('compare-products').subscribe(function () {
        render(readItems());
    });
});
</script>
<?php return; ?>

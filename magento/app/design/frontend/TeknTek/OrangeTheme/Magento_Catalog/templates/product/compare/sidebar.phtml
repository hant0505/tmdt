<script>
require(['jquery', 'Magento_Customer/js/customer-data'], function ($, customerData) {
    'use strict';

    var storageKey = 'tekntek_compare_v2';
    var sidebar = $('[data-role="compare-products-sidebar"]');
    var fallback = sidebar.find('[data-role="tekntek-compare-fallback"]');
    var fallbackItems = sidebar.find('[data-role="tekntek-compare-fallback-items"]');
    var fallbackLink = sidebar.find('[data-role="tekntek-compare-fallback-link"]');
    var fallbackClear = sidebar.find('[data-role="tekntek-compare-fallback-clear"]');
    var emptyState = sidebar.find('.ttk-sidebar-empty');
    var compareBaseUrl = '<?= $block->escapeJs($block->getUrl('catalog/product_compare/index')) ?>';
    var uiVersionKey = 'tekntek_compare_sidebar_ui_version';
    var uiVersion = '20260430-compare-sidebar-image-v21';
    var seedItems = <?= /* @noEscape */ json_encode($compareSeedItems, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) ?>;

    function escapeHtml(value) {
        return String(value || '').replace(/[&<>"']/g, function (match) {
            return {
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#039;'
            }[match];
        });
    }

    function readLocalCompare() {
        try {
            var items = JSON.parse(window.localStorage.getItem(storageKey) || '[]');
            if (!Array.isArray(items)) {
                return [];
            }

            return items.map(function (item) {
                if (!item || typeof item !== 'object') {
                    return item;
                }

                item.image = resolveImage(item);
                return item;
            }).filter(function (item) {
                return item && Number(item.id) > 0;
            }).slice(0, 4);
        } catch (error) {
            return [];
        }
    }

    function readSeedCompare() {
        if (!Array.isArray(seedItems)) {
            return [];
        }

        return seedItems.filter(function (item) {
            return item && Number(item.id) > 0;
        }).slice(0, 4);
    }

    function mergeSeedData(items, seedCompareItems) {
        var seedById = {};

        seedCompareItems.forEach(function (item) {
            seedById[Number(item.id)] = item;
        });

        return items.map(function (item) {
            var seed = seedById[Number(item.id)];
            if (!seed) {
                return item;
            }

            if (isPlaceholderImage(resolveImage(item)) && !isPlaceholderImage(resolveImage(seed))) {
                item.image = resolveImage(seed);
            }

            if ((!item.price || item.price === '-') && seed.price) {
                item.price = seed.price;
            }

            if ((!item.url || item.url === '#') && seed.url) {
                item.url = seed.url;
            }

            if ((!item.remove_url || item.remove_url === '#') && seed.remove_url) {
                item.remove_url = seed.remove_url;
            }

            return item;
        });
    }

    function readRenderedFallbackItems() {
        return fallbackItems.find('.product-item').map(function () {
            var row = $(this);
            var thumb = row.find('.ttk-sidebar-thumb').first();
            var image = thumb.find('img').first();
            var link = row.find('.product-item-link').first();
            var remove = row.find('[data-role="tekntek-compare-remove"]').first();
            var id = Number(row.find('.compare-item-id').first().val() || remove.attr('data-id'));
            var name = $.trim(link.text()) ||
                thumb.attr('title') ||
                image.attr('alt') ||
                'Product';

            return {
                id: id,
                name: name,
                url: link.attr('href') || thumb.attr('href') || '#',
                image: image.attr('src') || '',
                price: $.trim(row.find('.ttk-sidebar-price').first().text()),
                remove_url: remove.attr('data-remove-url') || ''
            };
        }).get().filter(function (item) {
            return item && Number(item.id) > 0;
        }).slice(0, 4);
    }

    function resolveImage(item) {
        if (!item || typeof item !== 'object') {
            return '';
        }

        if (typeof item.image === 'string') {
            return item.image;
        }

        if (item.image && typeof item.image === 'object') {
            return item.image.src || item.image.url || item.image.image || '';
        }

        if (item.thumbnail && typeof item.thumbnail === 'object') {
            return item.thumbnail.src || item.thumbnail.url || '';
        }

        return item.product_image || item.thumbnail || item.small_image || item.src || '';
    }

    function isPlaceholderImage(src) {
        src = String(src || '').toLowerCase();
        return !src ||
            src.indexOf('placeholder') !== -1 ||
            src.indexOf('/catalog/product/placeholder/') !== -1 ||
            src.indexOf('/default/placeholder/') !== -1;
    }

    function parseProductPageImage(html) {
        var doc = $.parseHTML(html, document, true);
        var image = $(doc).find('#tekntek-gallery-main').first().attr('src') ||
            $(doc).find('.tekntek-gallery-thumb img').first().attr('src') ||
            $(doc).find('meta[property="og:image"]').attr('content') ||
            '';

        return image;
    }

    function fetchProductImage(item) {
        var url = item.product_url || item.url || item.productUrl || '';
        if (!url || url === '#') {
            return $.Deferred().resolve('').promise();
        }

        return $.ajax({
            url: url,
            type: 'GET',
            cache: false
        }).then(parseProductPageImage, function () {
            return '';
        });
    }

    function mergeComparePageImages(items, pageItems) {
        var pageById = {};

        pageItems.forEach(function (item) {
            pageById[Number(item.id)] = item;
        });

        return items.map(function (item) {
            var pageItem = pageById[Number(item.id)];
            if (!pageItem) {
                return item;
            }

            if (isPlaceholderImage(resolveImage(item)) && !isPlaceholderImage(resolveImage(pageItem))) {
                item.image = resolveImage(pageItem);
            }

            if ((!item.price || item.price === '-') && pageItem.price) {
                item.price = pageItem.price;
            }

            if ((!item.url || item.url === '#') && pageItem.url) {
                item.url = pageItem.url;
            }

            if ((!item.remove_url || item.remove_url === '#') && pageItem.remove_url) {
                item.remove_url = pageItem.remove_url;
            }

            return item;
        });
    }

    function fetchComparePageItemsFor(items) {
        return $.ajax({
            url: compareUrl(items),
            type: 'GET',
            cache: false
        }).then(parseComparePageItems, function () {
            return [];
        });
    }

    function backfillMissingImages(items) {
        var missing = items.filter(function (item) {
            return item &&
                Number(item.id) > 0 &&
                isPlaceholderImage(resolveImage(item)) &&
                Number(item.__imageBackfillAttempts || 0) < 2;
        });

        if (!missing.length || backfillMissingImages.isRunning) {
            return;
        }

        backfillMissingImages.isRunning = true;
        $.when.apply($, missing.map(function (item) {
            return fetchProductImage(item).then(function (image) {
                item.__imageBackfillAttempts = Number(item.__imageBackfillAttempts || 0) + 1;
                if (image && !isPlaceholderImage(image)) {
                    item.image = image;
                    item.__imageBackfilled = true;
                }
                return item;
            });
        })).always(function () {
            backfillMissingImages.isRunning = false;
            if (items.some(function (item) {
                return isPlaceholderImage(resolveImage(item));
            }) && !backfillMissingImages.isFetchingComparePage) {
                backfillMissingImages.isFetchingComparePage = true;
                fetchComparePageItemsFor(items).done(function (pageItems) {
                    if (pageItems.length) {
                        items = mergeComparePageImages(items, pageItems);
                    }
                    saveItems(items);
                    renderItems(items, true);
                }).always(function () {
                    backfillMissingImages.isFetchingComparePage = false;
                });
                return;
            }

            saveItems(items);
            renderItems(items, true);
        });
    }

    function readMagentoCompareItems() {
        var section = customerData.get('compare-products')() || {};
        var rawItems = Array.isArray(section.items) ? section.items : [];

        if (!rawItems.length && section.items && typeof section.items === 'object') {
            rawItems = Object.keys(section.items).map(function (key) {
                return section.items[key];
            });
        }

        return rawItems.map(function (item) {
            var id = Number(item.id || item.product_id || item.item_id);
            return {
                id: id,
                name: item.name || item.product_name || item.product_sku || (item.image && item.image.alt) || 'Product',
                url: item.product_url || item.url || item.productUrl || '#',
                image: resolveImage(item),
                price: item.price || item.product_price || item.final_price || '',
                remove_url: item.remove_url || ''
            };
        }).filter(function (item) {
            return item.id > 0;
        }).slice(0, 4);
    }

    function nativeContent() {
        return sidebar.children('.block-content').not(fallback);
    }

    function magentoCompareVisible() {
        var section = customerData.get('compare-products')() || {};
        var content = nativeContent();
        return Number(section.count || 0) > 0 || content.find('.product-item').length > 0;
    }

    function setSidebarState(state) {
        sidebar.removeClass('ttk-has-native-compare ttk-has-local-compare ttk-is-empty');
        sidebar.addClass(state);
        emptyState.prop('hidden', state !== 'ttk-is-empty');
    }

    function reloadCompareSection() {
        customerData.invalidate(['compare-products']);
        customerData.reload(['compare-products'], true).done(function () {
            window.setTimeout(renderFallback, 80);
        });
    }

    function postDataPost($link) {
        var raw = $link.attr('data-post');
        if (!raw) {
            return $.Deferred().reject().promise();
        }

        try {
            var payload = JSON.parse(raw);
            return $.ajax({
                url: payload.action,
                type: 'POST',
                data: payload.data || {}
            });
        } catch (error) {
            return $.Deferred().reject().promise();
        }
    }

    function magentoCompareHasItems() {
        var section = customerData.get('compare-products')() || {};
        var content = sidebar.children('.block-content').not(fallback);
        return Number(section.count || 0) > 0 || content.find('.product-item').length > 0;
    }

    function compareUrl(items) {
        var ids = items.map(function (item) {
            return Number(item.id);
        }).filter(function (id) {
            return id > 0;
        });

        if (!ids.length) {
            return compareBaseUrl;
        }

        return compareBaseUrl + (compareBaseUrl.indexOf('?') === -1 ? '?' : '&') + 'ids=' + encodeURIComponent(ids.join(','));
    }

    function saveItems(items) {
        window.localStorage.setItem(storageKey, JSON.stringify(items));
    }

    function renderItems(items, skipImageBackfill) {
        setSidebarState('ttk-has-local-compare');
        nativeContent().hide().addClass('no-display');
        fallbackItems.html(items.map(function (item) {
            var url = item.product_url || item.url || item.productUrl || '#';
            var name = item.product_name || item.name || item.product_sku || item.sku || 'Product';
            var imageSrc = resolveImage(item);
            var image = imageSrc
                ? '<img src="' + escapeHtml(imageSrc) + '" alt="' + escapeHtml(name) + '" loading="lazy"/>'
                : '';
            var price = item.product_price || item.price || item.final_price || '';
            price = price ? escapeHtml(price) : '';

            return '<li class="product-item flex items-center gap-3 py-2 border-b border-gray-50 last:border-0">' +
                '<input type="hidden" class="compare-item-id" value="' + Number(item.id) + '"/>' +
                '<a class="ttk-sidebar-thumb" href="' + escapeHtml(url) + '" title="' + escapeHtml(name) + '">' + image + '</a>' +
                '<div class="ttk-sidebar-product-copy flex-1 min-w-0">' +
                    '<strong class="product-item-name truncate">' +
                        '<a class="product-item-link" href="' + escapeHtml(url) + '">' + escapeHtml(name) + '</a>' +
                    '</strong>' +
                    '<span class="ttk-sidebar-price">' + price + '</span>' +
                '</div>' +
                '<a href="#" class="action delete ttk-sidebar-remove flex-shrink-0" data-role="tekntek-compare-remove" data-id="' + Number(item.id) + '" data-remove-url="' + escapeHtml(item.remove_url || '') + '">' +
                    '<span><?= $block->escapeJs(__('Remove')) ?></span>' +
                '</a>' +
            '</li>';
        }).join(''));

        fallbackLink.attr('href', compareUrl(items));
        emptyState.hide().prop('hidden', true);
        fallback.show();

        if (!skipImageBackfill) {
            backfillMissingImages(items);
        }
    }

    function parseComparePageItems(html) {
        var doc = $.parseHTML(html, document, true);
        var items = [];

        $(doc).find('.ttk-compare-card').each(function () {
            var card = $(this);
            var photo = card.find('.ttk-compare-photo').first();
            var image = photo.find('img').first();
            var id = Number(card.attr('data-product-id'));
            var name = $.trim(card.find('.ttk-compare-name a').first().text()) ||
                photo.attr('title') ||
                image.attr('alt') ||
                'Product';

            if (id <= 0 && photo.attr('href')) {
                id = items.length + 1;
            }

            items.push({
                id: id,
                name: name,
                url: photo.attr('href') || card.find('.ttk-compare-name a').first().attr('href') || '#',
                image: image.attr('src') || '',
                price: $.trim(card.find('.ttk-compare-price').first().text()),
                remove_url: card.attr('data-remove-url') || ''
            });
        });

        return items.filter(function (item) {
            return item && Number(item.id) > 0;
        }).slice(0, 4);
    }

    function fetchComparePageItems() {
        return $.ajax({
            url: compareBaseUrl,
            type: 'GET',
            cache: false
        }).then(parseComparePageItems, function () {
            return [];
        });
    }

    function showLoadingState() {
        setSidebarState('ttk-has-local-compare');
        nativeContent().hide().addClass('no-display');
        emptyState.hide().prop('hidden', true);
        fallbackItems.html(
            '<li class="product-item">' +
                '<span class="ttk-sidebar-thumb"></span>' +
                '<div class="ttk-sidebar-product-copy">' +
                    '<strong class="product-item-name">Loading compare products...</strong>' +
                '</div>' +
            '</li>'
        );
        fallback.show();
    }

    function renderFallback() {
        var section = customerData.get('compare-products')() || {};
        var magentoItems = readMagentoCompareItems();
        var localItems = readLocalCompare();
        var seedCompareItems = readSeedCompare();
        var renderedFallbackItems = readRenderedFallbackItems();
        var items = magentoItems.length ?
            magentoItems :
            (seedCompareItems.length ? seedCompareItems : (localItems.length ? localItems : renderedFallbackItems));
        items = mergeSeedData(items, seedCompareItems);
        var magentoCount = Number(section.count || 0);
        var existingFallbackItems = fallbackItems.find('.product-item').length;

        if (items.length) {
            if (items.some(function (item) {
                return isPlaceholderImage(resolveImage(item));
            }) && !renderFallback.isFetchingComparePageForImages) {
                showLoadingState();
                renderFallback.isFetchingComparePageForImages = true;
                fetchComparePageItemsFor(items).done(function (pageItems) {
                    if (pageItems.length) {
                        items = mergeComparePageImages(items, pageItems);
                    }
                    saveItems(items);
                    renderItems(items, true);
                }).always(function () {
                    renderFallback.isFetchingComparePageForImages = false;
                });
                return;
            }

            renderItems(items);
            return;
        }

        if (existingFallbackItems > 0) {
            setSidebarState('ttk-has-local-compare');
            nativeContent().hide().addClass('no-display');
            emptyState.hide().prop('hidden', true);
            fallback.show();
            if (renderedFallbackItems.length) {
                backfillMissingImages(renderedFallbackItems);
            }
            return;
        }

        if (magentoCount > 0) {
            showLoadingState();
            if (!renderFallback.isFetchingComparePage) {
                renderFallback.isFetchingComparePage = true;
                fetchComparePageItems().done(function (pageItems) {
                    renderFallback.isFetchingComparePage = false;
                    if (pageItems.length) {
                        saveItems(pageItems);
                        renderItems(pageItems);
                        return;
                    }

                    if (!renderFallback.hasRetriedCustomerData) {
                        renderFallback.hasRetriedCustomerData = true;
                        customerData.invalidate(['compare-products']);
                        customerData.reload(['compare-products'], true).done(function () {
                            window.setTimeout(renderFallback, 80);
                        });
                    }
                });
            }
            return;
        }

        setSidebarState('ttk-is-empty');
        nativeContent().hide().addClass('no-display');
        fallback.hide();
        emptyState.show().prop('hidden', false);
    }

    fallbackItems.on('click', '[data-role="tekntek-compare-remove"]', function (event) {
        event.preventDefault();
        var $link = $(this);
        var id = Number($link.attr('data-id'));
        var items = readLocalCompare().filter(function (item) {
            return Number(item.id) !== id;
        });
        saveItems(items);
        var removePayload = $link.attr('data-remove-url');
        if (removePayload) {
            postDataPost($link.attr('data-post', removePayload)).always(function () {
                reloadCompareSection();
                renderFallback();
            });
            return;
        }

        renderFallback();
    });

    sidebar.on('click', '.block-content:not([data-role="tekntek-compare-fallback"]) .ttk-sidebar-remove', function (event) {
        var $link = $(this);
        event.preventDefault();

        postDataPost($link).always(function () {
            var id = Number($link.closest('.product-item').find('.compare-item-id').val());
            if (id > 0) {
                saveItems(readLocalCompare().filter(function (item) {
                    return Number(item.id) !== id;
                }));
            }
            $link.closest('.product-item').remove();
            if (!magentoCompareHasItems()) {
                nativeContent().hide().addClass('no-display');
            }
            reloadCompareSection();
            renderFallback();
        });
    });

    fallbackClear.on('click', function (event) {
        event.preventDefault();
        saveItems([]);
        nativeContent().hide().addClass('no-display').find('.product-item').remove();
        fallbackItems.empty();
        fallback.hide();
        emptyState.show();
        renderFallback();
    });

    sidebar.on('click', '#compare-clear-all', function (event) {
        var $link = $(this);
        event.preventDefault();
        saveItems([]);
        postDataPost($link).always(function () {
            nativeContent().hide().addClass('no-display').find('.product-item').remove();
            reloadCompareSection();
            renderFallback();
        });
        fallback.hide();
        emptyState.hide();
    });

    function clearStaleMagentoPrivateContentOnce() {
        try {
            if (window.localStorage.getItem(uiVersionKey) === uiVersion) {
                return;
            }

            window.localStorage.removeItem('mage-cache-storage');
            window.localStorage.removeItem('mage-cache-storage-section-invalidation');
            window.localStorage.removeItem('mage-cache-timeout');
            window.localStorage.setItem(uiVersionKey, uiVersion);
        } catch (error) {
            // Private browsing/storage failures should not block rendering.
        }
    }

    clearStaleMagentoPrivateContentOnce();
    reloadCompareSection();
    renderFallback();
    window.setTimeout(renderFallback, 100);
    window.setTimeout(renderFallback, 500);
    window.setTimeout(renderFallback, 1500);
    window.setTimeout(renderFallback, 3000);
    customerData.get('compare-products').subscribe(function () {
        window.setTimeout(renderFallback, 80);
    });
    window.addEventListener('storage', function (event) {
        if (event.key === storageKey) {
            renderFallback();
        }
    });
});
</script>

<?php
/**
 * Product list toolbar amount.
 *
 * @var \Magento\Catalog\Block\Product\ProductList\Toolbar $block
 * @var \Magento\Framework\Locale\LocaleFormatter $localeFormatter
 */

$totalNum = (int) $block->getTotalNum();
$currentPage = max(1, (int) $block->getCurrentPage());
$limit = max(1, (int) $block->getLimit());
$firstNum = $totalNum > 0 ? (($currentPage - 1) * $limit) + 1 : 0;
$lastNum = $totalNum > 0 ? min($totalNum, $currentPage * $limit) : 0;
?>
<p class="toolbar-amount" id="toolbar-amount">
    <?php if ($totalNum > 1): ?>
        <?= $block->escapeHtml(
            __(
                'Items %1-%2 of %3',
                '<span class="toolbar-number">' . $localeFormatter->formatNumber($firstNum) . '</span>',
                '<span class="toolbar-number">' . $localeFormatter->formatNumber($lastNum) . '</span>',
                '<span class="toolbar-number">' . $localeFormatter->formatNumber($totalNum) . '</span>'
            ),
            ['span']
        ) ?>
    <?php elseif ($totalNum === 1): ?>
        <?= $block->escapeHtml(
            __(
                '%1 Item',
                '<span class="toolbar-number">' . $localeFormatter->formatNumber($totalNum) . '</span>'
            ),
            ['span']
        ) ?>
    <?php else: ?>
        <?= $block->escapeHtml(__('0 Items')) ?>
    <?php endif; ?>
</p>

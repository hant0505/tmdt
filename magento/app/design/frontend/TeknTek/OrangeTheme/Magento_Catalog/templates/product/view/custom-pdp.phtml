$registerGalleryItem = static function (string $url, string $label, string $file = '') use (&$galleryItems, &$gallerySeenFiles, &$gallerySeenUrls): void {
    $normalizedUrl = trim($url);
    if ($normalizedUrl === '') {
        return;
    }

    $normalizedFile = trim($file);
    if ($normalizedFile !== '' && in_array($normalizedFile, $gallerySeenFiles, true)) {
        return;
    }
    if (in_array($normalizedUrl, $gallerySeenUrls, true)) {
        return;
    }

    $galleryItems[] = [
        'url' => $normalizedUrl,
        'label' => $label !== '' ? $label : 'Product image'
    ];
    $gallerySeenUrls[] = $normalizedUrl;
    if ($normalizedFile !== '') {
        $gallerySeenFiles[] = $normalizedFile;
    }
};

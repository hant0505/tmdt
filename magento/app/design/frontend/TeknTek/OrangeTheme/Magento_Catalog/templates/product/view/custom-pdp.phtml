$repairTextEncoding = static function (string $text): string {
    if ($text === '') {
        return '';
    }

    $text = strtr($text, [
        'â€™' => '’',
        'â€˜' => '‘',
        'â€œ' => '“',
        'â€' => '”',
        'â€“' => '–',
        'â€”' => '—',
        'â€¦' => '…',
        'Â ' => ' ',
        'Â' => '',
    ]);

    return trim(preg_replace('/\s+/', ' ', $text) ?? $text);
};


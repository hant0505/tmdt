    $accessoryData = [
        ['id' => 9101, 'name' => 'Wireless Mouse', 'url' => '#', 'image' => $placeholder, 'config' => '2.4G, silent click', 'price' => 19.99, 'tag' => '15%'],
        ['id' => 9102, 'name' => 'Laptop Sleeve 15.6"', 'url' => '#', 'image' => $placeholder, 'config' => 'Water-resistant, padded', 'price' => 24.99, 'tag' => '15%'],
        ['id' => 9103, 'name' => 'USB-C Hub 7-in-1', 'url' => '#', 'image' => $placeholder, 'config' => 'HDMI + USB 3.0 + PD', 'price' => 29.99, 'tag' => '15%'],
        ['id' => 9104, 'name' => 'Cooling Pad', 'url' => '#', 'image' => $placeholder, 'config' => 'Dual fan, adjustable angle', 'price' => 34.99, 'tag' => '15%']
    ];
}

$reviewData = [];
$resource = $om->get(\Magento\Framework\App\ResourceConnection::class);
$connection = $resource->getConnection();
$reviewCollectionFactory = $om->get(\Magento\Review\Model\ResourceModel\Review\Product\CollectionFactory::class);
$reviewCollection = $reviewCollectionFactory->create()
    ->addEntityFilter((int) $product->getId())
    ->setDateOrder('DESC')
    ->setPageSize(12)
    ->setCurPage(1);
$reviewCollection->load();

$reviewIds = [];
foreach ($reviewCollection as $reviewItem) {
    $reviewId = (int) ($reviewItem->getReviewId() ?: $reviewItem->getId());
    if ($reviewId > 0) {
        $reviewIds[] = $reviewId;
    }
}

$ratingPercentByReview = [];
$helpfulByReview = [];
$notHelpfulByReview = [];
$customerVoteByReview = [];
$reviewOwnerByReview = [];
if ($reviewIds) {
    $select = $connection->select()
        ->from($resource->getTableName('rating_option_vote'), [
            'review_id',
            'percent' => new \Zend_Db_Expr('ROUND(AVG(percent))')
        ])
        ->where('review_id IN (?)', $reviewIds)
        ->group('review_id');

    foreach ($connection->fetchAll($select) as $ratingRow) {
        $ratingPercentByReview[(int) $ratingRow['review_id']] = (int) $ratingRow['percent'];
    }

    $ownerSelect = $connection->select()
        ->from($resource->getTableName('review_detail'), ['review_id', 'customer_id'])
        ->where('review_id IN (?)', $reviewIds);

    foreach ($connection->fetchAll($ownerSelect) as $ownerRow) {
        $reviewOwnerByReview[(int) $ownerRow['review_id']] = (int) $ownerRow['customer_id'];
    }

    $helpfulnessTable = $resource->getTableName('tekntek_review_helpfulness');
    if ($connection->isTableExists($helpfulnessTable)) {
        $voteSelect = $connection->select()
            ->from($helpfulnessTable, [
                'review_id',
                'helpful_count' => new \Zend_Db_Expr('SUM(CASE WHEN vote_type = 1 THEN 1 ELSE 0 END)'),
                'not_helpful_count' => new \Zend_Db_Expr('SUM(CASE WHEN vote_type = -1 THEN 1 ELSE 0 END)')
            ])
            ->where('review_id IN (?)', $reviewIds)
            ->group('review_id');

        foreach ($connection->fetchAll($voteSelect) as $voteRow) {
            $reviewId = (int) $voteRow['review_id'];
            $helpfulByReview[$reviewId] = (int) $voteRow['helpful_count'];
            $notHelpfulByReview[$reviewId] = (int) $voteRow['not_helpful_count'];
        }

        if ($currentCustomerId > 0) {
            $customerVoteSelect = $connection->select()
                ->from($helpfulnessTable, ['review_id', 'vote_type'])
                ->where('review_id IN (?)', $reviewIds)
                ->where('customer_id = ?', $currentCustomerId);

            foreach ($connection->fetchAll($customerVoteSelect) as $voteRow) {
                $customerVoteByReview[(int) $voteRow['review_id']] = (int) $voteRow['vote_type'] === 1 ? 'up' : 'down';
            }
        }
    }
}

foreach ($reviewCollection as $reviewItem) {
    $reviewId = (int) ($reviewItem->getReviewId() ?: $reviewItem->getId());
    $ratingPercent = $ratingPercentByReview[$reviewId] ?? 0;
    $stars = $ratingPercent > 0 ? max(1, min(5, (int) round($ratingPercent / 20))) : 0;

    $reviewData[] = [
        'stars' => $stars,
        'date' => date('d/m/Y', strtotime((string) $reviewItem->getReviewCreatedAt())),
        'user' => (string) ($reviewItem->getNickname() ?: __('Customer')),
        'title' => (string) $reviewItem->getTitle(),
        'content' => (string) $reviewItem->getDetail(),
        'pros' => [],
        'cons' => [],
        'id' => $reviewId,
        'up' => $helpfulByReview[$reviewId] ?? 0,
        'down' => $notHelpfulByReview[$reviewId] ?? 0,
        'user_vote' => $customerVoteByReview[$reviewId] ?? '',
        'can_delete' => $currentCustomerId > 0 && ($reviewOwnerByReview[$reviewId] ?? 0) === $currentCustomerId
    ];
}

if (!empty($reviewData)) {
    $ratingCount = count($reviewData);
    $ratingTotal = 0;
    $ratedCount = 0;
    foreach ($reviewData as $reviewItem) {
        $reviewStars = max(0, min(5, (int) ($reviewItem['stars'] ?? 0)));
        if ($reviewStars > 0) {
            $ratingTotal += $reviewStars;
            $ratedCount++;
        }
    }
    $ratingValue = $ratedCount > 0 ? (int) round($ratingTotal / $ratedCount) : 0;
}

$compareSeed = [];
$mainCompareItem = [
    'id' => (int) $product->getId(),
    'name' => $name,
    'image' => (string) $imageHelper->init($product, 'product_small_image')->getUrl(),
    'price' => $final > 0 ? $final : $regular,
    'url' => (string) $product->getProductUrl(),
    'category_ids' => array_values(array_map('intval', (array) $product->getCategoryIds()))
];

        'Graphics',
        'Operating system',
        'Battery life',
        'Connectivity',
        'Wireless',
        'Bluetooth',
        'Special features',
        'Compatible devices',
        'DPI',
        'Hand orientation',
        'Sensor',
        'Buttons',
        'Warranty',
    ];

    return in_array($label, $allowed, true);
};


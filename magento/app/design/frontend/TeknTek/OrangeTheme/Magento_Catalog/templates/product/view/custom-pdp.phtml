$featureBullets = [];
$descriptionHtml = '';
$isMeaningfulDescription = static function (string $html): bool {
    $text = trim(strip_tags($html));
    $text = preg_replace('/\s+/u', ' ', $text) ?? $text;
    $normalized = mb_strtolower($text, 'UTF-8');

    if ($normalized === '') {
        return false;
    }

    // Heading-only leftovers should not be used as final description content.
    $headingOnlyPatterns = [
        '/^đặc điểm(?: nổi bật)?$/u',
        '/^features?$/u',
        '/^thông số(?: kỹ thuật)?$/u',
        '/^specifications?$/u',
    ];

    foreach ($headingOnlyPatterns as $pattern) {
        if (preg_match($pattern, $normalized)) {
            return false;
        }
    }

    return true;
};

if ($rawDescriptionHtml !== '') {
    $normalizedDescriptionHtml = preg_replace('/<br\s*\/?>/i', "\n", $rawDescriptionHtml) ?? $rawDescriptionHtml;

    if (preg_match('/<ul\b[^>]*>(.*?)<\/ul>/is', $normalizedDescriptionHtml, $featureMatch)) {
        if (preg_match_all('/<li\b[^>]*>(.*?)<\/li>/is', $featureMatch[1], $featureItems)) {
            foreach ($featureItems[1] as $itemHtml) {
                $bullet = trim(html_entity_decode(strip_tags($itemHtml), ENT_QUOTES | ENT_HTML5, 'UTF-8'));
                if ($bullet !== '') {
                    $featureBullets[] = $bullet;
                }
            }
        }
    }

    if (preg_match_all('/<tr\b[^>]*>\s*<td\b[^>]*>(.*?)<\/td>\s*<td\b[^>]*>(.*?)<\/td>\s*<\/tr>/is', $normalizedDescriptionHtml, $tableRows, PREG_SET_ORDER)) {
        foreach ($tableRows as $row) {
            $label = $normalizeSpecLabel(trim(strip_tags($row[1])));
            $value = $cleanSpecValue(trim(strip_tags($row[2])));
            if ($label !== '' && $value !== '' && $isAllowedSpecLabel($label) && !isset($specRows[$label])) {
                $specRows[$label] = $value;
            }
        }
    }

    $cleanDescriptionHtml = preg_replace('/<h[1-6][^>]*>\s*(Đặc điểm|Features?)\s*<\/h[1-6]>\s*<ul\b[^>]*>.*?<\/ul>/isu', '', $normalizedDescriptionHtml);
    $cleanDescriptionHtml = preg_replace('/<h[1-6][^>]*>\s*(Thông số kỹ thuật|Specifications?)\s*<\/h[1-6]>\s*<table\b[^>]*>.*?<\/table>/isu', '', (string) $cleanDescriptionHtml);
    $cleanDescriptionHtml = preg_replace('/<table\b[^>]*>.*?<\/table>/is', '', (string) $cleanDescriptionHtml);
    $cleanDescriptionHtml = preg_replace('/(?:\s*<br\s*\/?>\s*){2,}/i', '<br>', (string) $cleanDescriptionHtml);
    $cleanDescriptionHtml = trim((string) $cleanDescriptionHtml);

    if ($cleanDescriptionHtml !== '' && $isMeaningfulDescription($cleanDescriptionHtml)) {
        $descriptionHtml = $cleanDescriptionHtml;
    }
}


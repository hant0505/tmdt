$toCardData = function ($item, $tag = '') use ($imageHelper) {
    $img = (string) $imageHelper->init($item, 'product_small_image')->getUrl();
    $rPrice = (float) $item->getPrice();
    $fPrice = (float) $item->getFinalPrice();
    $conf = trim(strip_tags((string) $item->getShortDescription()));

    return [
        'id' => (int) $item->getId(),
        'name' => (string) $item->getName(),
        'url' => (string) $item->getProductUrl(),
        'image' => $img,
        'config' => $conf !== '' ? $conf : 'Balanced performance for daily use',
        'price' => $fPrice > 0 ? $fPrice : $rPrice,
        'tag' => $tag
    ];
};

$similarData = [];
$similarIds = [];
foreach ($related as $item) {
    $itemId = (int) $item->getId();
    if ($itemId <= 0 || isset($similarIds[$itemId])) {
        continue;

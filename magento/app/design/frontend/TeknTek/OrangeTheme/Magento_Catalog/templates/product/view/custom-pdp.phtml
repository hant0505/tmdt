$normalizeSpecLabel = static function (string $label): string {
    $normalized = html_entity_decode($label, ENT_QUOTES | ENT_HTML5, 'UTF-8');
    $normalized = preg_replace('/\s+/', ' ', trim($normalized)) ?? trim($normalized);
    $slug = strtolower($normalized);
    $slug = preg_replace('/[^a-z0-9]+/', '_', $slug) ?? $slug;
    $slug = trim($slug, '_');

    $map = [
        'brand' => 'Brand',
        'manufacturer' => 'Brand',
        'model' => 'Model',
        'model_name' => 'Model',
        'model_number' => 'Model',
        'series' => 'Series',
        'color' => 'Color',
        'colour' => 'Color',
        'item_weight' => 'Weight',
        'weight_item' => 'Weight',
        'weight' => 'Weight',
        'product_dimensions' => 'Dimensions',
        'dimensions' => 'Dimensions',
        'screen_size' => 'Screen size',
        'display_size' => 'Screen size',
        'display' => 'Display',
        'display_resolution' => 'Resolution',
        'resolution' => 'Resolution',
        'processor' => 'Processor',
        'processor_type' => 'Processor',
        'cpu_model' => 'Processor',
        'chipset' => 'Chipset',
        'ram' => 'RAM',
        'memory' => 'RAM',
        'internal_memory' => 'RAM',
        'storage' => 'Storage',
        'storage_capacity' => 'Storage',
        'ssd_capacity' => 'Storage',
        'hard_drive_capacity' => 'Storage',
        'hard_drive_size' => 'Storage',
        'graphics_card' => 'Graphics',
        'graphics_processor' => 'Graphics',
        'video_card' => 'Graphics',
        'operating_system' => 'Operating system',
        'os' => 'Operating system',
        'battery_life' => 'Battery life',
        'maximum_battery_battery_life' => 'Battery life',
        'battery_average_life' => 'Battery life',
        'connectivity_technology' => 'Connectivity',
        'wireless_type' => 'Wireless',
        'bluetooth' => 'Bluetooth',
        'special_features' => 'Special features',
        'compatible_devices' => 'Compatible devices',
        'dpi' => 'DPI',
        'mouse_maximum_sensitivity' => 'DPI',
        'hand_orientation' => 'Hand orientation',
        'movement_detection' => 'Sensor',
        'buttons' => 'Buttons',
        'number_of_buttons' => 'Buttons',
        'warranty_type' => 'Warranty',
        'warranty_description' => 'Warranty',
    ];

    return $map[$slug] ?? $normalized;
};

$cleanSpecValue = static function (string $value): string {
    $normalized = html_entity_decode($value, ENT_QUOTES | ENT_HTML5, 'UTF-8');
    $normalized = preg_replace('/\s+/', ' ', trim($normalized)) ?? trim($normalized);
    $normalized = strtr($normalized, [
        'â€™' => '’',
        'â€˜' => '‘',
        'â€œ' => '“',
        'â€' => '”',
        'â€“' => '–',
        'â€”' => '—',
        'â€¦' => '…',
        'Â ' => ' ',
        'Â' => '',
    ]);

    if ($normalized === '' || $normalized === '0.000000' || strtolower($normalized) === 'none') {
        return '';
    }

    return $normalized;
};

$isAllowedSpecLabel = static function (string $label): bool {
    $allowed = [
        'Brand',
        'Model',
        'Series',
        'Color',
        'Weight',
        'Dimensions',
        'Screen size',
        'Display',
        'Resolution',
        'Processor',
        'Chipset',
        'RAM',

    </div>
</div>

<script>
(function () {
    var dataNode = document.getElementById('tekntek-mock-json');
    var similarGrid = document.getElementById('tekntek-similar-grid');
    var accessoryGrid = document.getElementById('tekntek-accessory-grid');
    var reviewSummary = document.getElementById('tekntek-review-summary');
    var reviewList = document.getElementById('tekntek-review-list');
    var viewMoreBtn = document.getElementById('tekntek-view-more');
    var compareBar = document.getElementById('tekntek-compare-bar');
    var compareItemsWrap = document.getElementById('tekntek-compare-items');
    var compareLink = document.getElementById('tekntek-compare-link');
    var addMainCompareBtn = document.getElementById('tekntek-add-main-compare');
    var compareError = document.getElementById('tekntek-compare-error');
    var galleryMain = document.getElementById('tekntek-gallery-main');
    var galleryPrev = document.getElementById('tekntek-gallery-prev');
    var galleryNext = document.getElementById('tekntek-gallery-next');
    var galleryThumbButtons = Array.prototype.slice.call(document.querySelectorAll('[data-gallery-index]'));

    if (!dataNode || !similarGrid || !accessoryGrid || !reviewSummary || !reviewList || !compareBar || !compareItemsWrap || !compareLink || !viewMoreBtn || !addMainCompareBtn || !compareError) {
        return;
    }

    var payload = JSON.parse(dataNode.textContent || '{}');
    var compareStoreKey = 'tekntek_compare_v2';
    var reviews = Array.isArray(payload.reviews) ? payload.reviews : [];
    var similar = Array.isArray(payload.similar) ? payload.similar : [];
    var accessories = Array.isArray(payload.accessories) ? payload.accessories : [];
    var mainProduct = payload.mainProduct || null;
    var compareAddBaseUrl = payload.compareAddBaseUrl || '/catalog/product_compare/add/';
    var compareClearUrl = payload.compareClearUrl || '/catalog/product_compare/clear/';
    var auth = payload.auth || {};
    var isLoggedIn = !!auth.isLoggedIn;
    var loginUrl = auth.loginUrl || '/customer/account/login';

    function redirectToLogin() {
        window.location.href = loginUrl;
    }
    var reviewSubmit = payload.reviewSubmit || {};
    var compareState = [];
    var visibleReviews = 2;
    var reviewStep = 2;
    var pendingReviewKey = 'tekntek_pending_reviews_' + Number(reviewSubmit.productId || (mainProduct && mainProduct.id) || 0);

    function readPendingReviews() {
        try {
            var raw = window.sessionStorage.getItem(pendingReviewKey);
            var parsed = raw ? JSON.parse(raw) : [];
            if (!Array.isArray(parsed)) {
                return [];
            }
            return parsed.filter(function (review) {
                return Number(review && (review.id || review.review_id) || 0) > 0;
            });
        } catch (error) {
            return [];
        }
    }

    function writePendingReview(review) {
        try {
            var pending = readPendingReviews();
            pending.unshift(review);
            window.sessionStorage.setItem(pendingReviewKey, JSON.stringify(pending.slice(0, 5)));
        } catch (error) {
            // sessionStorage can be disabled; Magento submit should still continue.
        }
    }

    function removePendingReview(reviewId) {
        try {
            var pending = readPendingReviews().filter(function (review) {
                return String(getReviewId(review) || '') !== String(reviewId);
            });
            window.sessionStorage.setItem(pendingReviewKey, JSON.stringify(pending));
        } catch (error) {
            // sessionStorage can be disabled; the server delete has already completed.
        }
    }

    function mergePendingReviews(baseReviews) {
        var pending = readPendingReviews();
        if (!pending.length) {
            return baseReviews;
        }
        return pending.concat(baseReviews);
    }

    function getReviewId(review) {
        return Number(review && (review.id || review.review_id) || 0);
    }

    reviews = mergePendingReviews(reviews);

    function price(value) {
        var num = Number(value || 0);
        return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(num);
    }

    function stars(n) {
        var rating = Math.max(0, Math.min(5, Math.round(Number(n || 0))));
        var html = '';
        for (var i = 1; i <= 5; i += 1) {
            html += '<span class="' + (i <= rating ? 'is-active' : 'is-empty') + '">★</span>';
        }
        return html;
    }

    function getReviewStats() {
        var ratedReviews = reviews.filter(function (review) {
            return Number(review.stars || 0) > 0;
        });
        var counts = [5, 4, 3, 2, 1].map(function (star) {
            return ratedReviews.filter(function (review) {
                return Number(review.stars) === star;
            }).length;
        });
        var total = ratedReviews.length;
        var sum = ratedReviews.reduce(function (carry, review) {
            return carry + Math.max(0, Math.min(5, Number(review.stars || 0)));
        }, 0);

        return {
            counts: counts,
            total: total,
            average: total > 0 ? Math.round(sum / total) : 0
        };
    }

    function updateTopRating(stats) {
        var starNode = document.getElementById('tekntek-top-rating-stars');
        var countNode = document.getElementById('tekntek-top-rating-count');
        if (starNode) {
            starNode.innerHTML = stars(stats.average);
        }
        if (countNode) {
            countNode.textContent = '(' + stats.total + ')';
        }
    }

    function esc(value) {
        return String(value || '').replace(/[&<>"']/g, function (ch) {
            return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' })[ch];
        });
    }

    function setCompareError(message) {
        compareError.textContent = message || '';
    }

    function buildCompareAddUrl(productId) {
        var base = String(compareAddBaseUrl || '/catalog/product_compare/add/');
        if (base.slice(-1) !== '/') {
            base += '/';
        }
        return base + 'product/' + Number(productId) + '/';
    }

    function getFormKey() {
        var match = document.cookie.match(/(?:^|;\s*)form_key=([^;]+)/);
        if (match) {
            return decodeURIComponent(match[1]);
        }
        if (window.FORM_KEY) {
            return window.FORM_KEY;
        }
        var node = document.querySelector('input[name="form_key"]');
        if (node && node.value) {
            return node.value;
        }
        return '';
    }

    function submitNativePost(url, fields) {
        var nativeForm = document.createElement('form');
        nativeForm.method = 'post';
        nativeForm.action = url;
        nativeForm.style.display = 'none';

        Object.keys(fields).forEach(function (name) {
            var input = document.createElement('input');
            input.type = 'hidden';
            input.name = name;
            input.value = fields[name];
            nativeForm.appendChild(input);
        });

        document.body.appendChild(nativeForm);
        nativeForm.submit();
    }

    function postForm(url, data) {
        return fetch(url, {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8'
            },
            body: new URLSearchParams(data).toString()
        }).catch(function () {
            return null;
        });
    }

    function syncMagentoCompare() {
        var formKey = getFormKey();
        var uenc = window.btoa(window.location.href);
        return Promise.all(compareState.map(function (item) {
            return postForm(buildCompareAddUrl(item.id), {
                form_key: formKey,
                product: Number(item.id),
                uenc: uenc
            });
        }));
    }

    function loadCompareState() {
        try {
            var raw = window.localStorage.getItem(compareStoreKey);
            if (!raw) {
                return Array.isArray(payload.compareSeed) ? payload.compareSeed.slice(0, 3) : [];
            }
            var parsed = JSON.parse(raw);
            if (!Array.isArray(parsed)) {
                return [];
            }
            var normalized = parsed.filter(function (item) {
                return item && Number(item.id) > 0;
            }).slice(0, 3).map(function (item) {
                var categoryIds = Array.isArray(item.category_ids) ? item.category_ids : [];
                categoryIds = categoryIds.map(function (id) {
                    return Number(id);
                }).filter(function (id) {
                    return id > 0;
                });

                if ((!categoryIds.length) && mainProduct && Number(item.id) === Number(mainProduct.id) && Array.isArray(mainProduct.category_ids)) {
                    categoryIds = mainProduct.category_ids.map(function (id) {
                        return Number(id);
                    }).filter(function (id) {
                        return id > 0;
                    });
                }

                item.category_ids = categoryIds;
                return item;
            });

            return normalized;
        } catch (e) {
            return [];
        }
    }

    function normalizeCategoryIds(item) {
        var list = Array.isArray(item && item.category_ids) ? item.category_ids : [];
        return list.map(function (id) {
            return Number(id);
        }).filter(function (id) {
            return id > 0;
        });
    }

    function intersectCategories(left, right) {
        var leftSet = new Set(left);
        return right.filter(function (id) {
            return leftSet.has(id);
        });
    }

    function getCommonCategoryIds(state) {
        if (!Array.isArray(state) || !state.length) {
            return [];
        }
        var common = normalizeCategoryIds(state[0]);
        for (var i = 1; i < state.length; i += 1) {
            common = intersectCategories(common, normalizeCategoryIds(state[i]));
            if (!common.length) {
                break;
            }
        }
        return common;
    }

    function saveCompareState() {
        try {
            window.localStorage.setItem(compareStoreKey, JSON.stringify(compareState));
        } catch (e) {
            // Ignore storage quota/privacy mode errors.
        }
    }

    function removeFromCompare(id) {
        compareState = compareState.filter(function (item) {
            return Number(item.id) !== Number(id);
        });
        setCompareError('');
        saveCompareState();
        renderCompare();
    }

    function renderCompare() {
        compareBar.style.display = compareState.length > 0 ? 'block' : 'none';
        compareItemsWrap.innerHTML = compareState.map(function (item) {
            return '<div class="tekntek-compare-item">' +
                '<div class="tekntek-compare-item-main">' +
                    '<img src="' + item.image + '" alt="' + item.name + '">' +
                    '<div><div class="tekntek-compare-title">' + item.name + '</div><div class="tekntek-compare-price">' + price(item.price) + '</div></div>' +
                '</div>' +
                '<button type="button" class="tekntek-compare-remove" data-role="remove-compare" data-id="' + item.id + '" aria-label="Remove">×</button>' +
            '</div>';
        }).join('');
        compareLink.textContent = 'Compare items (' + compareState.length + ')';
        compareItemsWrap.querySelectorAll('[data-role="remove-compare"]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                removeFromCompare(Number(btn.getAttribute('data-id')));
            });
        });
    }

    function addToCompare(item) {
        item.category_ids = normalizeCategoryIds(item);
        var exists = compareState.some(function (x) { return Number(x.id) === Number(item.id); });
        if (exists) {
            setCompareError('This product is already in compare list.');
            return;
        }
        if (compareState.length >= 3) {
            setCompareError('You can compare up to 3 products only.');
            return;
        }

        if (!item.category_ids.length) {
            setCompareError('Cannot add to compare: product category is missing.');
            return;
        }

        if (compareState.length > 0) {
            var commonCategories = getCommonCategoryIds(compareState);
            if (!commonCategories.length) {
                commonCategories = normalizeCategoryIds(compareState[0]);
            }
            var nextCommon = intersectCategories(commonCategories, item.category_ids);
            if (!nextCommon.length) {
                setCompareError('Only products in the same category can be compared.');
                return;
            }
        }

        compareState.push(item);
        setCompareError('');
        saveCompareState();
        renderCompare();

        // Keep Magento compare list in sync immediately, not only at redirect time.
        var formKey = getFormKey();
        var uenc = window.btoa(window.location.href);
        postForm(buildCompareAddUrl(item.id), {
            form_key: formKey,
            product: Number(item.id),
            uenc: uenc
        });
    }

    function cardTemplate(item, withTag) {
        var tag = withTag && item.tag ? '<span class="tekntek-tag">' + item.tag + '</span>' : '';
        return '<article class="tekntek-prod-card">' +
            tag +
            '<a href="' + item.url + '"><img src="' + item.image + '" alt="' + item.name + '"></a>' +
            '<div class="tekntek-prod-name">' + item.name + '</div>' +
            '<div class="tekntek-prod-conf">' + item.config + '</div>' +
            '<div class="tekntek-prod-price">' + price(item.price) + '</div>' +
        '</article>';
    }

    function renderCards() {
        similarGrid.innerHTML = similar.map(function (item) { return cardTemplate(item, false); }).join('');
        accessoryGrid.innerHTML = accessories.map(function (item) { return cardTemplate(item, true); }).join('');
    }

    function bindGallery() {
        if (!galleryMain || !galleryThumbButtons.length) {
            return;
        }

        var currentIndex = 0;

        function updateGallery(index) {
            if (index < 0) {
                index = galleryThumbButtons.length - 1;
            }
            if (index >= galleryThumbButtons.length) {
                index = 0;
            }

            currentIndex = index;
            var activeButton = galleryThumbButtons[currentIndex];
            var src = activeButton.getAttribute('data-gallery-src') || '';
            var alt = activeButton.getAttribute('data-gallery-alt') || '';

            if (src) {
                galleryMain.src = src;
            }
            galleryMain.alt = alt;

            galleryThumbButtons.forEach(function (button, buttonIndex) {
                button.classList.toggle('is-active', buttonIndex === currentIndex);
            });
        }

        galleryThumbButtons.forEach(function (button) {
            button.addEventListener('click', function () {
                updateGallery(Number(button.getAttribute('data-gallery-index') || 0));
            });
        });

        if (galleryPrev) {
            galleryPrev.addEventListener('click', function () {
                updateGallery(currentIndex - 1);
            });
        }

        if (galleryNext) {
            galleryNext.addEventListener('click', function () {
                updateGallery(currentIndex + 1);
            });
        }

        updateGallery(0);
    }

    function renderReviewSummary() {
        var stats = getReviewStats();
        var total = stats.total || 1;
        var reviewAction = esc(reviewSubmit.action || window.location.href);
        updateTopRating(stats);
        reviewSummary.innerHTML = '<strong>Customer reviews</strong>' +
            '<div class="tekntek-overall-stars tekntek-rating-stars">' + stars(stats.average) + '</div>' +
            '<div class="tekntek-bars">' + stats.counts.map(function (count, idx) {
                var width = Math.round((count / total) * 100);
                var starLabel = 5 - idx;
                return '<div class="tekntek-bar-row"><span>' + starLabel + ' star</span><div class="tekntek-bar"><span style="width:' + width + '%"></span></div><span>' + width + '%</span></div>';
            }).join('') + '</div>' +
            '<p class="tekntek-review-note">Share your feedback and create a better shopping experience for everyone. Thank you for taking the time to share your opinion.</p>' +
            '<button class="tekntek-btn tekntek-btn-buy" id="tekntek-add-review" style="width:100%">Write a review</button>' +
            '<form id="tekntek-review-form" class="tekntek-review-form" action="' + reviewAction + '" method="post" novalidate>' +
                '<div class="tekntek-review-form-row" id="tekntek-review-message" style="display:none"></div>' +
                '<input type="hidden" name="form_key" id="tekntek-review-form-key" value="">' +
                '<input type="hidden" name="nickname" value="' + esc(reviewSubmit.nickname || 'Customer') + '">' +
                '<input type="hidden" name="validate_rating" value="">' +
                '<div id="tekntek-review-rating-fields"></div>' +
                '<div class="tekntek-review-form-row"><label for="tekntek-review-stars">Rating</label><select id="tekntek-review-stars"><option value="5">5 stars</option><option value="4">4 stars</option><option value="3">3 stars</option><option value="2">2 stars</option><option value="1">1 star</option></select></div>' +
                '<div class="tekntek-review-form-row"><label for="tekntek-review-title">Title</label><input id="tekntek-review-title" name="title" type="text" maxlength="120" placeholder="Review title"></div>' +
                '<div class="tekntek-review-form-row"><label for="tekntek-review-content">Comment</label><textarea id="tekntek-review-content" name="detail" maxlength="800" placeholder="Share your experience"></textarea></div>' +
                '<div class="tekntek-review-form-actions"><button type="submit" class="tekntek-btn tekntek-btn-buy">Submit review</button><button type="button" id="tekntek-review-cancel" class="tekntek-btn tekntek-btn-cart">Cancel</button></div>' +
            '</form>';
    }

    function renderReviews() {
        var current = reviews.slice(0, visibleReviews);
        reviewList.innerHTML = current.map(function (review, idx) {
            var pros = (review.pros || []).filter(function (item) { return String(item || '').trim() !== ''; });
            var cons = (review.cons || []).filter(function (item) { return String(item || '').trim() !== ''; });
            var prosConsHtml = '';
            if (pros.length || cons.length) {
                prosConsHtml = '<p>' +
                    (pros.length ? '+ ' + pros.map(esc).join('<br>+ ') : '') +
                    (pros.length && cons.length ? '<br>' : '') +
                    (cons.length ? '- ' + cons.map(esc).join('<br>- ') : '') +
                    '</p>';
            }
            var upCount = Number(review.up || 0);
            var downCount = Number(review.down || 0);
            var userVote = String(review.user_vote || '');
            var upDisabled = userVote === 'up' ? ' disabled' : '';
            var downDisabled = userVote === 'down' ? ' disabled' : '';
            var upLabel = 'Helpful (' + upCount + ')';
            var downLabel = 'Not helpful (' + downCount + ')';

            var reviewIdValue = getReviewId(review);
            var deleteHtml = reviewIdValue
                ? '<button type="button" class="tekntek-delete-review" data-role="delete" data-review-id="' + reviewIdValue + '">Delete</button>'
                : '';

            return '<article class="tekntek-review-item">' +
                '<div class="tekntek-rating-stars">' + stars(review.stars) + '</div>' +
                '<div class="tekntek-review-meta">' + esc(review.date) + ' • ' + esc(review.user) + '</div>' +
                '<strong>' + esc(review.title) + '</strong>' +
                '<p>' + esc(review.content) + '</p>' +
                prosConsHtml +
                '<div class="tekntek-review-vote">' +
                    '<button type="button" class="tekntek-vote-btn" data-role="vote" data-type="up" data-index="' + idx + '" data-review-id="' + (reviewIdValue || '') + '"' + upDisabled + '>' + esc(upLabel) + '</button> ' +
                    '<button type="button" class="tekntek-vote-btn" data-role="vote" data-type="down" data-index="' + idx + '" data-review-id="' + (reviewIdValue || '') + '"' + downDisabled + '>' + esc(downLabel) + '</button>' +
                    deleteHtml +
                '</div>' +
            '</article>';
        }).join('');

        viewMoreBtn.style.display = reviews.length > visibleReviews ? 'inline-flex' : 'none';

        // Vote button handler: POST to vote endpoint and update UI
        reviewList.querySelectorAll('[data-role="vote"]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var index = Number(btn.getAttribute('data-index'));
                var type = btn.getAttribute('data-type');
                var reviewId = btn.getAttribute('data-review-id');
                if (!reviews[index] || !reviewId) {
                    return;
                }
                if (String(reviews[index].user_vote || '') === type) {
                    return;
                }

                btn.disabled = true;

                var body = new URLSearchParams();
                body.append('form_key', getFormKey() || reviewSubmit.formKey || '');
                body.append('review_id', reviewId);
                body.append('type', type === 'down' ? 'down' : 'up');

                fetch((reviewSubmit.voteUrl || ''), {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: body.toString()
                }).then(function (resp) {
                    return resp.json().then(function (data) {
                        if (!resp.ok || !data.success) {
                            var err = new Error(data.message || 'Vote failed');
                            err.payload = data;
                            throw err;
                        }
                        return data;
                    });
                }).then(function (data) {
                    // Update local model from response
                    var idx = index;
                    if (typeof data.up === 'number') {
                        reviews[idx].up = data.up;
                    }
                    if (typeof data.down === 'number') {
                        reviews[idx].down = data.down;
                    }
                    if (data.user_vote) {
                        reviews[idx].user_vote = data.user_vote;
                    }
                    renderReviews();
                    renderReviewSummary();
                    bindAddReview();
                }).catch(function (err) {
                    var payload = err && err.payload ? err.payload : {};
                    if (payload.login_url) {
                        window.location.href = payload.login_url;
                        return;
                    }
                    if (payload.has_voted && reviews[index]) {
                        if (typeof payload.up === 'number') {
                            reviews[index].up = payload.up;
                        }
                        if (typeof payload.down === 'number') {
                            reviews[index].down = payload.down;
                        }
                        if (payload.user_vote) {
                            reviews[index].user_vote = payload.user_vote;
                        }
                        renderReviews();
                        renderReviewSummary();
                        bindAddReview();
                        return;
                    }
                    console.warn('Vote error', err);
                    alert(payload.message || err.message || 'Vote failed');
                }).finally(function () {
                    btn.disabled = false;
                });
            });
        });

        // Delete button handler: POST to delete endpoint and remove review on success
        reviewList.querySelectorAll('[data-role="delete"]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var reviewId = btn.getAttribute('data-review-id');
                if (!reviewId) {
                    return;
                }
                if (!confirm('Delete this review? This action cannot be undone.')) {
                    return;
                }

                btn.disabled = true;

                var body = new URLSearchParams();
                body.append('form_key', getFormKey() || reviewSubmit.formKey || '');
                body.append('review_id', reviewId);

                fetch((reviewSubmit.deleteUrl || ''), {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: body.toString()
                }).then(function (resp) {
                    return resp.json().then(function (data) {
                        if (!resp.ok || !data.success) {
                            var err = new Error(data.message || 'Delete failed');
                            err.payload = data;
                            throw err;
                        }
                        return data;
                    });
                }).then(function (data) {
                    // remove review from local list
                    removePendingReview(reviewId);
                    reviews = reviews.filter(function (r) {
                        return String(getReviewId(r) || '') !== String(reviewId);
                    });
                    renderReviews();
                    renderReviewSummary();
                }).catch(function (err) {
                    var payload = err && err.payload ? err.payload : {};
                    if (payload.login_url) {
                        window.location.href = payload.login_url;
                        return;
                    }
                    console.warn('Delete error', err);
                    alert(payload.message || err.message || 'Delete failed');
                }).finally(function () {
                    btn.disabled = false;
                });
            });
        });
    }

    function bindAddReview() {
        var btn = document.getElementById('tekntek-add-review');
        var form = document.getElementById('tekntek-review-form');
        var cancel = document.getElementById('tekntek-review-cancel');
        if (!btn) {
            return;
        }
        btn.addEventListener('click', function () {
            if (!form) {
                return;
            }
            form.classList.add('is-open');
        });

        if (!form) {
            return;
        }

        form.addEventListener('submit', function (event) {
            event.preventDefault();
            var starNode = document.getElementById('tekntek-review-stars');
            var titleNode = document.getElementById('tekntek-review-title');
            var contentNode = document.getElementById('tekntek-review-content');
            var messageNode = document.getElementById('tekntek-review-message');
            var submitButton = form.querySelector('button[type="submit"]');
            var starsValue = Number(starNode && starNode.value ? starNode.value : 5);
            var titleValue = titleNode ? titleNode.value.trim() : '';
            var contentValue = contentNode ? contentNode.value.trim() : '';
            var ratingOptions = reviewSubmit.ratingOptions || {};
            var formKeyNode = document.getElementById('tekntek-review-form-key');
            var ratingFields = document.getElementById('tekntek-review-rating-fields');
            var hasRating = false;
            var formKey = getFormKey();

            function showReviewMessage(message, isError) {
                if (!messageNode) {
                    return;
                }
                messageNode.style.display = 'block';
                messageNode.style.color = isError ? '#b91c1c' : '#166534';
                messageNode.style.fontWeight = '700';
                messageNode.textContent = message || '';
            }

            if (contentValue === '') {
                showReviewMessage('Please enter your review comment.', true);
                return;
            }

            if (!reviewSubmit.ajaxAction || !formKey) {
                showReviewMessage('Please refresh the page and try again.', true);
                return;
            }

            form.action = reviewSubmit.action;
            if (formKeyNode) {
                formKeyNode.value = formKey;
            }
            if (ratingFields) {
                ratingFields.innerHTML = '';
            }

            Object.keys(ratingOptions).forEach(function (ratingId) {
                var options = ratingOptions[ratingId] || {};
                var optionId = options[String(starsValue)] || options[starsValue];
                if (optionId) {
                    if (ratingFields) {
                        var input = document.createElement('input');
                        input.type = 'hidden';
                        input.name = 'ratings[' + ratingId + ']';
                        input.value = optionId;
                        ratingFields.appendChild(input);
                    }
                    hasRating = true;
                }
            });

            if (submitButton) {
                submitButton.disabled = true;
            }
            showReviewMessage('Submitting review...', false);

            var reviewBody = new URLSearchParams();
            reviewBody.append('form_key', formKey);
            reviewBody.append('product_id', Number(reviewSubmit.productId || (mainProduct && mainProduct.id) || 0));
            reviewBody.append('stars', starsValue);
            reviewBody.append('title', titleValue !== '' ? titleValue : 'New review');
            reviewBody.append('detail', contentValue);
            Object.keys(ratingOptions).forEach(function (ratingId) {
                var options = ratingOptions[ratingId] || {};
                var optionId = options[String(starsValue)] || options[starsValue];
                if (optionId) {
                    reviewBody.append('ratings[' + ratingId + ']', optionId);
                }
            });

            fetch(reviewSubmit.ajaxAction, {
                method: 'POST',
                credentials: 'same-origin',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: reviewBody.toString()
            }).then(function (response) {
                return response.json().then(function (data) {
                    if (!response.ok || !data.success) {
                        var error = new Error(data.message || 'Review submit failed');
                        error.payload = data;
                        throw error;
                    }
                    return data;
                });
            }).then(function (data) {
                var submittedReview = data.review || {
                    stars: Math.max(1, Math.min(5, starsValue)),
                    date: new Date().toLocaleDateString('en-GB'),
                    user: 'You',
                    title: titleValue !== '' ? titleValue : 'New review',
                    content: contentValue,
                    pros: [],
                    cons: [],
                    up: 0,
                    down: 0
                };

                writePendingReview(submittedReview);
                reviews.unshift(submittedReview);
                visibleReviews = Math.max(visibleReviews, 2);
                if (titleNode) {
                    titleNode.value = '';
                }
                if (contentNode) {
                    contentNode.value = '';
                }
                form.classList.remove('is-open');
                renderReviews();
                renderReviewSummary();
                bindAddReview();
            }).catch(function (error) {
                var payload = error && error.payload ? error.payload : {};
                if (payload.login_url) {
                    window.location.href = payload.login_url;
                    return;
                }
                showReviewMessage(payload.message || error.message || 'Review submit failed.', true);
            }).finally(function () {
                if (submitButton) {
                    submitButton.disabled = false;
                }
            });
        });

        if (cancel) {
            cancel.addEventListener('click', function () {
                form.classList.remove('is-open');
            });
        }
    }

    function bindViewMore() {
        viewMoreBtn.addEventListener('click', function () {
            visibleReviews += reviewStep;
            renderReviews();
        });
    }

    renderCards();
    renderReviewSummary();
    renderReviews();
    compareState = loadCompareState();
    bindGallery();
    bindAddReview();
    bindViewMore();

    if (!isLoggedIn) {
        document.querySelectorAll('.tekntek-cta form').forEach(function (formNode) {
            formNode.addEventListener('submit', function (event) {
                event.preventDefault();
                redirectToLogin();
            });
        });
    }
    addMainCompareBtn.addEventListener('click', function () {
        if (!isLoggedIn) {
            redirectToLogin();
            return;
        }

        if (!mainProduct || !mainProduct.id) {
            return;
        }
        addToCompare({
            id: mainProduct.id,
            name: mainProduct.name,
            image: mainProduct.image,
            price: mainProduct.price,
            category_ids: mainProduct.category_ids
        });
    });
    compareLink.addEventListener('click', function (event) {
        event.preventDefault();

        if (!isLoggedIn) {
            redirectToLogin();
            return;
        }

        if (!compareState.length) {
            window.location.href = compareLink.href;
            return;
        }
        var ids = compareState.map(function (item) { return Number(item.id); }).filter(function (id) { return id > 0; });
        var nextUrl = new URL(compareLink.href, window.location.origin);
        nextUrl.searchParams.set('ids', ids.join(','));
        setCompareError('');
        syncMagentoCompare().finally(function () {
            window.location.href = nextUrl.toString();
        });
    });
    renderCompare();
})();
</script>

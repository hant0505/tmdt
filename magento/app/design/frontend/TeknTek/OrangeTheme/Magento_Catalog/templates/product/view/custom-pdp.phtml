<script type="application/json" id="tekntek-mock-json"><?= /* @noEscape */ json_encode([
    'similar' => $similarData,
    'accessories' => $accessoryData,
    'reviews' => $reviewData,
    'compareSeed' => $compareSeed,
    'mainProduct' => $mainCompareItem,
    'compareAddBaseUrl' => $compareAddBaseUrl,
    'compareClearUrl' => $compareClearUrl,
    'auth' => [
        'isLoggedIn' => $isLoggedIn,
        'loginUrl' => $loginUrl
    ]
], JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) ?></script>

<div class="tekntek-compare-bar" id="tekntek-compare-bar">
    <div class="tekntek-compare-inner">
        <div class="tekntek-compare-items" id="tekntek-compare-items"></div>
        <a class="tekntek-btn tekntek-btn-buy" id="tekntek-compare-link" href="<?= $escaper->escapeUrl($compareIndexUrl) ?>">Compare items (0)</a>
    </div>
</div>

<script>
(function () {
    var link = document.querySelector('[data-role="desc-toggle"]');
    var text = document.querySelector('[data-role="desc-text"]');
    if (!link || !text) {
        return;
    }
    link.addEventListener('click', function (event) {
        event.preventDefault();
        var collapsed = text.classList.toggle('is-collapsed');
        link.textContent = collapsed ? 'Show more' : 'Show less';
    });

    var dataNode = document.getElementById('tekntek-mock-json');
    var similarGrid = document.getElementById('tekntek-similar-grid');
    var accessoryGrid = document.getElementById('tekntek-accessory-grid');
    var reviewSummary = document.getElementById('tekntek-review-summary');
    var reviewList = document.getElementById('tekntek-review-list');
    var viewMoreBtn = document.getElementById('tekntek-view-more');
    var compareBar = document.getElementById('tekntek-compare-bar');
    var compareItemsWrap = document.getElementById('tekntek-compare-items');
    var compareLink = document.getElementById('tekntek-compare-link');
    var addMainCompareBtn = document.getElementById('tekntek-add-main-compare');
    var compareError = document.getElementById('tekntek-compare-error');

    if (!dataNode || !similarGrid || !accessoryGrid || !reviewSummary || !reviewList || !compareBar || !compareItemsWrap || !compareLink || !viewMoreBtn || !addMainCompareBtn || !compareError) {
        return;
    }

    var payload = JSON.parse(dataNode.textContent || '{}');
    var compareStoreKey = 'tekntek_compare_v1';
    var reviews = Array.isArray(payload.reviews) ? payload.reviews : [];
    var similar = Array.isArray(payload.similar) ? payload.similar : [];
    var accessories = Array.isArray(payload.accessories) ? payload.accessories : [];
    var mainProduct = payload.mainProduct || null;
    var compareAddBaseUrl = payload.compareAddBaseUrl || '/catalog/product_compare/add/';
    var compareClearUrl = payload.compareClearUrl || '/catalog/product_compare/clear/';
    var auth = payload.auth || {};
    var isLoggedIn = !!auth.isLoggedIn;
    var loginUrl = auth.loginUrl || '/customer/account/login';
    var compareState = [];
    var visibleReviews = 2;
    var reviewStep = 2;

    function price(value) {
        var num = Number(value || 0);
        return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(num);
    }

    function stars(n) {
        var rating = Math.max(0, Math.min(5, Number(n || 0)));
        return '★★★★★'.slice(0, rating) + '☆☆☆☆☆'.slice(0, 5 - rating);
    }

    function esc(value) {
        return String(value || '').replace(/[&<>"']/g, function (ch) {
            return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' })[ch];
        });
    }

    function setCompareError(message) {
        compareError.textContent = message || '';
    }

    function buildCompareAddUrl(productId) {
        var base = String(compareAddBaseUrl || '/catalog/product_compare/add/');
        if (base.slice(-1) !== '/') {
            base += '/';
        }
        return base + 'product/' + Number(productId) + '/';
    }

    function getFormKey() {
        var node = document.querySelector('input[name="form_key"]');
        if (node && node.value) {
            return node.value;
        }
        if (window.FORM_KEY) {
            return window.FORM_KEY;
        }
        return '';
    }

    function postForm(url, data) {
        return fetch(url, {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8'
            },
            body: new URLSearchParams(data).toString()
        }).catch(function () {
            return null;
        });
    }

    function syncMagentoCompare() {
        var formKey = getFormKey();
        var uenc = window.btoa(window.location.href);
        return Promise.all(compareState.map(function (item) {
            return postForm(buildCompareAddUrl(item.id), {
                form_key: formKey,
                product: Number(item.id),
                uenc: uenc
            });
        }));
    }

    function loadCompareState() {
        try {
            var raw = window.localStorage.getItem(compareStoreKey);
            if (!raw) {
                return Array.isArray(payload.compareSeed) ? payload.compareSeed.slice(0, 3) : [];
            }
            var parsed = JSON.parse(raw);
            if (!Array.isArray(parsed)) {
                return [];
            }
            var normalized = parsed.filter(function (item) {
                return item && Number(item.id) > 0;
            }).slice(0, 3).map(function (item) {
                var categoryIds = Array.isArray(item.category_ids) ? item.category_ids : [];
                categoryIds = categoryIds.map(function (id) {
                    return Number(id);
                }).filter(function (id) {
                    return id > 0;
                });

                if ((!categoryIds.length) && mainProduct && Number(item.id) === Number(mainProduct.id) && Array.isArray(mainProduct.category_ids)) {
                    categoryIds = mainProduct.category_ids.map(function (id) {
                        return Number(id);
                    }).filter(function (id) {
                        return id > 0;
                    });
                }

                item.category_ids = categoryIds;
                return item;
            });

            return normalized;
        } catch (e) {
            return [];
        }
    }

    function normalizeCategoryIds(item) {
        var list = Array.isArray(item && item.category_ids) ? item.category_ids : [];
        return list.map(function (id) {
            return Number(id);
        }).filter(function (id) {
            return id > 0;
        });
    }

    function intersectCategories(left, right) {
        var leftSet = new Set(left);
        return right.filter(function (id) {
            return leftSet.has(id);
        });
    }

    function getCommonCategoryIds(state) {
        if (!Array.isArray(state) || !state.length) {
            return [];
        }
        var common = normalizeCategoryIds(state[0]);
        for (var i = 1; i < state.length; i += 1) {
            common = intersectCategories(common, normalizeCategoryIds(state[i]));
            if (!common.length) {
                break;
            }
        }
        return common;
    }

    function saveCompareState() {
        try {
            window.localStorage.setItem(compareStoreKey, JSON.stringify(compareState));
        } catch (e) {
            // Ignore storage quota/privacy mode errors.
        }
    }

    function removeFromCompare(id) {
        compareState = compareState.filter(function (item) {
            return Number(item.id) !== Number(id);
        });
        setCompareError('');
        saveCompareState();
        renderCompare();
    }

    function renderCompare() {
        compareBar.style.display = compareState.length > 0 ? 'block' : 'none';
        compareItemsWrap.innerHTML = compareState.map(function (item) {
            return '<div class="tekntek-compare-item">' +
                '<div class="tekntek-compare-item-main">' +
                    '<img src="' + item.image + '" alt="' + item.name + '">' +
                    '<div><div class="tekntek-compare-title">' + item.name + '</div><div class="tekntek-compare-price">' + price(item.price) + '</div></div>' +
                '</div>' +
                '<button type="button" class="tekntek-compare-remove" data-role="remove-compare" data-id="' + item.id + '" aria-label="Remove">×</button>' +
            '</div>';
        }).join('');
        compareLink.textContent = 'Compare items (' + compareState.length + ')';
        compareItemsWrap.querySelectorAll('[data-role="remove-compare"]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                removeFromCompare(Number(btn.getAttribute('data-id')));
            });
        });
    }

    function addToCompare(item) {
        item.category_ids = normalizeCategoryIds(item);
        var exists = compareState.some(function (x) { return Number(x.id) === Number(item.id); });
        if (exists) {
            setCompareError('This product is already in compare list.');
            return;
        }
        if (compareState.length >= 3) {
            setCompareError('You can compare up to 3 products only.');
            return;
        }

        if (!item.category_ids.length) {
            setCompareError('Cannot add to compare: product category is missing.');
            return;
        }

        if (compareState.length > 0) {
            var commonCategories = getCommonCategoryIds(compareState);
            if (!commonCategories.length) {
                commonCategories = normalizeCategoryIds(compareState[0]);
            }
            var nextCommon = intersectCategories(commonCategories, item.category_ids);
            if (!nextCommon.length) {
                setCompareError('Only products in the same category can be compared.');
                return;
            }
        }

        compareState.push(item);
        setCompareError('');
        saveCompareState();
        renderCompare();

        // Keep Magento compare list in sync immediately, not only at redirect time.
        var formKey = getFormKey();
        var uenc = window.btoa(window.location.href);
        postForm(buildCompareAddUrl(item.id), {
            form_key: formKey,
            product: Number(item.id),
            uenc: uenc
        });
    }

    function cardTemplate(item, withTag) {
        var tag = withTag && item.tag ? '<span class="tekntek-tag">' + item.tag + '</span>' : '';
        return '<article class="tekntek-prod-card">' +
            tag +
            '<a href="' + item.url + '"><img src="' + item.image + '" alt="' + item.name + '"></a>' +
            '<div class="tekntek-prod-name">' + item.name + '</div>' +
            '<div class="tekntek-prod-conf">' + item.config + '</div>' +
            '<div class="tekntek-prod-price">' + price(item.price) + '</div>' +
        '</article>';
    }

    function renderCards() {
        similarGrid.innerHTML = similar.map(function (item) { return cardTemplate(item, false); }).join('');
        accessoryGrid.innerHTML = accessories.map(function (item) { return cardTemplate(item, true); }).join('');
    }

    function renderReviewSummary() {
        var counts = [5, 4, 3, 2, 1].map(function (star) {
            return reviews.filter(function (r) { return Number(r.stars) === star; }).length;
        });
        var total = reviews.length || 1;
        reviewSummary.innerHTML = '<strong>Customer reviews</strong>' +
            '<div class="tekntek-overall-stars">★★★★★</div>' +
            '<div class="tekntek-bars">' + counts.map(function (count, idx) {
                var width = Math.round((count / total) * 100);
                var starLabel = 5 - idx;
                return '<div class="tekntek-bar-row"><span>' + starLabel + ' star</span><div class="tekntek-bar"><span style="width:' + width + '%"></span></div><span>' + width + '%</span></div>';
            }).join('') + '</div>' +
            '<p class="tekntek-review-note">Share your feedback and create a better shopping experience for everyone. Thank you for taking the time to share your opinion.</p>' +
            '<button class="tekntek-btn tekntek-btn-buy" id="tekntek-add-review" style="width:100%">Write a review</button>' +
            '<form id="tekntek-review-form" class="tekntek-review-form" novalidate>' +
                '<div class="tekntek-review-form-row"><label for="tekntek-review-stars">Rating</label><select id="tekntek-review-stars"><option value="5">5 stars</option><option value="4">4 stars</option><option value="3">3 stars</option><option value="2">2 stars</option><option value="1">1 star</option></select></div>' +
                '<div class="tekntek-review-form-row"><label for="tekntek-review-title">Title</label><input id="tekntek-review-title" type="text" maxlength="120" placeholder="Review title"></div>' +
                '<div class="tekntek-review-form-row"><label for="tekntek-review-content">Comment</label><textarea id="tekntek-review-content" maxlength="800" placeholder="Share your experience"></textarea></div>' +
                '<div class="tekntek-review-form-actions"><button type="submit" class="tekntek-btn tekntek-btn-buy">Submit review</button><button type="button" id="tekntek-review-cancel" class="tekntek-btn tekntek-btn-cart">Cancel</button></div>' +
            '</form>';
    }

    function renderReviews() {
        var current = reviews.slice(0, visibleReviews);
        reviewList.innerHTML = current.map(function (review, idx) {
            return '<article class="tekntek-review-item">' +
                '<div class="tekntek-rating-stars">' + stars(review.stars) + '</div>' +
                '<div class="tekntek-review-meta">' + esc(review.date) + ' • ' + esc(review.user) + '</div>' +
                '<strong>' + esc(review.title) + '</strong>' +
                '<p>' + esc(review.content) + '</p>' +
                '<p>+ ' + (review.pros || []).map(esc).join('<br>+ ') + '<br>- ' + (review.cons || []).map(esc).join('<br>- ') + '</p>' +
                '<div class="tekntek-review-vote">' +
                    '<button class="tekntek-vote-btn" data-role="vote" data-type="up" data-index="' + idx + '">Helpful (' + Number(review.up || 0) + ')</button> ' +
                    '<button class="tekntek-vote-btn" data-role="vote" data-type="down" data-index="' + idx + '">Not helpful (' + Number(review.down || 0) + ')</button>' +
                '</div>' +
            '</article>';
        }).join('');

        viewMoreBtn.style.display = reviews.length > visibleReviews ? 'inline-flex' : 'none';

        reviewList.querySelectorAll('[data-role="vote"]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                if (!isLoggedIn) {
                    window.location.href = loginUrl;
                    return;
                }
                var index = Number(btn.getAttribute('data-index'));
                var type = btn.getAttribute('data-type');
                if (!reviews[index]) {
                    return;
                }
                if (type === 'up') {
                    reviews[index].up += 1;
                } else {
                    reviews[index].down += 1;
                }
                renderReviews();
                renderReviewSummary();
                bindAddReview();
            });
        });
    }

    function bindAddReview() {
        var btn = document.getElementById('tekntek-add-review');
        var form = document.getElementById('tekntek-review-form');
        var cancel = document.getElementById('tekntek-review-cancel');
        if (!btn) {
            return;
        }
        btn.addEventListener('click', function () {
            if (!isLoggedIn) {
                window.location.href = loginUrl;
                return;
            }
            if (!form) {
                return;
            }
            form.classList.add('is-open');
        });

        if (!form) {
            return;
        }

        form.addEventListener('submit', function (event) {
            event.preventDefault();
            var starNode = document.getElementById('tekntek-review-stars');
            var titleNode = document.getElementById('tekntek-review-title');
            var contentNode = document.getElementById('tekntek-review-content');
            var starsValue = Number(starNode && starNode.value ? starNode.value : 5);
            var titleValue = titleNode ? titleNode.value.trim() : '';
            var contentValue = contentNode ? contentNode.value.trim() : '';

            if (contentValue === '') {
                return;
            }

            reviews.unshift({
                stars: Math.max(1, Math.min(5, starsValue)),
                date: new Date().toLocaleDateString('en-GB'),
                user: 'You',
                title: titleValue !== '' ? titleValue : 'New review',
                content: contentValue,
                pros: ['Posted by logged-in customer'],
                cons: ['No cons yet'],
                up: 0,
                down: 0
            });
            visibleReviews = Math.max(visibleReviews, 2);
            if (titleNode) {
                titleNode.value = '';
            }
            if (contentNode) {
                contentNode.value = '';
            }
            renderReviews();
            renderReviewSummary();
            bindAddReview();
        });

        if (cancel) {
            cancel.addEventListener('click', function () {
                form.classList.remove('is-open');
            });
        }
    }

    function bindViewMore() {
        viewMoreBtn.addEventListener('click', function () {
            visibleReviews += reviewStep;
            renderReviews();
        });
    }

    renderCards();
    renderReviewSummary();
    renderReviews();
    compareState = loadCompareState();
    bindAddReview();
    bindViewMore();
    addMainCompareBtn.addEventListener('click', function () {
        if (!mainProduct || !mainProduct.id) {
            return;
        }
        addToCompare({
            id: mainProduct.id,
            name: mainProduct.name,
            image: mainProduct.image,
            price: mainProduct.price,
            category_ids: mainProduct.category_ids
        });
    });
    compareLink.addEventListener('click', function (event) {
        event.preventDefault();
        if (!compareState.length) {
            window.location.href = compareLink.href;
            return;
        }
        var ids = compareState.map(function (item) { return Number(item.id); }).filter(function (id) { return id > 0; });
        var nextUrl = new URL(compareLink.href, window.location.origin);
        nextUrl.searchParams.set('ids', ids.join(','));
        setCompareError('Syncing compare list...');
        syncMagentoCompare().then(function () {
            setCompareError('');
            window.location.href = nextUrl.toString();
        });
    });
    renderCompare();
})();
</script>

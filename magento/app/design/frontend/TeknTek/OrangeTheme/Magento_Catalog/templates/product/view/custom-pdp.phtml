$findFirstValue = static function (\Magento\Catalog\Model\Product $source, array $codes): string {
    foreach ($codes as $code) {
        $raw = $source->getData($code);
        if (is_array($raw)) {
            $raw = implode(', ', array_map('strval', $raw));
        } elseif (is_bool($raw)) {
            $raw = $raw ? 'Yes' : 'No';
        } elseif (!is_scalar($raw) && $raw !== null) {
            $raw = '';
        }
        $value = trim((string) $raw);
        if ($value !== '') {
            return $value;
        }
    }
    return '';
};


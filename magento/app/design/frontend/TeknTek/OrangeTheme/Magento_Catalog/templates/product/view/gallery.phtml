<div class="tekntek-pdp-gallery" data-role="tekntek-pdp-gallery">
    <div class="tekntek-pdp-gallery__stage-wrap">
        <button type="button" class="tekntek-pdp-gallery__arrow tekntek-pdp-gallery__arrow--prev" data-action="prev" aria-label="Previous image">&#8249;</button>
        <img class="tekntek-pdp-gallery__stage" data-role="stage" src="<?= $escaper->escapeUrl((string) $active['full']) ?>" alt="<?= $escaper->escapeHtmlAttr((string) $active['alt']) ?>" />
        <button type="button" class="tekntek-pdp-gallery__arrow tekntek-pdp-gallery__arrow--next" data-action="next" aria-label="Next image">&#8250;</button>
    </div>

    <div class="tekntek-pdp-gallery__thumbs" role="listbox" aria-label="Product image thumbnails">
        <?php foreach ($galleryItems as $index => $item): ?>
            <button
                type="button"
                class="tekntek-pdp-gallery__thumb<?= $index === $mainIndex ? ' is-active' : '' ?>"
                data-role="thumb"
                data-full="<?= $escaper->escapeUrl((string) $item['full']) ?>"
                data-alt="<?= $escaper->escapeHtmlAttr((string) $item['alt']) ?>"
                aria-selected="<?= $index === $mainIndex ? 'true' : 'false' ?>"
            >
                <img src="<?= $escaper->escapeUrl((string) $item['thumb']) ?>" alt="<?= $escaper->escapeHtmlAttr((string) $item['alt']) ?>" loading="lazy" />
            </button>
        <?php endforeach; ?>
    </div>

    <link itemprop="image" href="<?= $escaper->escapeUrl((string) $active['full']) ?>" />
</div>

<script>
(function () {
    var galleries = document.querySelectorAll('[data-role="tekntek-pdp-gallery"]');

    galleries.forEach(function (gallery) {
        var stage = gallery.querySelector('[data-role="stage"]');
        var thumbs = Array.prototype.slice.call(gallery.querySelectorAll('[data-role="thumb"]'));
        var prev = gallery.querySelector('[data-action="prev"]');
        var next = gallery.querySelector('[data-action="next"]');
        var imageLink = gallery.querySelector('link[itemprop="image"]');
        var current = Math.max(0, thumbs.findIndex(function (thumb) {
            return thumb.classList.contains('is-active');
        }));

        if (!stage || thumbs.length === 0) {
            return;
        }

        function render(index) {
            var safeIndex = (index + thumbs.length) % thumbs.length;
            var activeThumb = thumbs[safeIndex];
            var full = activeThumb.getAttribute('data-full') || '';
            var alt = activeThumb.getAttribute('data-alt') || 'Product image';

            current = safeIndex;
            stage.src = full;
            stage.alt = alt;

            if (imageLink) {
                imageLink.setAttribute('href', full);
            }

            thumbs.forEach(function (thumb, idx) {
                var isActive = idx === safeIndex;
                thumb.classList.toggle('is-active', isActive);
                thumb.setAttribute('aria-selected', isActive ? 'true' : 'false');
            });
        }

        thumbs.forEach(function (thumb, idx) {
            thumb.addEventListener('click', function () {
                render(idx);
            });
        });

        if (prev) {
            prev.addEventListener('click', function () {
                render(current - 1);
            });
        }

        if (next) {
            next.addEventListener('click', function () {
                render(current + 1);
            });
        }

        render(current);
    });
})();
</script>

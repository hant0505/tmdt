<?php
/**
 * @var $block \Magento\Catalog\Block\Product\View\Gallery
 * @var $escaper \Magento\Framework\Escaper
 */

$images = $block->getGalleryImages()->getItems();
$helper = $block->getData('imageHelper');

$galleryItems = [];
$mainIndex = 0;
$idx = 0;
$seenImageKeys = [];

foreach ($images as $image) {
    $full = (string) ($image->getData('large_image_url') ?: $image->getData('medium_image_url'));
    $thumb = (string) ($image->getData('small_image_url') ?: $image->getData('medium_image_url'));
    $file = (string) $image->getData('file');

    if ($full === '') {
        continue;
    }

    if ($thumb === '') {
        $thumb = $full;
    }

    // Some imported products contain duplicated files like image.jpg and image_1.jpg.
    // Normalize trailing "_1" chains to keep only one thumbnail per logical image.
    $sourceForKey = $file !== '' ? basename($file) : basename(parse_url($full, PHP_URL_PATH) ?: $full);
    $normalizedKey = strtolower((string) preg_replace('/(_1)+(\.[a-z0-9]+)$/i', '$2', $sourceForKey));
    if (isset($seenImageKeys[$normalizedKey])) {
        continue;
    }
    $seenImageKeys[$normalizedKey] = true;

    $alt = (string) ($image->getLabel() ?: $block->getProduct()->getName() ?: 'Product image');

    $galleryItems[] = [
        'full' => $full,
        'thumb' => $thumb,
        'alt' => $alt
    ];

    if ($block->isMainImage($image)) {
        $mainIndex = $idx;
    }

    $idx++;
}

if (empty($galleryItems)) {
    $fallback = (string) $helper->getDefaultPlaceholderUrl('image');
    $galleryItems[] = [
        'full' => $fallback,
        'thumb' => $fallback,
        'alt' => (string) ($block->getProduct()->getName() ?: 'Product image')
    ];
    $mainIndex = 0;
}

$active = $galleryItems[$mainIndex] ?? $galleryItems[0];
?>


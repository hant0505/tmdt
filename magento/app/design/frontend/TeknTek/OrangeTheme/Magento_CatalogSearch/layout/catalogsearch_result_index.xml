<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      layout="2columns-left"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <attribute name="class" value="page-products tekntek-search-results"/>

        <referenceBlock name="search.result" template="Magento_CatalogSearch::result.phtml"/>
        <referenceBlock name="search_result_list" template="Magento_Catalog::product/list.phtml"/>

        <move element="wishlist_sidebar" destination="sidebar.main" after="catalog.leftnav"/>
    </body>
</page>

<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="checkout" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- Render the theme header inside checkout; checkout layout does not include the standard header container. -->
        <referenceBlock name="logo" remove="true"/>
        <referenceBlock name="tekntek.header" remove="true"/>
        <referenceContainer name="checkout.header.wrapper">
            <block class="Magento\Framework\View\Element\Template"
                   name="tekntek.checkout.header"
                   template="Magento_Theme::html/tekntek-header.phtml"/>
        </referenceContainer>

        <move element="minicart" destination="tekntek.checkout.header" as="minicart"/>

        <!-- Render custom footer below checkout content -->
        <referenceContainer name="page.wrapper">
            <container name="tekntek.checkout.footer.container"
                       htmlTag="div"
                       htmlClass="tekntek-checkout-footer-container"
                       after="main.content">
                <block class="Magento\Framework\View\Element\Template"
                       name="tekntek.checkout.footer"
                       template="Magento_Theme::html/tekntek-footer.phtml"/>
            </container>
        </referenceContainer>

        <!-- Checkout Content -->
        <referenceBlock name="checkout.root">
            <arguments>
                <argument name="jsLayout" xsi:type="array">
                    <item name="components" xsi:type="array">
                        <item name="checkout" xsi:type="array">
                            <item name="children" xsi:type="array">
                                <item name="steps" xsi:type="array">
                                    <item name="children" xsi:type="array">
                                        <item name="billing-step" xsi:type="array">
                                            <item name="children" xsi:type="array">
                                                <item name="payment" xsi:type="array">
                                                    <item name="children" xsi:type="array">
                                                        <item name="beforeMethods" xsi:type="array">
                                                            <item name="children" xsi:type="array">
                                                                <item name="tekntek-payment-selector" xsi:type="array">
                                                                    <item name="component" xsi:type="string">Magento_Checkout/js/view/payment-selection</item>
                                                                    <item name="sortOrder" xsi:type="string">5</item>
                                                                </item>
                                                                <!-- Temporarily disabled to test the default Magento payment step -->
                                                            </item>
                                                        </item>
                                                    </item>
                                                </item>
                                            </item>
                                        </item>
                                    </item>
                                </item>
                            </item>
                        </item>
                    </item>
                </argument>
            </arguments>
        </referenceBlock>
    </body>
</page>

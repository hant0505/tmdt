<?php
/** @var \Magento\Checkout\Block\Cart\Grid $block */
$quote = $block->getQuote();
$currencyCode = (string) $quote->getQuoteCurrencyCode();

$formatPrice = static function (float $amount, string $currencyCode): string {
    return $currencyCode . ' ' . number_format($amount, 2, '.', ',');
};
?>
<section class="tekntek-cart container" aria-label="Shopping cart section">
    <nav class="tekntek-cart__breadcrumbs" aria-label="Breadcrumb">
        <a href="<?= $block->escapeUrl($block->getUrl('')) ?>"><?= $block->escapeHtml(__('Home')) ?></a>
        <span class="separator" aria-hidden="true">&gt;</span>
        <span class="current" aria-current="page"><?= $block->escapeHtml(__('Shopping cart')) ?></span>
    </nav>

    <div class="tekntek-cart__layout">
        <article class="tekntek-cart__items" aria-label="Items">
            <?php foreach ($block->getItems() as $item): ?>
                <?php
                $product = $item->getProduct();
                $name = (string) $item->getName();
                $sku = (string) $item->getSku();
                $qty = (float) $item->getQty();
                $rowTotal = (float) ($item->getRowTotalInclTax() ?: $item->getRowTotal());
                $unitPrice = (float) ($item->getCalculationPriceInclTax() ?: $item->getCalculationPrice());
                $productUrl = ($product && $product->isVisibleInSiteVisibility()) ? $product->getProductUrl() : '';
                ?>
                <div class="tekntek-item">
                    <div class="tekntek-item__image" aria-hidden="true"></div>
                    <div class="tekntek-item__meta">
                        <p class="tekntek-item__name">
                            <?php if ($productUrl): ?>
                                <a href="<?= $block->escapeUrl($productUrl) ?>"><?= $block->escapeHtml($name) ?></a>
                            <?php else: ?>
                                <?= $block->escapeHtml($name) ?>
                            <?php endif; ?>
                        </p>
                        <p class="tekntek-item__desc">
                            <?= $block->escapeHtml(__('SKU: %1', $sku)) ?>
                        </p>
                        <div class="tekntek-item__qty-row">
                            <div class="qty-input-group">
                                <button type="button" class="qty-btn qty-minus" data-item-id="<?= $block->escapeHtmlAttr($item->getId()) ?>">−</button>
                                <input type="number" 
                                       class="qty-input" 
                                       value="<?= (int) $qty ?>" 
                                       min="1" 
                                       data-item-id="<?= $block->escapeHtmlAttr($item->getId()) ?>"
                                       data-action="update-qty">
                                <button type="button" class="qty-btn qty-plus" data-item-id="<?= $block->escapeHtmlAttr($item->getId()) ?>">+</button>
                            </div>
                            <button type="button" class="btn-delete-item" data-item-id="<?= $block->escapeHtmlAttr($item->getId()) ?>" title="<?= $block->escapeHtmlAttr(__('Remove item')) ?>">
                                <svg width="18" height="18" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M2 5h16M8 9v6M12 9v6M3 5l1 12c0 1 1 2 2 2h8c1 0 2-1 2-2l1-12M7 5V3c0-1 1-1 1-1h4c1 0 1 0 1 1v2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </button>
                        </div>
                        <div class="tekntek-item__price">
                            <span class="old"><?= $block->escapeHtml($formatPrice($unitPrice, $currencyCode)) ?></span>
                            <span class="new"><?= $block->escapeHtml($formatPrice($rowTotal, $currencyCode)) ?></span>
                        </div>
                    </div>
                </div>
            <?php endforeach; ?>
        </article>
    </div>
</section>

<!-- Cart item quantity and delete handlers -->
<script type="text/javascript">
require(['jquery'], function($) {
    'use strict';

    function getFormKey() {
        var cookieMatch;

        if (window.FORM_KEY) {
            return window.FORM_KEY;
        }

        cookieMatch = document.cookie.match(/(?:^|; )form_key=([^;]+)/);
        return cookieMatch ? decodeURIComponent(cookieMatch[1]) : '';
    }

    function updateCartItemQty(itemId, qty) {
        var payload = {
            item_id: itemId,
            item_qty: qty,
            form_key: getFormKey()
        };

        return $.ajax({
            url: '<?= $block->escapeUrl($block->getUrl('checkout/sidebar/updateItemQty')) ?>',
            type: 'POST',
            data: payload,
            showLoader: true
        });
    }
    
    $(document).ready(function() {
        // Handle +/- quantity buttons
        $(document).on('click', '.qty-minus, .qty-plus', function(e) {
            e.preventDefault();
            var $btn = $(this);
            var itemId = $btn.data('item-id');
            var $input = $('input[data-item-id="' + itemId + '"]');
            var currentQty = parseInt($input.val(), 10) || 1;
            var newQty = currentQty;
            
            if ($btn.hasClass('qty-minus')) {
                if (currentQty > 1) {
                    newQty = currentQty - 1;
                }
            } else if ($btn.hasClass('qty-plus')) {
                newQty = currentQty + 1;
            }

            if (newQty !== currentQty) {
                $input.val(newQty);
                updateCartItemQty(itemId, newQty)
                    .done(function(response) {
                        if (response && response.error_message) {
                            $input.val(currentQty);
                            alert(response.error_message);
                            return;
                        }
                        location.reload();
                    })
                    .fail(function() {
                        $input.val(currentQty);
                        alert('Error updating cart. Please try again.');
                    });
            }
        });
        
        // Handle quantity input change - update via AJAX
        $(document).on('change', '.qty-input', function() {
            var $input = $(this);
            var itemId = $input.data('item-id');
            var newQty = parseInt($input.val(), 10);
            
            if (newQty < 1) {
                $input.val(1);
                newQty = 1;
            }

            updateCartItemQty(itemId, newQty)
                .done(function(response) {
                    if (response && response.error_message) {
                        alert(response.error_message);
                        return;
                    }
                    location.reload();
                })
                .fail(function() {
                    alert('Error updating cart. Please try again.');
                });
        });
        
        // Handle delete button
        $(document).on('click', '.btn-delete-item', function(e) {
            e.preventDefault();
            if (confirm('<?= $block->escapeJs(__('Are you sure you want to remove this item?')) ?>')) {
                var itemId = $(this).data('item-id');
                
                $.ajax({
                    url: '<?= $block->escapeUrl($block->getUrl('checkout/cart/delete')) ?>',
                    type: 'POST',
                    data: {
                        'item_id': itemId
                    },
                    showLoader: true,
                    success: function(res) {
                        location.reload();
                    },
                    error: function() {
                        alert('Error removing item. Please try again.');
                    }
                });
            }
        });
    });
});
</script>

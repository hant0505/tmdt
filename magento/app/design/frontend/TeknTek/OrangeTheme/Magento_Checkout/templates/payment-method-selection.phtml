<script>
require(['jquery', 'uiComponent'], function($) {
    // Show form only on Payment step
    var formElement = $('[data-payment-form]');
    
    // Listen to checkout step changes
    if (window.checkoutConfig && window.checkoutConfig.quoteData) {
        // Check if payment step is active
        $(document).on('checkout:step-show', function(event, step) {
            if (step === 'payment') {
                formElement.slideDown(300);
            } else {
                formElement.slideUp(300);
            }
        });
    }
    
    // Alternative: Check current step periodically
    var checkStep = setInterval(function() {
        var paymentStep = $('.checkout-index-index [data-step-id="payment"]').length > 0 || 
                         $('._show[data-bind*="payment"]').length > 0 ||
                         $('#opc-payment').is(':visible') ||
                         $('.opc-block-payment').is(':visible');
        
        if (paymentStep) {
            formElement.show();
        } else {
            formElement.hide();
        }
    }, 500);
    
    // Toggle between payment method details
    $(document).on('change', '.payment-radio', function() {
        var method = $(this).val();
        if (method === 'bank_transfer') {
            $('#bank-transfer-details').slideDown(300);
            $('#cod-details').slideUp(300);
        } else if (method === 'cashondelivery') {
            $('#bank-transfer-details').slideUp(300);
            $('#cod-details').slideDown(300);
        }
    });

    // Initialize with Bank Transfer checked
    $('#bank-transfer-details').show();
    $('#cod-details').hide();
});
</script>

$productCollectionFactory = $objectManager->get(\Magento\Catalog\Model\ResourceModel\Product\CollectionFactory::class);
$priceHelper = $objectManager->get(\Magento\Framework\Pricing\Helper\Data::class);
$imageHelper = $objectManager->get(\Magento\Catalog\Helper\Image::class);
$mediaConfig = $objectManager->get(\Magento\Catalog\Model\Product\Media\Config::class);
$placeholderImage = $block->getViewFileUrl('Magento_Catalog::images/product/placeholder/small_image.jpg');

$productCollection = $productCollectionFactory->create();
$productCollection->addAttributeToSelect(['name', 'small_image', 'price', 'final_price', 'status', 'visibility']);
$productCollection->addAttributeToFilter('status', \Magento\Catalog\Model\Product\Attribute\Source\Status::STATUS_ENABLED);
$productCollection->addAttributeToFilter(
    'visibility',
    ['in' => [
        \Magento\Catalog\Model\Product\Visibility::VISIBILITY_IN_CATALOG,
        \Magento\Catalog\Model\Product\Visibility::VISIBILITY_IN_SEARCH,
        \Magento\Catalog\Model\Product\Visibility::VISIBILITY_BOTH
    ]]
);
$productCollection->setPageSize(16);
$productCollection->setCurPage(1);
$productCollection->addMediaGalleryData();

$realCards = [];
foreach ($productCollection as $product) {
    $regularPrice = (float) $product->getPrice();
    $finalPrice = (float) $product->getFinalPrice();
    if ($finalPrice <= 0) {
        continue;
    }

    $discountLabel = '';
    if ($regularPrice > 0 && $finalPrice < $regularPrice) {
        $percent = (int) round((($regularPrice - $finalPrice) / $regularPrice) * 100);
        if ($percent > 0) {
            $discountLabel = $percent . '%';
        }
    }

    $imageUrl = '';
    try {
        $imageUrl = (string) $imageHelper->init($product, 'product_small_image')->getUrl();
    } catch (\Throwable $e) {
        $imageUrl = '';
    }
    if ($imageUrl === '') {
        $imageUrl = $placeholderImage;
    }

    $secondaryImageUrl = '';
    $galleryImages = $product->getMediaGalleryImages();
    if ($galleryImages && $galleryImages->getSize() > 0) {
        foreach ($galleryImages as $galleryImage) {
            $galleryFile = (string) $galleryImage->getFile();
            if ($galleryFile === '') {
                continue;
            }

            $candidateUrl = (string) $mediaConfig->getMediaUrl($galleryFile);
            if ($candidateUrl !== '' && $candidateUrl !== $imageUrl) {
                $secondaryImageUrl = $candidateUrl;
                break;
            }
        }
    }

    $realCards[] = [
        'id' => (int) $product->getId(),
        'name' => (string) $product->getName(),
        'image' => $imageUrl,
        'secondary_image' => $secondaryImageUrl,
        'old' => $regularPrice > $finalPrice ? $priceHelper->currency($regularPrice, true, false) : '',
        'price' => $priceHelper->currency($finalPrice, true, false),
        'compare_price' => $finalPrice,
        'discount' => $discountLabel,
        'reviews' => 0,
        'url' => (string) $product->getProductUrl()
    ];
}

$fallbackCards = [[
    'id' => 0,
    'name' => 'View Products',
    'image' => $placeholderImage,
    'secondary_image' => '',
    'old' => '',
    'price' => '',
    'compare_price' => 0,
    'discount' => '',
    'reviews' => 0,
    'url' => $block->getUrl('catalogsearch/result')
]];

$cardsPool = !empty($realCards) ? $realCards : $fallbackCards;
$offersData = array_slice($cardsPool, 0, 4);
$cardsData = array_slice($cardsPool, 4, 4);
if (empty($cardsData)) {
    $cardsData = $offersData;
}

$searchSuggestionItems = [];
try {
    $searchCollection = $productCollectionFactory->create();
    $searchCollection->addAttributeToSelect(['name', 'sku', 'small_image', 'price', 'final_price', 'status', 'visibility']);
    $searchCollection->addAttributeToFilter('status', \Magento\Catalog\Model\Product\Attribute\Source\Status::STATUS_ENABLED);
    $searchCollection->addAttributeToFilter(
        'visibility',
        ['in' => [
            \Magento\Catalog\Model\Product\Visibility::VISIBILITY_IN_CATALOG,
            \Magento\Catalog\Model\Product\Visibility::VISIBILITY_IN_SEARCH,
            \Magento\Catalog\Model\Product\Visibility::VISIBILITY_BOTH
        ]]
    );
    $searchCollection->setPageSize(180);
    $searchCollection->setCurPage(1);

    foreach ($searchCollection as $product) {
        $imageUrl = '';
        try {
            $imageUrl = (string) $imageHelper->init($product, 'product_small_image')->getUrl();
        } catch (\Throwable $e) {
            $imageUrl = '';
        }
        if ($imageUrl === '') {
            $imageUrl = $placeholderImage;
        }

        $finalPrice = (float) $product->getFinalPrice();
        $searchSuggestionItems[] = [
            'name' => (string) $product->getName(),
            'sku' => (string) $product->getSku(),
            'image' => $imageUrl,
            'url' => (string) $product->getProductUrl(),
            'price' => $finalPrice > 0 ? $priceHelper->currency($finalPrice, true, false) : ''
        ];
    }
} catch (\Throwable $e) {
    $searchSuggestionItems = [];
}

if (empty($searchSuggestionItems)) {
    $searchSuggestionItems = array_map(static function (array $item): array {
        return [
            'name' => $item['name'] ?? '',
            'sku' => '',
            'image' => $item['image'] ?? '',
            'url' => $item['url'] ?? '',
            'price' => $item['price'] ?? ''
        ];
    }, $realCards);
}

$homepageData = [
    'offers' => $offersData,
    'searchSuggestions' => array_slice($searchSuggestionItems, 0, 120),
    'sections' => [
        'Laptop', 'Smartphone', 'Tablet', 'Audio & Headphones', 'Smart Watch', 'Camera', 'Monitors', 'Keyboards', 'Computer Mices', 'Hard Drives'
    ],
    'cards' => $cardsData
];
?>

<script type="application/json" id="ttk-data-json">
<?= /* @noEscape */ json_encode($homepageData, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) ?>
</script>

<script>
(function () {
    var allProductsToggle = document.getElementById('ttk-all-products-toggle');
    var categoryLayer = document.getElementById('ttk-icon-layer');
    var closeLayerTimer = null;

    if (allProductsToggle && categoryLayer) {
        function openLayer() {
            if (closeLayerTimer) {
                window.clearTimeout(closeLayerTimer);
                closeLayerTimer = null;
            }
            categoryLayer.hidden = false;
            window.requestAnimationFrame(function () {
                categoryLayer.classList.add('is-open');
                allProductsToggle.setAttribute('aria-expanded', 'true');
            });
        }

        function closeLayer() {
            categoryLayer.classList.remove('is-open');
            allProductsToggle.setAttribute('aria-expanded', 'false');
            if (closeLayerTimer) {
                window.clearTimeout(closeLayerTimer);
            }
            closeLayerTimer = window.setTimeout(function () {
                if (!categoryLayer.classList.contains('is-open')) {
                    categoryLayer.hidden = true;
                }
            }, 240);
        }

        allProductsToggle.addEventListener('click', function (event) {
            event.preventDefault();
            if (categoryLayer.classList.contains('is-open')) {
                closeLayer();
            } else {
                openLayer();
            }
        });

        document.addEventListener('click', function (event) {
            var clickInsideLayer = categoryLayer.contains(event.target);
            var clickOnToggle = allProductsToggle.contains(event.target);
            if (!clickInsideLayer && !clickOnToggle && categoryLayer.classList.contains('is-open')) {
                closeLayer();
            }
        });
    }

    var dataNode = document.getElementById('ttk-data-json');
    var offersNode = document.getElementById('ttk-offers');
    var productsNode = document.getElementById('ttk-products');

    if (!dataNode || !offersNode || !productsNode) {
        return;
    }

    var data = JSON.parse(dataNode.textContent);

    var homeSearchForm = document.getElementById('search_mini_form');
    var homeSearchInput = document.getElementById('search');
    var homeSearchPreview = document.getElementById('ttk-search-preview-home');
    var searchSuggestions = Array.isArray(data.searchSuggestions) ? data.searchSuggestions : [];

    function escapeHtml(value) {
        return String(value || '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    function normalizeText(value) {
        var text = String(value || '').toLowerCase();
        if (typeof text.normalize === 'function') {
            text = text.normalize('NFD').replace(/[\u0300-\u036f]/g, '');
        }
        return text;
    }

    function hideSearchPreview() {
        if (!homeSearchPreview) {
            return;
        }
        homeSearchPreview.innerHTML = '';
        homeSearchPreview.hidden = true;
    }

    function renderSearchPreview(query) {
        if (!homeSearchPreview) {
            return;
        }

        var tokens = normalizeText(query).split(/\s+/).filter(Boolean);
        if (!tokens.length) {
            hideSearchPreview();
            return;
        }

        var matches = searchSuggestions.map(function (item) {
            var name = item && item.name ? item.name : '';
            var sku = item && item.sku ? item.sku : '';
            var normalizedName = normalizeText(name);
            var haystack = normalizedName + ' ' + normalizeText(sku);
            var isMatch = tokens.every(function (token) {
                return haystack.indexOf(token) !== -1;
            });

            if (!isMatch) {
                return null;
            }

            var score = 0;
            if (tokens.length && normalizedName.indexOf(tokens[0]) === 0) {
                score += 3;
            }
            score += tokens.reduce(function (acc, token) {
                return acc + (normalizedName.indexOf(token) !== -1 ? 1 : 0);
            }, 0);

            return {
                item: item,
                score: score,
                nameLength: normalizedName.length
            };
        }).filter(function (entry) {
            return !!entry;
        }).sort(function (a, b) {
            if (b.score !== a.score) {
                return b.score - a.score;
            }
            return a.nameLength - b.nameLength;
        }).slice(0, 6).map(function (entry) {
            return entry.item;
        });

        if (!matches.length) {
            hideSearchPreview();
            return;
        }

        homeSearchPreview.innerHTML = matches.map(function (item) {
            return '' +
                '<a href="' + escapeHtml(item.url || '#') + '">' +
                    '<img src="' + escapeHtml(item.image || '') + '" alt="' + escapeHtml(item.name || '') + '" loading="lazy" />' +
                    '<span class="ttk-search-preview-meta">' +
                        '<span class="ttk-search-preview-name">' + escapeHtml(item.name || '') + '</span>' +
                        (item.price ? '<span class="ttk-search-preview-price">' + escapeHtml(item.price) + '</span>' : '') +
                    '</span>' +
                '</a>';
        }).join('');

        homeSearchPreview.hidden = false;
    }

    if (homeSearchForm && homeSearchInput && homeSearchPreview) {
        homeSearchInput.addEventListener('input', function () {
            renderSearchPreview(homeSearchInput.value);
        });

        homeSearchInput.addEventListener('focus', function () {
            if ((homeSearchInput.value || '').trim().length >= 1) {
                renderSearchPreview(homeSearchInput.value);
            }
        });

        homeSearchForm.addEventListener('submit', function () {
            hideSearchPreview();
        });

        document.addEventListener('click', function (event) {
            if (!homeSearchForm.contains(event.target)) {
                hideSearchPreview();
            }
        });
    }

    function normalizeName(name) {
        return name.toLowerCase().replace(/\s+/g, '-').replace(/&/g, 'and');
    }

    var sectionIconMap = {
        'laptop': '<?= $block->escapeUrl($block->getViewFileUrl('images/categories/laptop.png')) ?>',
        'smartphone': '<?= $block->escapeUrl($block->getViewFileUrl('images/categories/smartphone.png')) ?>',
        'tablet': '<?= $block->escapeUrl($block->getViewFileUrl('images/categories/tablet.png')) ?>?v=20260407-1',
        'audio-and-headphones': '<?= $block->escapeUrl($block->getViewFileUrl('images/categories/headphones.png')) ?>',
        'smart-watch': '<?= $block->escapeUrl($block->getViewFileUrl('images/categories/smartwatch.png')) ?>',
        'camera': '<?= $block->escapeUrl($block->getViewFileUrl('images/categories/camera.png')) ?>',
        'monitors': '<?= $block->escapeUrl($block->getViewFileUrl('images/categories/monitor.png')) ?>',
        'keyboards': '<?= $block->escapeUrl($block->getViewFileUrl('images/categories/keyboard-cropped.png')) ?>',
        'computer-mices': '<?= $block->escapeUrl($block->getViewFileUrl('images/categories/mouse.png')) ?>',
        'hard-drives': '<?= $block->escapeUrl($block->getViewFileUrl('images/categories/hard-drive.png')) ?>'
    };

    function stars() {
        return '<span>★★★★★</span>';
    }

    function cardTemplate(item) {
        var badge = item.discount ? '<span class="ttk-badge">' + item.discount + '</span>' : '';
        var openLink = item.url ? '<a class="ttk-card-link" href="' + item.url + '">' : '';
        var closeLink = item.url ? '</a>' : '';
        var secondaryImage = item.secondary_image ? '<img class="ttk-card-image-secondary" src="' + item.secondary_image + '" alt="' + item.name + '" loading="lazy"/>' : '';
        return '<article class="ttk-card">' +
            openLink +
            '<div class="ttk-card-image">' + badge + '<img class="ttk-card-image-primary" src="' + item.image + '" alt="' + item.name + '" loading="lazy"/>' + secondaryImage + '</div>' +
            '<div class="ttk-card-title">' + item.name + '</div>' +
            '<div class="ttk-card-price"><span class="ttk-card-old">' + item.old + '</span><span class="ttk-card-new">' + item.price + '</span></div>' +
            '<div class="ttk-card-rating">' + stars() + ' (' + item.reviews + ')</div>' +
            closeLink +
            '</article>';
    }

    offersNode.innerHTML = data.offers.map(cardTemplate).join('');

    productsNode.innerHTML = data.sections.map(function (name) {
        var iconName = normalizeName(name);
        var sectionIconUrl = sectionIconMap[iconName] || ('icon-' + iconName + '.svg');
        var sectionIconModifierMap = {
            'computer-mices': 'ttk-section-icon--mice',
            'keyboards': 'ttk-section-icon--keyboard',
            'hard-drives': 'ttk-section-icon--hard-drive'
        };
        var sectionIconModifier = sectionIconModifierMap[iconName] || '';
        var sectionIconClass = 'ttk-section-icon' + (sectionIconModifier ? ' ' + sectionIconModifier : '');
        return '<section class="ttk-product-section">' +
            '<div class="ttk-heading"><h3><img class="' + sectionIconClass + '" src="' + sectionIconUrl + '" alt=""/>' + name + '</h3><a href="<?= $block->escapeUrl($block->getUrl('catalogsearch/result')) ?>">View all ⓘ</a></div>' +
            '<div class="ttk-product-grid">' + data.cards.map(function (card) {
                return cardTemplate(card);
            }).join('') + '</div>' +
            '</section>';
    }).join('');

})();
</script>

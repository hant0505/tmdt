<script>
(function () {
    var dataNode = document.getElementById('ttk-data-json');
    var offersNode = document.getElementById('ttk-offers');
    var productsNode = document.getElementById('ttk-products');

    if (!dataNode || !offersNode || !productsNode) {
        return;
    }

    var data = JSON.parse(dataNode.textContent);
    var cartConfig = data.cart || {};

    var homeSearchForm = document.getElementById('search_mini_form');
    var homeSearchInput = document.getElementById('search');
    var homeSearchPreview = document.getElementById('ttk-search-preview-home');
    var searchSuggestions = Array.isArray(data.searchSuggestions) ? data.searchSuggestions : [];

    function escapeHtml(value) {
        return String(value || '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    function normalizeText(value) {
        var text = String(value || '').toLowerCase();
        if (typeof text.normalize === 'function') {
            text = text.normalize('NFD').replace(/[\u0300-\u036f]/g, '');
        }
        return text;
    }

    function hideSearchPreview() {
        if (!homeSearchPreview) {
            return;
        }
        homeSearchPreview.innerHTML = '';
        homeSearchPreview.hidden = true;
    }

    function renderSearchPreview(query) {
        if (!homeSearchPreview) {
            return;
        }

        var tokens = normalizeText(query).split(/\s+/).filter(Boolean);
        if (!tokens.length) {
            hideSearchPreview();
            return;
        }

        var matches = searchSuggestions.map(function (item) {
            var name = item && item.name ? item.name : '';
            var sku = item && item.sku ? item.sku : '';
            var normalizedName = normalizeText(name);
            var haystack = normalizedName + ' ' + normalizeText(sku);
            var isMatch = tokens.every(function (token) {
                return haystack.indexOf(token) !== -1;
            });

            if (!isMatch) {
                return null;
            }

            var score = 0;
            if (tokens.length && normalizedName.indexOf(tokens[0]) === 0) {
                score += 3;
            }
            score += tokens.reduce(function (acc, token) {
                return acc + (normalizedName.indexOf(token) !== -1 ? 1 : 0);
            }, 0);

            return {
                item: item,
                score: score,
                nameLength: normalizedName.length
            };
        }).filter(function (entry) {
            return !!entry;
        }).sort(function (a, b) {
            if (b.score !== a.score) {
                return b.score - a.score;
            }
            return a.nameLength - b.nameLength;
        }).slice(0, 6).map(function (entry) {
            return entry.item;
        });

        if (!matches.length) {
            hideSearchPreview();
            return;
        }

        homeSearchPreview.innerHTML = matches.map(function (item) {
            return '' +
                '<a href="' + escapeHtml(item.url || '#') + '">' +
                    '<img src="' + escapeHtml(item.image || '') + '" alt="' + escapeHtml(item.name || '') + '" loading="lazy" />' +
                    '<span class="ttk-search-preview-meta">' +
                        '<span class="ttk-search-preview-name">' + escapeHtml(item.name || '') + '</span>' +
                        (item.price ? '<span class="ttk-search-preview-price">' + escapeHtml(item.price) + '</span>' : '') +
                    '</span>' +
                '</a>';
        }).join('');

        homeSearchPreview.hidden = false;
    }

    if (homeSearchForm && homeSearchInput && homeSearchPreview) {
        homeSearchInput.addEventListener('input', function () {
            renderSearchPreview(homeSearchInput.value);
        });

        homeSearchInput.addEventListener('focus', function () {
            if ((homeSearchInput.value || '').trim().length >= 1) {
                renderSearchPreview(homeSearchInput.value);
            }
        });

        homeSearchForm.addEventListener('submit', function () {
            hideSearchPreview();
        });

        document.addEventListener('click', function (event) {
            if (!homeSearchForm.contains(event.target)) {
                hideSearchPreview();
            }
        });
    }

    function normalizeName(name) {
        return name.toLowerCase().replace(/\s+/g, '-').replace(/&/g, 'and');
    }

    var sectionIconMap = {
        'laptops': '<?= $block->escapeUrl($block->getViewFileUrl('images/categories/laptop.png')) ?>',
        'smartphones': '<?= $block->escapeUrl($block->getViewFileUrl('images/categories/smartphone.png')) ?>',
        'tablets': '<?= $block->escapeUrl($block->getViewFileUrl('images/categories/tablet.png')) ?>?v=20260407-1',
        'headphones': '<?= $block->escapeUrl($block->getViewFileUrl('images/categories/headphones.png')) ?>',
        'smartwatches': '<?= $block->escapeUrl($block->getViewFileUrl('images/categories/smartwatch.png')) ?>',
        'cameras': '<?= $block->escapeUrl($block->getViewFileUrl('images/categories/camera.png')) ?>',
        'monitors': '<?= $block->escapeUrl($block->getViewFileUrl('images/categories/monitor.png')) ?>',
        'keyboards': '<?= $block->escapeUrl($block->getViewFileUrl('images/categories/keyboard-cropped.png')) ?>',
        'computer-mice': '<?= $block->escapeUrl($block->getViewFileUrl('images/categories/mouse.png')) ?>',
        'hard-drives': '<?= $block->escapeUrl($block->getViewFileUrl('images/categories/hard-drive.png')) ?>'
    };

    function stars(item) {
        var ratingSummary = Number(item && item.rating_summary ? item.rating_summary : 0);
        var filledStars = Math.max(0, Math.min(5, Math.round(ratingSummary / 20)));
        var emptyStars = Math.max(0, 5 - filledStars);
        return '<span>' + '★'.repeat(filledStars) + '☆'.repeat(emptyStars) + '</span>';
    }

    function cardTemplate(item) {
        var badge = item.discount ? '<span class="ttk-badge">SALE ' + item.discount + '</span>' : '';
        var openLink = item.url ? '<a class="ttk-card-link" href="' + item.url + '">' : '';
        var closeLink = item.url ? '</a>' : '';
        var secondaryImage = item.secondary_image ? '<img class="ttk-card-image-secondary" src="' + item.secondary_image + '" alt="' + item.name + '" loading="lazy"/>' : '';
        var cardClass = 'ttk-card' + (item.secondary_image ? ' ttk-card--has-secondary' : '');
        var productId = Number(item && item.id ? item.id : 0);
        var cartAction = cartConfig.addUrl || '/checkout/cart/add';
        var formKey = cartConfig.formKey || '';
        var uenc = cartConfig.uenc || '';
        var cartBar = productId > 0
            ? '<div class="ttk-card-actions">' +
                '<form class="ttk-card-cart-form" action="' + escapeHtml(cartAction) + '" method="post" data-role="tocart-form" data-mage-init=\'{"catalogAddToCart":{}}\'>' +
                    '<input type="hidden" name="product" value="' + productId + '">' +
                    '<input type="hidden" name="qty" value="1">' +
                    '<input type="hidden" name="form_key" value="' + escapeHtml(formKey) + '">' +
                    '<input type="hidden" name="uenc" value="' + escapeHtml(uenc) + '">' +
                    '<button class="ttk-card-cart" type="submit">Add to Cart</button>' +
                '</form>' +
            '</div>'
            : '';
        var ratingSummary = Number(item && item.rating_summary ? item.rating_summary : 0);
        var ratingValue = ratingSummary > 0 ? (ratingSummary / 20).toFixed(1) : '0.0';
        var reviewsCount = Number(item && item.reviews ? item.reviews : 0);
        var reviewsHtml = reviewsCount > 0
            ? '<div class="ttk-card-rating">' + stars(item) + ' (' + ratingValue + ') <span>(' + reviewsCount + ' reviews)</span></div>'
            : '<div class="ttk-card-rating">No reviews yet</div>';

        return '<article class="' + cardClass + '">' +
            openLink +
            '<div class="ttk-card-image">' + badge + '<img class="ttk-card-image-primary" src="' + item.image + '" alt="' + item.name + '" loading="lazy"/>' + secondaryImage + '</div>' +
            '<div class="ttk-card-title">' + item.name + '</div>' +
            '<div class="ttk-card-price"><span class="ttk-card-old">' + item.old + '</span><span class="ttk-card-new">' + item.price + '</span></div>' +
            reviewsHtml +
            closeLink +
            cartBar +
            '</article>';
    }

    offersNode.innerHTML = data.offers.map(cardTemplate).join('');

    productsNode.innerHTML = data.sections.map(function (section) {
        var name = section && section.name ? section.name : '';
        var cards = Array.isArray(section && section.cards) ? section.cards : [];
        if (!name || !cards.length) {
            return '';
        }

        var iconName = section && section.icon_key ? section.icon_key : normalizeName(name);
        var sectionIconUrl = sectionIconMap[iconName] || ('icon-' + iconName + '.svg');
        var sectionIconModifierMap = {
            'computer-mice': 'ttk-section-icon--mice',
            'keyboards': 'ttk-section-icon--keyboard',
            'hard-drives': 'ttk-section-icon--hard-drive'
        };
        var sectionIconModifier = sectionIconModifierMap[iconName] || '';
        var sectionIconClass = 'ttk-section-icon' + (sectionIconModifier ? ' ' + sectionIconModifier : '');
        return '<section class="ttk-product-section">' +
            '<div class="ttk-heading"><h3><img class="' + sectionIconClass + '" src="' + sectionIconUrl + '" alt=""/>' + name + '</h3><a href="' + escapeHtml(section.url || '#') + '">View all ⓘ</a></div>' +
            '<div class="ttk-product-grid">' + cards.map(function (card) {
                return cardTemplate(card);
            }).join('') + '</div>' +
            '</section>';
    }).join('');

})();
</script>

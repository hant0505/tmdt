$productCollectionFactory = $objectManager->get(\Magento\Catalog\Model\ResourceModel\Product\CollectionFactory::class);
$priceHelper = $objectManager->get(\Magento\Framework\Pricing\Helper\Data::class);
$imageHelper = $objectManager->get(\Magento\Catalog\Helper\Image::class);
$placeholderImage = $block->getViewFileUrl('Magento_Catalog::images/product/placeholder/small_image.jpg');

$homepageSectionsViewModel = $block->getData('view_model');
$offersData = [];
$homepageSections = [];
if ($homepageSectionsViewModel instanceof \TeknTek\Homepage\ViewModel\Sections) {
    $offersData = $homepageSectionsViewModel->getFeaturedProducts(4);
    $homepageSections = $homepageSectionsViewModel->getSections(
        (array) $block->getData('homepage_category_ids'),
        (int) $block->getData('homepage_category_product_limit')
    );
}

$fallbackCards = [[
    'id' => 0,
    'name' => 'View Products',
    'image' => $placeholderImage,
    'secondary_image' => '',
    'old' => '',
    'price' => '',
    'compare_price' => 0,
    'discount' => '',
    'reviews' => 0,
    'rating_summary' => 0,
    'url' => $block->getUrl('catalogsearch/result')
]];

if ($offersData === []) {
    $offersData = $fallbackCards;
}

$searchSuggestionItems = [];
try {
    $searchCollection = $productCollectionFactory->create();
    $searchCollection->addAttributeToSelect(['name', 'sku', 'small_image', 'price', 'final_price', 'status', 'visibility']);
    $searchCollection->addAttributeToFilter('status', \Magento\Catalog\Model\Product\Attribute\Source\Status::STATUS_ENABLED);
    $searchCollection->addAttributeToFilter(
        'visibility',
        ['in' => [
            \Magento\Catalog\Model\Product\Visibility::VISIBILITY_IN_CATALOG,
            \Magento\Catalog\Model\Product\Visibility::VISIBILITY_IN_SEARCH,
            \Magento\Catalog\Model\Product\Visibility::VISIBILITY_BOTH
        ]]
    );
    $searchCollection->setPageSize(180);
    $searchCollection->setCurPage(1);

    foreach ($searchCollection as $product) {
        $imageUrl = '';
        try {
            $imageUrl = (string) $imageHelper->init($product, 'product_small_image')->getUrl();
        } catch (\Throwable $e) {
            $imageUrl = '';
        }
        if ($imageUrl === '') {
            $imageUrl = $placeholderImage;
        }

        $finalPrice = (float) $product->getFinalPrice();
        $searchSuggestionItems[] = [
            'name' => (string) $product->getName(),
            'sku' => (string) $product->getSku(),
            'image' => $imageUrl,
            'url' => (string) $product->getProductUrl(),
            'price' => $finalPrice > 0 ? $priceHelper->currency($finalPrice, true, false) : ''
        ];
    }
} catch (\Throwable $e) {
    $searchSuggestionItems = [];
}

if (empty($searchSuggestionItems)) {
    $searchSuggestionItems = array_map(static function (array $item): array {
        return [
            'name' => $item['name'] ?? '',
            'sku' => '',
            'image' => $item['image'] ?? '',
            'url' => $item['url'] ?? '',
            'price' => $item['price'] ?? ''
        ];
    }, $offersData);
}

$formKey = $objectManager->get(\Magento\Framework\Data\Form\FormKey::class)->getFormKey();
$urlEncoder = $objectManager->get(\Magento\Framework\Url\EncoderInterface::class);
$currentUrl = $block->getUrl('*/*/*', ['_current' => true, '_use_rewrite' => true]);

$homepageData = [
    'offers' => $offersData,
    'searchSuggestions' => array_slice($searchSuggestionItems, 0, 120),
    'sections' => $homepageSections,
    'cart' => [
        'addUrl' => $block->getUrl('checkout/cart/add'),
        'formKey' => $formKey,
        'uenc' => $urlEncoder->encode($currentUrl)
    ]
];
?>


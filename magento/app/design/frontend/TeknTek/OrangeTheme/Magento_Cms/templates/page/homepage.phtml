<?php
/** @var \Magento\Framework\View\Element\Template $block */

$objectManager = \Magento\Framework\App\ObjectManager::getInstance();
$storeManager = $objectManager->get(\Magento\Store\Model\StoreManagerInterface::class);
$categoryCollectionFactory = $objectManager->get(\Magento\Catalog\Model\ResourceModel\Category\CollectionFactory::class);

$ttkUrlKeyMap = [
    'hard_drives' => 'hard-drives',
    'computer_mices' => 'computer-mice',
    'keyboards' => 'keyboards',
    'monitors' => 'monitors',
    'laptop' => 'laptops',
    'smartphone' => 'smartphones',
    'camera' => 'cameras',
    'smart_watch' => 'smart-watches',
    'audio_headphones' => 'audio-headphones',
    'tablet' => 'tablets'
];

$ttkCategoryUrls = [
    'hard_drives' => $block->getUrl($ttkUrlKeyMap['hard_drives']),
    'computer_mices' => $block->getUrl($ttkUrlKeyMap['computer_mices']),
    'keyboards' => $block->getUrl($ttkUrlKeyMap['keyboards']),
    'monitors' => $block->getUrl($ttkUrlKeyMap['monitors']),
    'laptop' => $block->getUrl($ttkUrlKeyMap['laptop']),
    'smartphone' => $block->getUrl($ttkUrlKeyMap['smartphone']),
    'camera' => $block->getUrl($ttkUrlKeyMap['camera']),
    'smart_watch' => $block->getUrl($ttkUrlKeyMap['smart_watch']),
    'audio_headphones' => $block->getUrl($ttkUrlKeyMap['audio_headphones']),
    'tablet' => $block->getUrl($ttkUrlKeyMap['tablet']),
    'exchange_rates' => '#',
    'news' => '#'
];

try {
    $categoryCollection = $categoryCollectionFactory->create();
    $categoryCollection->addAttributeToSelect(['name', 'is_active', 'url_key']);
    $categoryCollection->addAttributeToFilter('is_active', 1);
    $categoryCollection->addAttributeToFilter('url_key', ['in' => array_values($ttkUrlKeyMap)]);

    foreach ($categoryCollection as $category) {
        $urlKey = (string) $category->getUrlKey();
        foreach ($ttkUrlKeyMap as $key => $targetUrlKey) {
            if ($urlKey === $targetUrlKey) {
                $ttkCategoryUrls[$key] = $category->getUrl();
                break;
            }
        }
    }
} catch (\Throwable $e) {
    // Keep fallback URLs if category lookup fails.
}
?>


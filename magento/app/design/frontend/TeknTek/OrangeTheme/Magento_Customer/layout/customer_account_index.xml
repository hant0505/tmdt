<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <block class="TeknTek\AccountDashboard\Block\Account\Greeting"
                   name="tekntek.customer.account.greeting"
                   template="Magento_Customer::account/greeting.phtml"
                   before="customer_account_dashboard_info"
                   cacheable="false"/>
        </referenceContainer>
        <move element="customer_account_dashboard_top"
              destination="content"
              after="customer_account_dashboard_address"/>
    </body>
</page>

<?php
/**
 * Modern default address cards.
 *
 * @var \Magento\Customer\Block\Address\Book $block
 * @var \Magento\Framework\Escaper $escaper
 */
$defaultBillingAddress = $block->getDefaultBilling();
$defaultShippingAddress = $block->getDefaultShipping();
?>
<style>
body.account .ttk-address-default-block > .ttk-address-default-grid,
body.customer-address-index .ttk-address-default-block > .ttk-address-default-grid {
    display: flex !important;
    flex-direction: row !important;
    align-items: stretch !important;
    justify-content: flex-start !important;
    gap: 24px !important;
    width: 100% !important;
    max-width: none !important;
}

body.account .ttk-address-default-block > .ttk-address-default-grid > .ttk-address-card,
body.customer-address-index .ttk-address-default-block > .ttk-address-default-grid > .ttk-address-card {
    flex: 1 1 0 !important;
    width: auto !important;
    max-width: none !important;
    min-width: 0 !important;
    margin: 0 !important;
    float: none !important;
    clear: none !important;
    align-self: stretch !important;
    transform: none !important;
}

body.account .ttk-address-default-block > .ttk-address-default-grid > .ttk-address-card:first-child,
body.customer-address-index .ttk-address-default-block > .ttk-address-default-grid > .ttk-address-card:first-child {
    order: 1 !important;
}

body.account .ttk-address-default-block > .ttk-address-default-grid > .ttk-address-card:nth-child(2),
body.customer-address-index .ttk-address-default-block > .ttk-address-default-grid > .ttk-address-card:nth-child(2) {
    order: 2 !important;
}

@media (max-width: 900px) {
    body.account .ttk-address-default-block > .ttk-address-default-grid,
    body.customer-address-index .ttk-address-default-block > .ttk-address-default-grid {
        flex-direction: column !important;
    }
}
</style>
<div class="block block-addresses-default ttk-address-default-block">
    <div class="block-title">
        <strong><?= $escaper->escapeHtml(__('Default Addresses')) ?></strong>
    </div>
    <div class="block-content ttk-address-default-grid">
        <article class="ttk-address-card ttk-address-card--default">
            <div class="ttk-address-card__head">
                <strong><?= $escaper->escapeHtml(__('Default Billing Address')) ?></strong>
                <span><?= $escaper->escapeHtml(__('Billing')) ?></span>
            </div>
            <address class="ttk-address-card__body">
                <?php if ($defaultBillingAddress): ?>
                    <?= /* @noEscape */ $block->getAddressHtml($block->getAddressById($defaultBillingAddress)) ?>
                <?php else: ?>
                    <?= $escaper->escapeHtml(__('You have no default billing address in your address book.')) ?>
                <?php endif; ?>
            </address>
            <div class="ttk-address-card__actions">
                <?php if ($defaultBillingAddress): ?>
                    <a class="action edit ttk-action-chip"
                       href="<?= $escaper->escapeUrl($block->getAddressEditUrl($defaultBillingAddress)) ?>">
                        <span><?= $escaper->escapeHtml(__('Change Billing Address')) ?></span>
                    </a>
                <?php else: ?>
                    <a class="action edit ttk-action-chip"
                       href="<?= $escaper->escapeUrl($block->getUrl('customer/address/new')) ?>">
                        <span><?= $escaper->escapeHtml(__('Add Billing Address')) ?></span>
                    </a>
                <?php endif; ?>
            </div>
        </article>

        <article class="ttk-address-card ttk-address-card--default">
            <div class="ttk-address-card__head">
                <strong><?= $escaper->escapeHtml(__('Default Shipping Address')) ?></strong>
                <span><?= $escaper->escapeHtml(__('Shipping')) ?></span>
            </div>
            <address class="ttk-address-card__body">
                <?php if ($defaultShippingAddress): ?>
                    <?= /* @noEscape */ $block->getAddressHtml($block->getAddressById($defaultShippingAddress)) ?>
                <?php else: ?>
                    <?= $escaper->escapeHtml(__('You have no default shipping address in your address book.')) ?>
                <?php endif; ?>
            </address>
            <div class="ttk-address-card__actions">
                <?php if ($defaultShippingAddress): ?>
                    <a class="action edit ttk-action-chip"
                       href="<?= $escaper->escapeUrl($block->getAddressEditUrl($defaultShippingAddress)) ?>">
                        <span><?= $escaper->escapeHtml(__('Change Shipping Address')) ?></span>
                    </a>
                <?php else: ?>
                    <a class="action edit ttk-action-chip"
                       href="<?= $escaper->escapeUrl($block->getUrl('customer/address/new')) ?>">
                        <span><?= $escaper->escapeHtml(__('Add Shipping Address')) ?></span>
                    </a>
                <?php endif; ?>
            </div>
        </article>
    </div>
</div>

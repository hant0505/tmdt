<script>
document.addEventListener('DOMContentLoaded', function () {
    var container = document.querySelector('#captcha-container-user_forgotpassword');

    if (!container) {
        return;
    }

    var reloadButton = container.querySelector('.captcha-reload');
    var captchaImg = container.querySelector('.captcha-img');

    if (!reloadButton || !captchaImg) {
        return;
    }

    function parseMageInitData(node) {
        try {
            return JSON.parse(node.getAttribute('data-mage-init') || '{}');
        } catch (e) {
            return {};
        }
    }

    function withTimestamp(src) {
        var clean = (src || '').replace(/([?&])_=[^&]*/g, '').replace(/[?&]$/, '');

        if (!clean) {
            return '';
        }

        return clean + (clean.indexOf('?') === -1 ? '?' : '&') + '_=' + Date.now();
    }

    reloadButton.addEventListener('click', function (event) {
        var initData;
        var captchaConfig;
        var refreshUrl;
        var formType;
        var formKeyInput;
        var formKey;
        var previousSrc;
        var payload;

        event.preventDefault();
        event.stopPropagation();

        initData = parseMageInitData(container);
        captchaConfig = (initData && initData.captcha) ? initData.captcha : {};
        refreshUrl = captchaConfig.url || '/captcha/refresh/';
        formType = captchaConfig.type || 'user_forgotpassword';
        formKeyInput = document.querySelector('input[name="form_key"]');
        formKey = (window.FORM_KEY || (formKeyInput ? formKeyInput.value : '') || '');
        previousSrc = captchaImg.getAttribute('src') || '';

        reloadButton.disabled = true;

        payload = new URLSearchParams();
        payload.append('formId', formType);
        if (formKey) {
            payload.append('form_key', formKey);
        }

        fetch(refreshUrl, {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: payload.toString()
        }).then(function (response) {
            return response.json();
        }).then(function (data) {
            if (data && data.imgSrc) {
                captchaImg.setAttribute('src', withTimestamp(data.imgSrc));
                return;
            }

            captchaImg.setAttribute('src', withTimestamp(previousSrc));
        }).catch(function () {
            captchaImg.setAttribute('src', withTimestamp(previousSrc));
        }).finally(function () {
            reloadButton.disabled = false;
        });
    });
});
</script>

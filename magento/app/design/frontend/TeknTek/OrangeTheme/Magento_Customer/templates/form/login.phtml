    <script>
    document.addEventListener('DOMContentLoaded', function () {
        var form = document.getElementById('login-form');
        if (!form) {
            return;
        }

        var messagesWrap = document.querySelector('[data-role="login-messages"]');
        var messageText = document.querySelector('[data-role="login-message-text"]');

        function setError(message) {
            if (!messagesWrap || !messageText) {
                return;
            }
            messageText.textContent = message || '';
            messagesWrap.hidden = !message;
        }

        form.addEventListener('submit', function (event) {
            event.preventDefault();

            var formData = new FormData(form);

            fetch('<?= $escaper->escapeJs($block->getUrl('tekntek_signup/account/login')) ?>', {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: formData
            }).then(function (resp) {
                return resp.text();
            }).then(function (text) {
                var data = {};
                try {
                    data = text ? JSON.parse(text) : {};
                } catch (e) {
                    data = {};
                }

                if (!data.success) {
                    setError((data && data.message) || 'Unable to sign in right now. Please try again.');
                    return;
                }

                window.location.href = data.redirect_url || '<?= $escaper->escapeJs($block->getUrl('customer/account')) ?>';
            }).catch(function () {
                setError('Unable to sign in right now. Please try again.');
            });
        });
    });
    </script>

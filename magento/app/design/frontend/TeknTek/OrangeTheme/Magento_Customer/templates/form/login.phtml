    <script>
    document.addEventListener('DOMContentLoaded', function () {
        var form = document.getElementById('login-form');
        if (!form) {
            return;
        }

        var messagesWrap = document.querySelector('[data-role="login-messages"]');
        var messageText = document.querySelector('[data-role="login-message-text"]');
        var submitButton = form.querySelector('button[type="submit"]');
        var submitText = submitButton ? submitButton.querySelector('span') : null;
        var originalSubmitText = submitText ? submitText.textContent : '';
        var isSubmittingNatively = false;
        var isSubmitting = false;

        function setError(message) {
            if (!messagesWrap || !messageText) {
                return;
            }
            messageText.textContent = message || '';
            messagesWrap.hidden = !message;
        }

        function submitNatively() {
            if (isSubmittingNatively) {
                return;
            }

            isSubmittingNatively = true;
            HTMLFormElement.prototype.submit.call(form);
        }

        function setLoading(isLoading) {
            isSubmitting = isLoading;

            if (submitButton) {
                submitButton.disabled = isLoading;
                submitButton.classList.toggle('is-loading', isLoading);
            }

            if (submitText) {
                submitText.textContent = isLoading ? 'Signing in...' : originalSubmitText;
            }
        }

        form.addEventListener('submit', function (event) {
            if (isSubmittingNatively) {
                return;
            }

            event.preventDefault();

            if (isSubmitting) {
                return;
            }

            var emailField = form.querySelector('input[name="login[username]"]');
            var passwordField = form.querySelector('input[name="login[password]"]');
            var email = emailField ? (emailField.value || '').trim() : '';
            var password = passwordField ? (passwordField.value || '') : '';

            if (!email || !password) {
                setError('Please enter both email and password.');
                return;
            }

            var formData = new FormData(form);
            var controller = window.AbortController ? new AbortController() : null;
            var timeoutId = window.setTimeout(function () {
                if (controller) {
                    controller.abort();
                }
            }, 10000);

            setError('');
            setLoading(true);

            fetch('<?= $escaper->escapeJs($block->getUrl('tekntek_signup/account/login')) ?>', {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: formData,
                signal: controller ? controller.signal : undefined
            }).then(function (resp) {
                return resp.text();
            }).then(function (text) {
                window.clearTimeout(timeoutId);
                setLoading(false);

                var data = {};
                try {
                    data = text ? JSON.parse(text) : {};
                } catch (e) {
                    submitNatively();
                    return;
                }

                if (!data.success) {
                    setError((data && data.message) || 'Unable to sign in right now. Please try again.');
                    return;
                }

                window.location.href = data.redirect_url || '<?= $escaper->escapeJs($block->getUrl('customer/account')) ?>';
            }).catch(function () {
                window.clearTimeout(timeoutId);
                setLoading(false);
                setError('The sign-in request took too long. Please check your connection and try again.');
            });
        });
    });
    </script>

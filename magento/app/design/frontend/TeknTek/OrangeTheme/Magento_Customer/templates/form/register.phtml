$signupSession = $objectManager->get(\TeknTek\SignupFlow\Model\SignupSession::class);

$initialStep = 'email';
if ($signupSession->hasVerifiedEmail()) {
    $initialStep = 'profile';
} elseif ($signupSession->hasPendingCode() && !$signupSession->isExpired()) {
    $initialStep = 'verify';
}

$prefilledEmail = $signupSession->getEmail();
$expiresAt = $signupSession->getExpiresAt();
$registerBackgroundUrl = $block->getViewFileUrl('images/auth-login-figma-bg.png');
$signupInit = [
    'TeknTek_SignupFlow/js/signup-flow' => [
        'sendUrl' => $block->getUrl('tekntek_signup/code/send'),
        'verifyUrl' => $block->getUrl('tekntek_signup/code/verify'),
        'createUrl' => $block->getUrl('tekntek_signup/account/create'),
        'successUrl' => $block->getUrl(''),
        'expiresSeconds' => 300,
    ],
];

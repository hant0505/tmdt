$initialStep = 'email';
if ($signupSession->hasVerifiedEmail()) {
    $initialStep = 'profile';
} elseif ($signupSession->hasPendingCode() && !$signupSession->isExpired()) {
    $initialStep = 'verify';
}

$prefilledEmail = $signupSession->getEmail();
$expiresAt = $signupSession->getExpiresAt();

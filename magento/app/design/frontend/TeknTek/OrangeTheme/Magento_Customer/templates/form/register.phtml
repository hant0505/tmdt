                            <button type="button" class="tekntek-register__resend" data-role="resend-code" disabled>
                                <?= $escaper->escapeHtml(__('Send code again')) ?>
                            </button>
                            <span class="tekntek-register__timer" data-role="countdown">05:00</span>
                        </div>

                        <button type="button" class="tekntek-register__resend" data-role="edit-email">
                            <?= $escaper->escapeHtml(__('Use a different email')) ?>
                        </button>

                        <button type="submit" class="tekntek-register__button">
                            <span><?= $escaper->escapeHtml(__('Continue')) ?></span>
                        </button>
                    </form>
                </div>

                <div class="tekntek-register__stage<?= $initialStep === 'profile' ? ' is-active' : '' ?>" data-step="profile"<?= $initialStep !== 'profile' ? ' hidden' : '' ?>>
                    <div class="block-title">
                        <strong role="heading" aria-level="2" tabindex="-1"><?= $escaper->escapeHtml(__('Create your account')) ?></strong>
                    </div>

                    <p class="tekntek-auth__subtitle">
                        <?= $escaper->escapeHtml(__('Your email is verified. Fill in your information below to finish creating your account and sign in.')) ?>
                    </p>

                    <form class="tekntek-register__form" data-role="profile-form" action="<?= $escaper->escapeUrl($block->getUrl('tekntek_signup/account/create')) ?>" method="post" autocomplete="off">
                        <?= $block->getBlockHtml('formkey') ?>
                        <input type="hidden" name="email" data-role="final-email-hidden" value="<?= $escaper->escapeHtmlAttr($prefilledEmail) ?>">

                        <div class="tekntek-register__titles" role="radiogroup" aria-label="<?= $escaper->escapeHtmlAttr(__('Title')) ?>">
                            <label><input type="radio" name="prefix" value="Mr."> <span><?= $escaper->escapeHtml(__('Mr.')) ?></span></label>
                            <label><input type="radio" name="prefix" value="Mrs."> <span><?= $escaper->escapeHtml(__('Mrs.')) ?></span></label>
                            <label><input type="radio" name="prefix" value=""> <span><?= $escaper->escapeHtml(__('Prefer not to say')) ?></span></label>
                        </div>

                        <label class="tekntek-register__field">
                            <input type="text" name="firstname" placeholder="<?= $escaper->escapeHtmlAttr(__('First name')) ?>" autocomplete="given-name" required>
                        </label>

                        <label class="tekntek-register__field">
                            <input type="text" name="lastname" placeholder="<?= $escaper->escapeHtmlAttr(__('Surname')) ?>" autocomplete="family-name" required>
                        </label>

                        <p class="tekntek-register__hint"><?= $escaper->escapeHtml(__('This is the best way to reach me.')) ?></p>

                        <label class="tekntek-register__field">
                            <input type="tel" name="telephone" placeholder="<?= $escaper->escapeHtmlAttr(__('Phone number')) ?>" autocomplete="tel">
                        </label>

                        <label class="tekntek-register__field">
                            <span class="tekntek-register__password-wrap">
                                <input type="password" name="password" placeholder="<?= $escaper->escapeHtmlAttr(__('Password')) ?>" autocomplete="new-password" required data-role="register-password">
                                <button type="button" class="tekntek-register__password-toggle" data-role="toggle-password" data-target="register-password" aria-label="<?= $escaper->escapeHtmlAttr(__('Show password')) ?>"><?= $escaper->escapeHtml(__('Show')) ?></button>
                            </span>
                        </label>

                        <div class="tekntek-register__password-rules" data-role="password-rules" aria-live="polite">
                            <p class="tekntek-register__hint"><?= $escaper->escapeHtml(__('Password requirements:')) ?></p>
                            <ul class="tekntek-register__password-rule-list">
                                <li class="tekntek-register__password-rule" data-rule="length"><?= $escaper->escapeHtml(__('At least 8 characters')) ?></li>
                                <li class="tekntek-register__password-rule" data-rule="uppercase"><?= $escaper->escapeHtml(__('Starts with an uppercase letter')) ?></li>
                                <li class="tekntek-register__password-rule" data-rule="number"><?= $escaper->escapeHtml(__('Contains at least 1 number')) ?></li>
                                <li class="tekntek-register__password-rule" data-rule="match"><?= $escaper->escapeHtml(__('Repeated password matches')) ?></li>
                            </ul>
                        </div>

                        <label class="tekntek-register__field">
                            <span class="tekntek-register__password-wrap">
                                <input type="password" name="password_confirmation" placeholder="<?= $escaper->escapeHtmlAttr(__('Repeat password')) ?>" autocomplete="new-password" required data-role="register-password-confirmation">
                                <button type="button" class="tekntek-register__password-toggle" data-role="toggle-password" data-target="register-password-confirmation" aria-label="<?= $escaper->escapeHtmlAttr(__('Show repeated password')) ?>"><?= $escaper->escapeHtml(__('Show')) ?></button>
                            </span>
                        </label>

                        <button type="submit" class="tekntek-register__button">
                            <span><?= $escaper->escapeHtml(__('Create account')) ?></span>
                        </button>
                    </form>
                </div>
            </section>

            <aside class="tekntek-auth__visual" aria-hidden="true">
                <img class="tekntek-auth__visual-art" src="<?= $block->escapeUrl($block->getViewFileUrl('images/signinpic.png')) ?>" alt="" loading="eager" />
            </aside>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    var root = document.querySelector('[data-role="tekntek-signup-root"]');
    if (!root) {
        return;
    }

    window.setTimeout(function () {
        if (root.getAttribute('data-signup-flow-bound') === '1') {
            return;
        }
        root.setAttribute('data-signup-flow-bound', '1');

        var digits = Array.prototype.slice.call(root.querySelectorAll('[data-role="code-digit"]'));
        var countdown = root.querySelector('[data-role="countdown"]');
        var resend = root.querySelector('[data-role="resend-code"]');
        var editEmailButton = root.querySelector('[data-role="edit-email"]');
        var verifyForm = root.querySelector('[data-role="verify-form"]');
        var emailForm = root.querySelector('[data-role="email-form"]');
        var profileForm = root.querySelector('[data-role="profile-form"]');
        var hiddenCode = root.querySelector('[data-role="code-hidden"]');
        var hiddenEmail = root.querySelector('[data-role="verified-email-hidden"]');
        var finalEmail = root.querySelector('[data-role="final-email-hidden"]');
        var emailInput = root.querySelector('[data-role="email-input"]');
        var verifyCopy = root.querySelector('[data-role="verify-copy"]');
        var messageBox = root.querySelector('[data-role="message"]');
        var passwordInput = profileForm ? profileForm.querySelector('input[name="password"]') : null;
        var confirmInput = profileForm ? profileForm.querySelector('input[name="password_confirmation"]') : null;
        var passwordRuleNodes = profileForm ? Array.prototype.slice.call(profileForm.querySelectorAll('[data-role="password-rules"] [data-rule]')) : [];
        var passwordToggleButtons = profileForm ? Array.prototype.slice.call(profileForm.querySelectorAll('[data-role="toggle-password"]')) : [];
        var registerPanel = root.querySelector('.tekntek-auth__panel--register');
        var steps = Array.prototype.slice.call(root.querySelectorAll('[data-step]'));
        var progressSteps = Array.prototype.slice.call(root.querySelectorAll('[data-role="progress-step"]'));
        var initialStep = root.getAttribute('data-initial-step') || 'email';
        var expiresAt = parseInt(root.getAttribute('data-initial-expires-at') || '0', 10) || 0;
        var timerId = null;

        function getPasswordState() {
            var password = passwordInput ? String(passwordInput.value || '') : '';
            var passwordConfirmation = confirmInput ? String(confirmInput.value || '') : '';

            return {
                password: password,
                passwordConfirmation: passwordConfirmation,
                rules: [
                    {
                        key: 'length',
                        valid: password.length >= 8,
                        message: 'Password must be at least 8 characters.'
                    },
                    {
                        key: 'uppercase',
                        valid: /^[A-Z]/.test(password),
                        message: 'Password must start with an uppercase letter.'
                    },
                    {
                        key: 'number',
                        valid: /\d/.test(password),
                        message: 'Password must contain at least 1 number.'
                    },
                    {
                        key: 'match',
                        valid: password !== '' && password === passwordConfirmation,
                        message: 'Password confirmation does not match.'
                    }
                ]
            };
        }

        function renderPasswordRules() {
            var state = getPasswordState();

            passwordRuleNodes.forEach(function (node) {
                var ruleKey = node.getAttribute('data-rule') || '';
                var matchedRule = state.rules.find(function (rule) {
                    return rule.key === ruleKey;
                });

                if (!matchedRule) {
                    return;
                }

                node.classList.toggle('is-valid', !!matchedRule.valid);
            });

            return state;
        }

        function bindPasswordAssist() {
            [passwordInput, confirmInput].forEach(function (input) {
                if (!input) {
                    return;
                }

                input.addEventListener('input', function () {
                    renderPasswordRules();
                });
            });

            passwordToggleButtons.forEach(function (button) {
                button.addEventListener('click', function () {
                    var target = button.getAttribute('data-target') || '';
                    var input = profileForm ? profileForm.querySelector('[data-role="' + target + '"]') : null;
                    var isPassword;

                    if (!input) {
                        return;
                    }

                    isPassword = input.getAttribute('type') === 'password';
                    input.setAttribute('type', isPassword ? 'text' : 'password');
                    button.textContent = isPassword ? 'Hide' : 'Show';
                    button.setAttribute('aria-label', isPassword ? 'Hide password' : 'Show password');
                });
            });

            renderPasswordRules();
        }

        function showMessage(text, type) {
            if (!messageBox) {
                return;
            }

            if (!text) {
                messageBox.setAttribute('hidden', 'hidden');
                messageBox.classList.remove('is-error');
                messageBox.classList.remove('is-success');
                messageBox.textContent = '';
                return;
            }

            messageBox.removeAttribute('hidden');
            messageBox.classList.remove('is-error');
            messageBox.classList.remove('is-success');
            messageBox.classList.add(type === 'error' ? 'is-error' : 'is-success');
            messageBox.textContent = text;
        }

        function setStep(step) {
            var activeIndex = step === 'email' ? 0 : (step === 'verify' ? 1 : 2);

            steps.forEach(function (item) {
                var isActive = item.getAttribute('data-step') === step;
                item.hidden = !isActive;
                item.classList.toggle('is-active', isActive);
            });

            progressSteps.forEach(function (item) {
                var index = parseInt(item.getAttribute('data-step-index') || '0', 10);
                item.classList.toggle('is-active', index === activeIndex);
                item.classList.toggle('is-complete', index < activeIndex);
            });

            if (registerPanel) {
                window.requestAnimationFrame(function () {
                    registerPanel.scrollTop = 0;
                });
            }
        }

        function setEmailValue(email) {
            var normalizedEmail = (email || '').trim();

            if (emailInput) {
                emailInput.value = normalizedEmail;
            }

            if (hiddenEmail) {
                hiddenEmail.value = normalizedEmail;
            }

            if (finalEmail) {
                finalEmail.value = normalizedEmail;
            }

            if (verifyCopy) {
                verifyCopy.textContent = normalizedEmail
                    ? 'Check your inbox at ' + normalizedEmail + '. Enter the 6-digit verification code we sent to your email. The code expires after 5 minutes.'
                    : 'Check your inbox. Enter the 6-digit verification code we sent to your email. The code expires after 5 minutes.';
            }
        }

        function resetCodeInputs() {
            digits.forEach(function (input) {
                input.value = '';
            });
            syncCode();
        }

        function syncCode() {
            if (!hiddenCode) {
                return;
            }
            hiddenCode.value = digits.map(function (input) {
                return (input.value || '').replace(/\D+/g, '');
            }).join('');
        }

        function pad2(num) {
            return num < 10 ? '0' + num : String(num);
        }

        function renderTimer() {
            if (!countdown || !resend) {
                return;
            }
            if (timerId) {
                window.clearInterval(timerId);
                timerId = null;
            }

            function tick() {
                var now = Math.floor(Date.now() / 1000);
                var remaining = Math.max(0, expiresAt - now);
                countdown.textContent = pad2(Math.floor(remaining / 60)) + ':' + pad2(remaining % 60);
                resend.disabled = remaining > 0;

                if (remaining <= 0 && timerId) {
                    window.clearInterval(timerId);
                    timerId = null;
                }
            }

            tick();
            if (expiresAt > 0) {
                timerId = window.setInterval(tick, 1000);
            }
        }

        digits.forEach(function (input, idx) {
            input.addEventListener('focus', function () {
                input.select();
            });

            input.addEventListener('input', function () {
                var value = (input.value || '').replace(/\D+/g, '');
                if ((input.value || '') !== value) {
                    showMessage('Verification code only accepts numbers.', 'error');
                } else {
                    showMessage('', 'success');
                }

                if (value.length > 1) {
                    value.split('').forEach(function (digit, offset) {
                        if (digits[idx + offset]) {
                            digits[idx + offset].value = digit;
                        }
                    });
                    var targetIndex = Math.min(idx + value.length, digits.length - 1);
                    digits[targetIndex].focus();
                    digits[targetIndex].select();
                    syncCode();
                    return;
                }

                input.value = value.slice(0, 1);
                if (input.value && digits[idx + 1]) {
                    window.setTimeout(function () {
                        digits[idx + 1].focus();
                        digits[idx + 1].select();
                    }, 0);
                }
                syncCode();
            });

            input.addEventListener('keydown', function (event) {
                if (event.key >= '0' && event.key <= '9') {
                    if (input.value) {
                        input.value = '';
                    }
                    return;
                }

                if (event.key === 'Backspace' && !input.value && digits[idx - 1]) {
                    digits[idx - 1].focus();
                    digits[idx - 1].select();
                }
            });

            input.addEventListener('paste', function (event) {
                var clipboard = event.clipboardData || window.clipboardData;
                var pasted = clipboard ? String(clipboard.getData('text') || '') : '';
                var numbers = pasted.replace(/\D+/g, '');

                if (!numbers) {
                    return;
                }

                event.preventDefault();
                numbers.split('').forEach(function (digit, offset) {
                    if (digits[idx + offset]) {
                        digits[idx + offset].value = digit;
                    }
                });
                syncCode();

                var nextIndex = Math.min(idx + numbers.length, digits.length - 1);
                if (digits[nextIndex]) {
                    digits[nextIndex].focus();
                    digits[nextIndex].select();
                }
            });
        });

        if (verifyForm && hiddenCode) {
            verifyForm.addEventListener('submit', function (event) {
                event.preventDefault();
                syncCode();
                if ((hiddenCode.value || '').length !== 6) {
                    showMessage('Please enter the 6-digit code.', 'error');
                    return;
                }

                var formKey = (root.querySelector('input[name="form_key"]') || {}).value || '';
                var body = new URLSearchParams();
                body.append('form_key', formKey);
                body.append('code', hiddenCode.value || '');

                fetch('<?= $escaper->escapeJs($block->getUrl('tekntek_signup/code/verify')) ?>', {
                    method: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8'
                    },
                    body: body.toString()
                }).then(function (resp) {
                    return resp.text();
                }).then(function (text) {
                    var data = {};
                    try {
                        data = text ? JSON.parse(text) : {};
                    } catch (e) {
                        data = {};
                    }

                    if (!data.success) {
                        showMessage((data && data.message) || 'The code is invalid or has expired.', 'error');
                        return;
                    }

                    if (hiddenEmail && data.email) {
                        hiddenEmail.value = data.email;
                    }
                    if (finalEmail && data.email) {
                        finalEmail.value = data.email;
                    }

                    showMessage(data.message || 'Email verified successfully. Continue below to create your account and sign in.', 'success');
                    setStep('profile');
                }).catch(function () {
                    showMessage('Unable to verify the code right now. Please try again.', 'error');
                });
            });
        }

        if (emailForm && emailInput) {
            emailForm.addEventListener('submit', function (event) {
                event.preventDefault();

                if (emailForm.getAttribute('data-submitting') === '1') {
                    return;
                }

                var email = (emailInput.value || '').trim();
                var emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

                if (!emailPattern.test(email)) {
                    showMessage('Please enter a valid email address.', 'error');
                    return;
                }

                var submitButton = emailForm.querySelector('button[type="submit"]');
                var submitLabelNode = submitButton ? submitButton.querySelector('span') : null;
                var originalSubmitLabel = submitLabelNode ? submitLabelNode.textContent : '';
                var controller = window.AbortController ? new AbortController() : null;
                var timeoutId = window.setTimeout(function () {
                    if (controller) {
                        controller.abort();
                    }
                }, 12000);

                emailForm.setAttribute('data-submitting', '1');
                if (submitButton) {
                    submitButton.disabled = true;
                }
                if (submitLabelNode) {
                    submitLabelNode.textContent = 'Sending code...';
                }

                var formKey = (root.querySelector('input[name="form_key"]') || {}).value || '';
                var body = new URLSearchParams();
                body.append('form_key', formKey);
                body.append('email', email);

                fetch('<?= $escaper->escapeJs($block->getUrl('tekntek_signup/code/send')) ?>', {
                    method: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8'
                    },
                    body: body.toString(),
                    signal: controller ? controller.signal : undefined
                }).then(function (resp) {
                    return resp.text();
                }).then(function (text) {
                    window.clearTimeout(timeoutId);
                    var data = {};
                    try {
                        data = text ? JSON.parse(text) : {};
                    } catch (e) {
                        data = {};
                    }

                    if (!data.success) {
                        showMessage((data && data.message) || 'Unable to send verification code.', 'error');
                        return;
                    }

                    if (data.email) {
                        setEmailValue(data.email);
                    }

                    if (data.expires_at) {
                        expiresAt = parseInt(data.expires_at, 10) || 0;
                        renderTimer();
                    }

                    resetCodeInputs();
                    showMessage(data.message || 'We sent a 6-digit verification code.', 'success');
                    setStep('verify');
                    if (digits[0]) {
                        digits[0].focus();
                    }
                }).catch(function () {
                    window.clearTimeout(timeoutId);
                    showMessage('Unable to send verification code.', 'error');
                }).finally(function () {
                    emailForm.setAttribute('data-submitting', '0');
                    if (submitButton) {
                        submitButton.disabled = false;
                    }
                    if (submitLabelNode) {
                        submitLabelNode.textContent = originalSubmitLabel || 'Continue';
                    }
                });
            });
        }

        if (profileForm) {
            profileForm.addEventListener('submit', function (event) {
                event.preventDefault();

                if (profileForm.getAttribute('data-submitting') === '1') {
                    return;
                }
                
                var passwordState = renderPasswordRules();
                var password = passwordState.password;
                var passwordConfirmation = passwordState.passwordConfirmation;
                var passwordErrors = passwordState.rules.filter(function (rule) {
                    return !rule.valid;
                }).map(function (rule) {
                    return rule.message;
                });

                if (passwordErrors.length) {
                    showMessage(passwordErrors.join(' '), 'error');
                    return;
                }

                var firstnameInput = profileForm.querySelector('input[name="firstname"]');
                var lastnameInput = profileForm.querySelector('input[name="lastname"]');
                var firstname = firstnameInput ? (firstnameInput.value || '').trim() : '';
                var lastname = lastnameInput ? (lastnameInput.value || '').trim() : '';

                if (firstname.length === 0 || lastname.length === 0) {
                    showMessage('Please fill in your name details.', 'error');
                    return;
                }

                var formData = new FormData(profileForm);
                var submitButton = profileForm.querySelector('button[type="submit"]');
                var submitLabelNode = submitButton ? submitButton.querySelector('span') : null;
                var originalSubmitLabel = submitLabelNode ? submitLabelNode.textContent : '';

                profileForm.setAttribute('data-submitting', '1');
                if (submitButton) {
                    submitButton.disabled = true;
                }
                if (submitLabelNode) {
                    submitLabelNode.textContent = 'Creating account...';
                }

                fetch('<?= $escaper->escapeJs($block->getUrl('tekntek_signup/account/create')) ?>', {
                    method: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                        body: formData
                }).then(function (resp) {
                    return resp.text();
                }).then(function (text) {
                    var data = {};
                    try {
                        data = text ? JSON.parse(text) : {};
                    } catch (e) {
                        data = {};
                    }

                    if (!data.success) {
                        if (data.redirect_to_login && data.redirect_url) {
                            showMessage((data && data.message) || 'An account with this email already exists. Please log in instead.', 'error');
                            window.location.href = data.redirect_url;
                            return;
                        }

                        showMessage((data && data.message) || 'Unable to create your account right now. Please try again.', 'error');
                        return;
                    }

                    showMessage(data.message || 'Account created successfully.', 'success');
                    window.location.href = data.redirect_url || '<?= $escaper->escapeJs($block->getUrl('')) ?>';
                }).catch(function (error) {
                    console.error('Profile form submission error:', error);
                    showMessage('Unable to create your account right now. Please try again.', 'error');
                }).finally(function () {
                    profileForm.setAttribute('data-submitting', '0');
                    if (submitButton) {
                        submitButton.disabled = false;
                    }
                    if (submitLabelNode) {
                        submitLabelNode.textContent = originalSubmitLabel || 'Create account';
                    }
                });
            });
        }

        if (resend) {
            resend.addEventListener('click', function () {
                if (resend.disabled) {
                    return;
                }

                if (resend.getAttribute('data-submitting') === '1') {
                    return;
                }

                var formKey = (root.querySelector('input[name="form_key"]') || {}).value || '';
                var email = hiddenEmail ? hiddenEmail.value : '';

                if (!formKey || !email) {
                    return;
                }

                resend.setAttribute('data-submitting', '1');
                resend.disabled = true;

                var body = new URLSearchParams();
                body.append('form_key', formKey);
                body.append('email', email);

                fetch('<?= $escaper->escapeJs($block->getUrl('tekntek_signup/code/send')) ?>', {
                    method: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8'
                    },
                    body: body.toString()
                }).then(function (resp) {
                    return resp.json();
                }).then(function (data) {
                    if (data && data.success && data.expires_at) {
                        expiresAt = parseInt(data.expires_at, 10) || 0;
                        renderTimer();
                        resetCodeInputs();
                        showMessage(data.message || 'Verification code sent again.', 'success');
                        if (digits[0]) {
                            digits[0].focus();
                        }
                    } else {
                        showMessage((data && data.message) || 'Unable to resend the code.', 'error');
                    }
                }).catch(function () {
                    showMessage('Unable to resend the code.', 'error');
                }).finally(function () {
                    resend.setAttribute('data-submitting', '0');
                });
            });
        }

        if (editEmailButton) {
            editEmailButton.addEventListener('click', function () {
                showMessage('Please update your email and request a new verification code.', 'success');
                if (timerId) {
                    window.clearInterval(timerId);
                    timerId = null;
                }
                expiresAt = 0;
                if (countdown) {
                    countdown.textContent = '05:00';
                }
                if (resend) {
                    resend.disabled = false;
                }
                resetCodeInputs();
                setStep('email');
                if (emailInput) {
                    emailInput.focus();
                    emailInput.select();
                }
            });
        }

        bindPasswordAssist();

        if (initialStep === 'verify') {
            setEmailValue(hiddenEmail ? hiddenEmail.value : '');
            renderTimer();
            if (digits[0]) {
                digits[0].focus();
            }
        } else if (initialStep === 'profile') {
            setEmailValue(finalEmail ? finalEmail.value : '');
        } else {
            setEmailValue(emailInput ? emailInput.value : '');
        }
    }, 300);
});
</script>

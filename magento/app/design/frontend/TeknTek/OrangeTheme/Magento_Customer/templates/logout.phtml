<?php
/**
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Magento\Framework\Escaper $escaper
 */
$loginUrl = $block->getUrl('customer/account/login');
?>
<div class="ttk-logout-countdown" data-login-url="<?= $escaper->escapeUrl($loginUrl) ?>">
    <h2><?= $escaper->escapeHtml(__('You are signed out')) ?></h2>
    <p>
        <?= $escaper->escapeHtml(__('You will be redirected to the sign-in page in')) ?>
        <strong data-role="logout-countdown">5</strong>
        <?= $escaper->escapeHtml(__('seconds.')) ?>
    </p>
    <a class="action primary" href="<?= $escaper->escapeUrl($loginUrl) ?>">
        <span><?= $escaper->escapeHtml(__('Go to Sign In')) ?></span>
    </a>
</div>
<script>
(function () {
    var root = document.querySelector('.ttk-logout-countdown');
    if (!root) {
        return;
    }
    var target = root.getAttribute('data-login-url') || '/customer/account/login/';
    var node = root.querySelector('[data-role="logout-countdown"]');
    var seconds = 5;

    var timer = window.setInterval(function () {
        seconds -= 1;
        if (node) {
            node.textContent = String(Math.max(seconds, 0));
        }
        if (seconds <= 0) {
            window.clearInterval(timer);
            window.location.href = target;
        }
    }, 1000);
}());
</script>

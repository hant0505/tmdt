<?php
/** @var \Magento\Framework\View\Element\Template $block */

$objectManager = \Magento\Framework\App\ObjectManager::getInstance();
$categoryCollectionFactory = $objectManager->get(\Magento\Catalog\Model\ResourceModel\Category\CollectionFactory::class);

$ttkUrlKeyMap = [
    'hard_drives' => 'hard-drives',
    'computer_mice' => 'mice',
    'keyboards' => 'keyboards',
    'monitors' => 'monitors',
    'laptops' => 'laptops',
    'smartphones' => 'smartphones',
    'cameras' => 'cameras',
    'smartwatches' => 'smartwatches',
    'headphones' => 'headphones',
    'tablets' => 'tablets',
    // Legacy aliases kept for safety while the theme is being normalized.
    'computer_mices' => 'mice',
    'laptop' => 'laptops',
    'smartphone' => 'smartphones',
    'camera' => 'cameras',
    'smart_watch' => 'smartwatches',
    'audio_headphones' => 'headphones',
    'tablet' => 'tablets'
];

$ttkCategoryUrls = [
    'hard_drives' => $block->getUrl($ttkUrlKeyMap['hard_drives']),
    'computer_mice' => $block->getUrl($ttkUrlKeyMap['computer_mice']),
    'keyboards' => $block->getUrl($ttkUrlKeyMap['keyboards']),
    'monitors' => $block->getUrl($ttkUrlKeyMap['monitors']),
    'laptops' => $block->getUrl($ttkUrlKeyMap['laptops']),
    'smartphones' => $block->getUrl($ttkUrlKeyMap['smartphones']),
    'cameras' => $block->getUrl($ttkUrlKeyMap['cameras']),
    'smartwatches' => $block->getUrl($ttkUrlKeyMap['smartwatches']),
    'headphones' => $block->getUrl($ttkUrlKeyMap['headphones']),
    'tablets' => $block->getUrl($ttkUrlKeyMap['tablets']),
    'exchange_rates' => 'http://localhost/currency',
    'news' => 'http://localhost/businessnews'
];

try {
    $categoryCollection = $categoryCollectionFactory->create();
    $categoryCollection->addAttributeToSelect(['name', 'is_active', 'url_key']);
    $categoryCollection->addAttributeToFilter('is_active', 1);
    $categoryCollection->addAttributeToFilter('url_key', ['in' => array_values($ttkUrlKeyMap)]);

    foreach ($categoryCollection as $category) {
        $urlKey = (string) $category->getUrlKey();
        foreach ($ttkUrlKeyMap as $key => $targetUrlKey) {
            if ($urlKey === $targetUrlKey) {
                $ttkCategoryUrls[$key] = $category->getUrl();
                break;
            }
        }
    }
} catch (\Throwable $e) {
    // Keep fallback URLs if category lookup fails.
}

$httpContext = $objectManager->get(\Magento\Framework\App\Http\Context::class);
$searchHelper = $objectManager->get(\Magento\Search\Helper\Data::class);
$isLoggedIn = (bool) $httpContext->getValue(\Magento\Customer\Model\Context::CONTEXT_AUTH);
$accountUrl = $isLoggedIn ? $block->getUrl('customer/account') : $block->getUrl('customer/account/create');
$wishlistUrl = $isLoggedIn ? $block->getUrl('wishlist') : $block->getUrl('customer/account/create');
$quickSearchConfig = [
    'quickSearch' => [
        'formSelector' => '#search_mini_form',
        'url' => $searchHelper->getSuggestUrl(),
        'destinationSelector' => '#search_autocomplete',
        'minSearchLength' => (string) $searchHelper->getMinQueryLength(),
        'submitBtn' => '#ttk-search-submit',
    ],
];
?>


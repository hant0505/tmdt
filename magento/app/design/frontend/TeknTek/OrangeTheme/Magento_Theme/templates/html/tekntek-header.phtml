<script>
(function () {
    var allProductsToggle = document.getElementById('ttk-all-products-toggle');
    var categoryLayer = document.getElementById('ttk-icon-layer');
    var closeLayerTimer = null;

    if (!allProductsToggle || !categoryLayer) {
        return;
    }

    function openLayer() {
        if (closeLayerTimer) {
            window.clearTimeout(closeLayerTimer);
            closeLayerTimer = null;
        }
        categoryLayer.hidden = false;
        window.requestAnimationFrame(function () {
            categoryLayer.classList.add('is-open');
            allProductsToggle.setAttribute('aria-expanded', 'true');
        });
    }

    function closeLayer() {
        categoryLayer.classList.remove('is-open');
        allProductsToggle.setAttribute('aria-expanded', 'false');
        if (closeLayerTimer) {
            window.clearTimeout(closeLayerTimer);
        }
        closeLayerTimer = window.setTimeout(function () {
            if (!categoryLayer.classList.contains('is-open')) {
                categoryLayer.hidden = true;
            }
        }, 240);
    }

    allProductsToggle.addEventListener('click', function (event) {
        event.preventDefault();
        if (categoryLayer.classList.contains('is-open')) {
            closeLayer();
        } else {
            openLayer();
        }
    });

    document.addEventListener('click', function (event) {
        var clickInsideLayer = categoryLayer.contains(event.target);
        var clickOnToggle = allProductsToggle.contains(event.target);
        if (!clickInsideLayer && !clickOnToggle && categoryLayer.classList.contains('is-open')) {
            closeLayer();
        }
    });
})();

(function () {
    var searchForm = document.getElementById('search_mini_form');
    var searchInput = document.getElementById('search');
    var searchPreview = document.getElementById('search_autocomplete');
    var resultUrl = '<?= $block->escapeJs(parse_url($searchHelper->getResultUrl(), PHP_URL_PATH) ?: '/catalogsearch/result/') ?>';
    var suggestUrl = '<?= $block->escapeJs($block->getUrl('tekntek_suggest/ajax/suggest')) ?>';
    var activeRequest = null;
    var debounceTimer = null;

    if (!searchForm || !searchInput || !searchPreview) {
        return;
    }

    function escapeHtml(value) {
        return String(value || '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    function hidePreview() {
        searchPreview.innerHTML = '';
        searchPreview.hidden = true;
        searchInput.setAttribute('aria-expanded', 'false');
    }

    function shouldShowRegular(item) {
        return Boolean(item && (item.has_discount || Number(item.regular_price_amount || 0) > Number(item.final_price_amount || 0)));
    }

    function renderItems(items) {
        if (!Array.isArray(items) || !items.length) {
            hidePreview();
            return;
        }

        searchPreview.innerHTML = items.map(function (item) {
            var image = item.product_image || item.image || '';
            var imageMarkup = image
                ? '<span class="ttk-search-preview-image"><img src="' + escapeHtml(image) + '" alt="' + escapeHtml(item.title || item.name || '') + '" loading="eager" /></span>'
                : '<span class="ttk-search-preview-image ttk-search-preview-image--empty"></span>';
            var regular = shouldShowRegular(item)
                ? '<span class="ttk-search-preview-regular">' + escapeHtml(item.regular_price) + '</span>'
                : '';

            return '' +
                '<a href="' + escapeHtml(item.product_url || '#') + '">' +
                    imageMarkup +
                    '<span class="ttk-search-preview-meta">' +
                        '<span class="ttk-search-preview-name">' + escapeHtml(item.title || '') + '</span>' +
                        '<span class="ttk-search-preview-prices">' +
                            '<span class="ttk-search-preview-final">' + escapeHtml(item.final_price || '') + '</span>' +
                            regular +
                        '</span>' +
                    '</span>' +
                '</a>';
        }).join('') +
        '<div class="ttk-search-related">▦ Thông tin liên quan</div>';

        searchPreview.hidden = false;
        searchInput.setAttribute('aria-expanded', 'true');
    }

    function fetchSuggestions(query) {
        if (activeRequest && typeof activeRequest.abort === 'function') {
            activeRequest.abort();
        }

        activeRequest = new XMLHttpRequest();
        activeRequest.open('GET', suggestUrl + (suggestUrl.indexOf('?') === -1 ? '?' : '&') + 'q=' + encodeURIComponent(query), true);
        activeRequest.onreadystatechange = function () {
            if (activeRequest.readyState !== 4 || activeRequest.status === 0) {
                return;
            }

            if (activeRequest.status < 200 || activeRequest.status >= 300) {
                hidePreview();
                return;
            }

            try {
                renderItems(JSON.parse(activeRequest.responseText));
            } catch (error) {
                hidePreview();
            }
        };
        activeRequest.send();
    }

    searchInput.addEventListener('input', function () {
        var query = (searchInput.value || '').trim();

        window.clearTimeout(debounceTimer);
        if (query.length < 1) {
            hidePreview();
            return;
        }

        debounceTimer = window.setTimeout(function () {
            fetchSuggestions(query);
        }, 120);
    });

    searchInput.addEventListener('focus', function () {
        var query = (searchInput.value || '').trim();
        if (query.length >= 1) {
            fetchSuggestions(query);
        }
    });

    searchForm.addEventListener('submit', function (event) {
        var query = (searchInput.value || '').trim();

        if (!query) {
            event.preventDefault();
            return;
        }

        event.preventDefault();
        hidePreview();
        window.location.href = resultUrl + (resultUrl.indexOf('?') === -1 ? '?' : '&') + 'q=' + encodeURIComponent(query);
    });

    document.addEventListener('click', function (event) {
        if (!searchForm.contains(event.target)) {
            hidePreview();
        }
    });
})();
</script>

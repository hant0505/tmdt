<?php
/**
 * Vault cards list override with mock preview when no stored tokens.
 *
 * @var \Magento\Vault\Block\Customer\CreditCards $block
 */
$tokens = $block->getPaymentTokens();
?>
<?php if (count($tokens) !== 0) : ?>
    <div class="table-wrapper my-credit-cards">
        <table class="data table table-credit-cards" id="my-orders-table">
            <caption class="table-caption"><?= $block->escapeHtml(__('Stored Payment Methods')) ?></caption>
            <thead>
            <tr>
                <th scope="col" class="col card-number"><?= $block->escapeHtml(__('Card Number')) ?></th>
                <th scope="col" class="col expire"><?= $block->escapeHtml(__('Expiration Date')) ?></th>
                <th scope="col" class="col card-type"><?= $block->escapeHtml(__('Type')) ?></th>
                <th scope="col" class="col actions">&nbsp;</th>
            </tr>
            </thead>
            <tbody>
            <?php foreach ($tokens as $token) : ?>
                <?= /* @noEscape */ $block->renderTokenHtml($token) ?>
            <?php endforeach; ?>
            </tbody>
        </table>
    </div>
<?php elseif (!$block->isExistsCustomerTokens()) : ?>
    <div class="message info empty"><span><?= $block->escapeHtml(__('You have no stored payment methods.')) ?></span></div>

    <div class="table-wrapper my-credit-cards" style="margin-top:16px;">
        <table class="data table table-credit-cards">
            <caption class="table-caption"><?= $block->escapeHtml(__('Mock Preview (Demo Only)')) ?></caption>
            <thead>
            <tr>
                <th scope="col" class="col card-number"><?= $block->escapeHtml(__('Card Number')) ?></th>
                <th scope="col" class="col expire"><?= $block->escapeHtml(__('Expiration Date')) ?></th>
                <th scope="col" class="col card-type"><?= $block->escapeHtml(__('Type')) ?></th>
                <th scope="col" class="col actions">&nbsp;</th>
            </tr>
            </thead>
            <tbody>
            <tr>
                <td data-th="<?= $block->escapeHtmlAttr(__('Card Number')) ?>" class="col card-number">**** **** **** 4242</td>
                <td data-th="<?= $block->escapeHtmlAttr(__('Expiration Date')) ?>" class="col expire">12/2029</td>
                <td data-th="<?= $block->escapeHtmlAttr(__('Type')) ?>" class="col card-type">Visa (Mock)</td>
                <td class="col actions"><span style="display:inline-block;padding:4px 10px;border-radius:999px;background:#e0ecff;color:#1d4ed8;font-weight:700;font-size:12px;">Demo</span></td>
            </tr>
            </tbody>
        </table>
    </div>
<?php endif ?>

if (!$wishlstViewModel || !$wishlstViewModel->isAllow()) {
    return;
}

$tekntekWishlistItems = [];
foreach ($block->getWishlistItems() as $item) {
    $product = $item->getProduct();
    if ($product && $product->getId() && $product->isVisibleInCatalog()) {
        $tekntekWishlistItems[] = $item;
    }
}

if (!$tekntekWishlistItems) {
    return;
}

$tekntekWishlistCount = count($tekntekWishlistItems);
$tekntekVisibleWishlistItems = array_slice($tekntekWishlistItems, 0, 3);

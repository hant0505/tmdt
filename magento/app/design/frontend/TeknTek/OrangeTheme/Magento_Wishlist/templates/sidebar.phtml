<script>
require(['jquery', 'Magento_Customer/js/customer-data'], function ($, customerData) {
    'use strict';

    var sidebar = $('[data-role="tekntek-wishlist-sidebar"]');
    var uiVersionKey = 'tekntek_wishlist_sidebar_ui_version';
    var uiVersion = '20260430-wishlist-sidebar-empty-v4';

    function isValidItem(item) {
        return !!(item && item.product_url && (
            item.product_name ||
            item.name ||
            item.product_sku ||
            (item.image && item.image.alt)
        ));
    }

    function clearStalePrivateContentOnce() {
        try {
            if (window.localStorage.getItem(uiVersionKey) === uiVersion) {
                return;
            }

            window.localStorage.removeItem('mage-cache-storage');
            window.localStorage.removeItem('mage-cache-storage-section-invalidation');
            window.localStorage.removeItem('mage-cache-timeout');
            window.localStorage.setItem(uiVersionKey, uiVersion);
        } catch (error) {
            // Storage can be unavailable in private browsing; rendering should continue.
        }
    }

    function updateWishlistState() {
        var section = customerData.get('wishlist')() || {};
        var items = Array.isArray(section.items) ? section.items : [];
        var hasItems = items.filter(isValidItem).length > 0;

        sidebar.toggleClass('ttk-has-wishlist', hasItems);
        sidebar.toggleClass('ttk-is-empty', !hasItems);
    }

    clearStalePrivateContentOnce();
    updateWishlistState();
    customerData.get('wishlist').subscribe(updateWishlistState);
    customerData.reload(['wishlist'], true).done(updateWishlistState);
});
</script>
<?php endif ?>

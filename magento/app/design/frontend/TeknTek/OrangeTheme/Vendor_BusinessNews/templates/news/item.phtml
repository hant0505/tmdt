<?php
/**
 * item.phtml — Một card bài báo đơn lẻ
 *
 * Nhận data qua setData('news', $newsArray) từ list.phtml
 * Cấu trúc: ảnh + date badge overlay → meta (title, desc, link)
 *
 * @var \Magento\Framework\View\Element\Template $block
 */
$news = $block->getData('news');
$image = $news['image'] ?? 'https://via.placeholder.com/600x400?text=No+Image';
$title = $news['title'] ?? '';
$desc  = $news['description'] ?? '';
$date  = $news['date'] ?? date('d/m/Y');
$link  = $news['link'] ?? '#';
?>
<article class="bn-item">

    <!-- Ảnh + date badge nổi trên ảnh -->
    <div class="bn-item__thumb-wrap">
        <img
            src="<?= htmlspecialchars($image, ENT_QUOTES, 'UTF-8') ?>"
            alt="<?= htmlspecialchars($title, ENT_QUOTES, 'UTF-8') ?>"
            class="bn-item__thumb"
            loading="lazy"
            onerror="this.src='https://via.placeholder.com/600x400?text=No+Image'"
        />
        <span class="bn-item__date-badge"><?= htmlspecialchars($date, ENT_QUOTES, 'UTF-8') ?></span>
    </div>

    <!-- Nội dung -->
    <div class="bn-item__body">
        <h3 class="bn-item__title"><?= htmlspecialchars($title, ENT_QUOTES, 'UTF-8') ?></h3>
        <p class="bn-item__desc"><?= htmlspecialchars($desc, ENT_QUOTES, 'UTF-8') ?></p>

        <?php if (!empty($link) && $link !== '#'): ?>
            <a href="<?= htmlspecialchars($link, ENT_QUOTES, 'UTF-8') ?>"
               class="bn-item__readmore"
               target="_blank"
               rel="noopener noreferrer">
                <!-- Chevron icon -->
                <svg class="bn-icon-chevron" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                Đọc thêm về <?= htmlspecialchars(mb_strtolower($title, 'UTF-8'), ENT_QUOTES, 'UTF-8') ?>.
            </a>
        <?php endif; ?>
    </div>

</article>

<!-- ═══════════════════════════════════════════
     JS PHÂN TRANG (không dùng require.js để đơn giản)
════════════════════════════════════════════ -->
<script>
(function () {
    'use strict';

    var currentPage = 1;
    var totalPages  = <?= (int)$pages ?>;

    var grid       = document.getElementById('bn-grid');
    var prev       = document.getElementById('bn-prev');
    var next       = document.getElementById('bn-next');
    var pageNums   = document.querySelectorAll('.bn-page-num');

    if (!grid || totalPages <= 1) return;

    function showPage(page) {
        // Ẩn/hiện card
        var cards = grid.querySelectorAll('.bn-card');
        cards.forEach(function (card) {
            card.style.display = card.dataset.page == page ? '' : 'none';
        });

        // Update số trang active
        pageNums.forEach(function (btn) {
            var active = parseInt(btn.dataset.page) === page;
            btn.classList.toggle('bn-page-num--active', active);
            btn.setAttribute('aria-current', active ? 'page' : 'false');
        });

        // Nút prev / next
        if (prev) prev.disabled = page <= 1;
        if (next) next.disabled = page >= totalPages;

        currentPage = page;

        // Scroll nhẹ về đầu section
        var section = document.querySelector('.bn-section');
        if (section) {
            section.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
    }

    // Bind số trang
    pageNums.forEach(function (btn) {
        btn.addEventListener('click', function () {
            showPage(parseInt(this.dataset.page));
        });
    });

    // Bind prev / next
    if (prev) prev.addEventListener('click', function () { if (currentPage > 1) showPage(currentPage - 1); });
    if (next) next.addEventListener('click', function () { if (currentPage < totalPages) showPage(currentPage + 1); });

    // Khởi tạo trang 1
    showPage(1);
}());
</script>
